<div id="dataSetResultsSelector">
    <div class="dataSetContainer clearfix">
        <strong>
            Data Set        </strong>

        <div class="icons">
            
            <div style="float: left; font-size: 12px; margin-right: 4px; vertical-align: middle; height: 20px; line-height: 20px; color: rgb(71, 106, 167);">Click here to export your results &raquo;</div>

            <a id="metadataExportButton" role="link" title="Log In To Export Metadata" tabindex=0 class="disabled">
