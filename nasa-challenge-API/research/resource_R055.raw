                            <label for="featureWorldClass">Feature Class</label>
                            <select name="featureWorldClass" id="featureWorldClass">
                                <option value=''>All</option>
                                <option value='A'>Administrative Boundary Features</option><option value='H'>Hydrographic Features</option><option value='L'>Area Features</option><option value='P'>Populated Place Features</option><option value='R'>Road or Railroad Features</option><option value='S'>Spot Features</option><option value='T'>Hypsographic Features</option><option value='U'>Undersea Features</option><option value='V'>Vegetation Features</option>                            </select>

                            <label for="featureWorldType">Feature Type</label>
                            <select name="featureWorldType" id="featureWorldType">
                                <option value=''>All</option>
                            </select>
                        </span>
                    </span>

                </div>
                <div class="buttons">
                    <input id="geoShow" title="Show" type="button" class="button" value="Show" />
                    <input id="geoClear" title="Clear" type="button" class="button" value="Clear" />
                </div>
                <div class="geoRow" id="googleResults">
                    <p>
                        Click on an Address/Place to show the
                        location on the map and add coordinates
                        to the Area of Interest Control.
                    </p>
                    <table>
                        <thead>
                            <tr>
                                <th scope="col">Num</th>
                                <th scope="col">Address/Place</th>
                                <th scope="col">Latitude</th>
                                <th scope="col">Longitude</th>
                            </tr>
                        </thead>

                        <tbody id="googleRow">

                        </tbody>
                    </table>
                </div>

                <div class="geoRow" id="featureResults">
                    <p>
                        Click on a Feature to show the
                        location on the map and add coordinates
                        to the Area of Interest Control.
                    </p>
                    <table>
                        <thead>
                            <tr>
                                <th scope="col">Placename</th>
                                <th scope="col">Type</th>
                                <th scope="col">Region</th>
                                <th scope="col">Latitude</th>
                                <th scope="col">Longitude</th>
                            </tr>
                        </thead>

                        <tbody id="featureRow">

                        </tbody>
                    </table>
                </div>

                <div id="geoErrorMessage">

                </div>
            </div>
        </div>
        <div id="tabUploadForm" class="geoForm">
                            <div class="clearfix" style="background-color: #efefef;border: 1px solid #678ac7;font-size:14px;margin-bottom:10px;padding: 6px;text-align:left;vertical-align:middle;">
                    <div style="float:left;">
                        <div class="ee-icon ee-icon-info"></div>
                    </div>
                    <div style="float:left;">
                        &nbsp;&nbsp;You must be logged in to upload a file.
                    </div>
                </div>
                    </div>
    
        <div id="tabCalValSiteForm" class="geocodeForm">
            <div>
                <label for="calValSiteType">Type</label>
                <select id="calValSiteType" name="calValSiteType">
                    <option value="">Select One</option>
                                            <option value="1">AERONET</option>
                                            <option value="2">NEON Relocatable Terrestrial</option>
                                            <option value="3">NEON Core Terrestrial</option>
                                            <option value="4">USCRN</option>
                                            <option value="5">SURFRAD</option>
                                            <option value="6">EOS Land Validation Core Sites</option>
                                            <option value="7">CEOS Reference Sites</option>
                                            <option value="8">CEOS Super Sites</option>
                                    </select>
            </div>
            <div style="margin-top: 10px;">
                <label for="calValSiteList">Cal/Val Site</label>
                <select id="calValSiteList" name="calValSiteList"></select>
            </div>
            <div class="buttons">
                <input id="calvalSiteShow" title="Show Site" type="button" class="button" value="Show Site" />
                <input id="calvalSiteClear" title="Clear Site" type="button" class="button" value="Clear Site" />
            </div>
        </div>
    </div>

    
    <div id="areaTabs" class="control-tabs unselectable">
        <div id="tabPolygon" class="tab selected" tabindex=0>Polygon</div>
        <div id="tabCircle" class="tab " tabindex=0>Circle</div>
        <div id="tabPredefinedArea" class="tab " tabindex=0 title="Select the Shape map option to use Predefined Areas.">Predefined Area</div>

        <div style="clear:both;"></div>
    </div>
    <div class="control-container">
        <div id="tabPolygonForm" class="areaForm">
            <div id="lat_lon_section">
                <fieldset>
                    <legend style="display:None;">Coordinates Format</legend>
                    <label for="latlonfmtdeg">Degree/Minute/Second</label>
                                        <input id="latlonfmtdeg" type="radio" value="dms" name="latlonfmt" checked="checked" />
                    <label for="latlonfmtdec" style="margin-left:-5px;">Decimal</label>
                    <input id="latlonfmtdec" type="radio" value="dd" name="latlonfmt"/>
                </fieldset>
            </div>

            
<template id="coordEntryTemplate">
    <li id="coordinate_!%index%!" class="coordinate control-!%format%!">

        <div style="float:left;margin-right:8px;"> <span class="coordinateNum"></span>. </div>

        <div class="format_dms" style="float:left;">
            Lat: <span class="latitude"></span>,
            Lon: <span class="longitude"></span>
        </div>

        <div class="format_dd" style="float:left;">
            Lat: <span class="latitude"></span>,
            Lon: <span class="longitude"></span>
        </div>

        <div style="float:right;">
            <span class="coordinateElementOperations">
                <a id="edit_!%index%!" class="iconLink edit" tabindex=0 title="Edit this coordinate">
                    <span class="ee-icon ee-icon-notepad"></span>
                </a>
                <a id="delete_!%index%!" class="iconLink delete" tabindex=0 title="Delete this coordinate">
                    <span class="ee-icon ee-icon-delete"></span>
                </a>
            </span>
        </div>
        <div style="clear:both;"></div>
    </li>
</template>

<ul id="coordEntryArea" class="mapPointContainer ui-sortable">
