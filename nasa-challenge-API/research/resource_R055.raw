<script type="text/javascript">
    $(document).ready(function () {
        // Hide all Area Forms
        $('#tab1data').find('.areaForm').hide();

        // Load the correct Area Tab form
        var areaName = $('#areaTabs').children('.selected').attr('id');
        $('#' + areaName + 'Form').show();
    });

    
    
    $('#refreshFilterCache').click(function () {
        $.blockUI({
            theme:   true,
            title:   'Notice',
            message: '<p>Refreshing your data set criteria filters</p>',
            timeout: 0
        });

        $.ajax({
            dataType: 'json',
            method:   'POST',
            data:     {},
            url:      '/dataset/refresh'
        }).fail(function (jqXHR) {
            $.unblockUI();
            $('#filterRefreshNotice').html('<div class="alert alert-danger"><strong>' + jqXHR.status + ' Error</strong><br />Could not refresh filters. Please try again.</div>');
        }).done(function () {
            $.unblockUI();
            EE.tabs.additionalCriteria.load();
        });
    });
</script>
        <div id="right-col">
            <div id="searchCriteriaBox">
                <div id="searchCriteriaHeader" style='height: 17px;'>
                    <div style='float: left;'>Search Criteria Summary <span id="searchCriteriaStatus">(Show)</span></div>
                    <div id='clearAllCriteria' style='float: right; padding-right: 5px;'>Clear Search Criteria</div>
                    <div style='clear:both;'></div>
                </div>

                <div id="searchCriteria" class="criteriaSpan">
                    <h2>You are searching the following data sets:</h2>
                        <ul id="summaryDataSets">
                            <li>No data sets selected.</li>                        </ul>

                    <h2>Your area of interest:</h2>
                        <ul id="summaryAreaOfInterest">
                            <li>No coordinates selected.</li>                        </ul>

                    <h2>You are searching using the following criteria:</h2>
                        <ul>
                            <li><strong>Start Date:</strong> <span id="summaryStartDate">None</span></li>
                            <li><strong>End Date:</strong> <span id="summaryEndDate">None</span></li>
                            <li><strong>Months:</strong> <span id="summaryMonths">(all)</span></li>
                        </ul>
                </div>
            </div>

            <div id="mapWrapper">
                <div id="map"></div>
                <div id="mapOverlays">
                    <div id="mouseLatLng" class="mapControlElement">(coordinates)</div>

                    <div id="optionsControl" class="unselectable mapControlElement">
                        <div>Options</div>

                        <div class="mapControlDropDown">
                            <form name="optionsControlForm" action="">
                                <span class="autoCenter unselectable" title="Automatically center map when adding footprints or browse.">
                                    <input id="optionAutoCenter" title="Auto Center" type="checkbox" checked="checked"/>
                                    <label for="optionAutoCenter">Auto-Center</label>
                                </span>
                                <span class="overlayOrder unselectable" title="Automatically sets search polygon (AOI) on top of browse overlay.">
                                    <label for="aoiOverlaysOrder">AOI Overlay Location</label>
                                    <select name="aoiOverlaysOrder" id="aoiOverlaysOrder">
                                        <option value="AboveSceneOverlay" selected="selected">Above Scene Overlay</option>
                                        <option value="BelowSceneOverlay" >Below Scene Overlay</option>
                                    </select>
                                </span>

                                <fieldset>
                                    <legend style="display:None;">Select Coordinates format</legend>
                                    <span class="decimalFormatToggle unselectable" title="Identify coordinates in decimal degree format.">
                                        <input id="decimalFormatDegree" title="Decimal Degree" type="radio" name="decimalFormatToggle"  value="dd" />
                                        <label for="decimalFormatDegree">Decimal Degree Format</label>
                                    </span>
                                    <span class="decimalFormatToggle unselectable" title="Identify coordinates in degree/minute/second format.">
                                        <input id="decimalFormatDms" title="Degree/Minute/Second" type="radio" name="decimalFormatToggle" checked="checked" value="dms" />
                                        <label for="decimalFormatDms">Degree/Minute/Second Format</label>
                                    </span>
                                </fieldset>
                                
                                <fieldset>
                                    <legend style="display:None;">AOI Type</legend>
                                    <span class="polygonTool unselectable" title="Define your area of interest by drawing a polygon." >
                                        <input id="polygonTypePolygon" title="Polygon Type Polygon" type="radio" name="polygonType" checked="checked" value="polygon" />
                                        <label for="polygonTypePolygon">Polygon</label>
                                    </span>
                                    <span class="polygonTool unselectable" title="Define your area of interest by drawing a circle." >
                                        <input id="polygonTypeCircle" title="Polygon Type Circle" type="radio" name="polygonType"  value="circle" />
                                        <label for="polygonTypeCircle">Circle</label>
                                    </span>
                                    <span class="polygonTool unselectable" title="Define your area of interest by using a predefined area." >
                                        <input id="polygonTypeShape" title="Polygon Type Shape" type="radio" name="polygonType"  value="shape" />
                                        <label for="polygonTypeShape">Predefined Area</label>
                                    </span>
                                </fieldset>
                            </form>
                        </div>
                    </div>
                </div>
            </div>

            <div id="mapDisclaimer">
                Basemaps are for reference only and cannot be downloaded. Some non-USGS layers may not reflect current naming conventions. Use the left-side options to access available data.
            </div>
        </div>
    </div>
</div>


<script type="text/javascript">
    EE.maps.loadMap([{"isDefault":true,"mapTitle":"Vector Map","uri":"https:\/\/ims.cr.usgs.gov\/basemaps\/style-basemap-light-full.json","layerOptions":{"attribution":"&copy; <a href=\"https:\/\/www.openstreetmap.org\/copyright\">OpenStreetMap<\/a> contributors &mdash; tiles hosted by USGS","gridColor":"#000000"},"layerType":"maplibre-style","usesImagery":false,"labelMode":"vector"},{"isDefault":false,"mapTitle":"Dark Map","uri":"https:\/\/ims.cr.usgs.gov\/basemaps\/style-basemap-dark-full.json","layerOptions":{"attribution":"&copy; <a href=\"https:\/\/www.openstreetmap.org\/copyright\">OpenStreetMap<\/a> contributors &mdash; tiles hosted by USGS","gridColor":"#FFFFFF"},"layerType":"maplibre-style","usesImagery":false,"labelMode":"vector"},{"isDefault":false,"mapTitle":"Light Gray Map","uri":"https:\/\/ims.cr.usgs.gov\/basemaps\/style-basemap-gray-full.json","layerOptions":{"attribution":"&copy; <a href=\"https:\/\/www.openstreetmap.org\/copyright\">OpenStreetMap<\/a> contributors &mdash; tiles hosted by USGS","gridColor":"#000000"},"layerType":"maplibre-style","usesImagery":false,"labelMode":"vector"},{"isDefault":false,"mapTitle":"The National Map","uri":"https:\/\/basemap.nationalmap.gov\/arcgis\/rest\/services\/USGSTopo\/MapServer\/WMTS\/tile\/1.0.0\/USGSTopo\/default\/default028mm\/{z}\/{y}\/{x}\/","layerOptions":{"attribution":"&copy; <a href=\"https:\/\/apps.nationalmap.gov\/services\/\">TNM<\/a>","gridColor":"#000000"},"layerType":"tile","usesImagery":false},{"isDefault":false,"mapTitle":"ESRI World Imagery","uri":"https:\/\/server.arcgisonline.com\/ArcGIS\/rest\/services\/World_Imagery\/MapServer\/tile\/{z}\/{y}\/{x}","layerOptions":{"attribution":"Tiles &copy; <a href=\"https:\/\/www.arcgis.com\/home\/item.html?id=10df2279f9684e4a9f6a7f08febac2a9\">Esri<\/a> &mdash; Source: Esri, Vantor, Earthstar Geographics, and the GIS User Community","gridColor":"#FFFFFF"},"layerType":"tile","usesImagery":true,"labelMode":"overlay","labelOverlayUri":"https:\/\/ims.cr.usgs.gov\/basemaps\/style-basemap-imagery-reference.json"}]);
    document.getElementsByClassName("leaflet-control-layers-toggle")[0].setAttribute("aria-label","Leaflet Layers");
    if (EE.tabs.tabInfo.getCurrent() !== 1) {
        EE.maps.map.setMaxBounds(L.latLngBounds(new L.latLng(85, -360), new L.latLng(-85, 180)));
    } else {
        EE.maps.map.setMaxBounds(L.latLngBounds(new L.latLng(85, -180), new L.latLng(-85, 180)));
    }
    
    $('#aoiOverlaysOrder').change(function() {
        if ($('#aoiOverlaysOrder').val() === "BelowSceneOverlay" && (EE.maps.coordinateList.length > 2)) {
            EE.maps.map.getPane('aoiPane').style.zIndex = 401;
        } else {
            EE.maps.map.getPane('aoiPane').style.zIndex = 449;
        }
    });
</script>
