            <div id="dataSetPrefilterMessage"><strong id="dataSetPrefilterHiddenNum">0</strong>&nbsp;data sets out of <strong id="dataSetPrefilterTotal">0</strong>&nbsp;were hidden by the prefilter <strong id="dataSetPrefilterToggle" style="cursor:pointer; color:#0f1faa;">(Show)</strong>.</div>
        </div>
    </div>
    <div class="form">
        <div id="dataSetSearch" class='ui-widget' style="display: none;">
