</table></div></li><li class='xr-var-item'><div class='xr-var-name'><span class='xr-has-index'>y</span></div><div class='xr-var-dims'>(y)</div><div class='xr-var-dtype'>datetime64[ns]</div><div class='xr-var-preview xr-preview'>2000-01-01 ... 2000-01-05</div><input id='attrs-c6095376-f1c3-4201-8238-9dac67798a02' class='xr-var-attrs-in' type='checkbox' disabled><label for='attrs-c6095376-f1c3-4201-8238-9dac67798a02' title='Show/Hide attributes'><svg class='icon xr-icon-file-text2'><use xlink:href='#icon-file-text2'></use></svg></label><input id='data-32c1b6c5-32f3-40a7-85f0-f555547ca10c' class='xr-var-data-in' type='checkbox'><label for='data-32c1b6c5-32f3-40a7-85f0-f555547ca10c' title='Show/Hide data repr'><svg class='icon xr-icon-database'><use xlink:href='#icon-database'></use></svg></label><div class='xr-var-attrs'><dl class='xr-attrs'></dl></div><div class='xr-var-data'><pre>array([&#x27;2000-01-01T00:00:00.000000000&#x27;, &#x27;2000-01-02T00:00:00.000000000&#x27;,
       &#x27;2000-01-03T00:00:00.000000000&#x27;, &#x27;2000-01-04T00:00:00.000000000&#x27;,
       &#x27;2000-01-05T00:00:00.000000000&#x27;], dtype=&#x27;datetime64[ns]&#x27;)</pre></div></li></ul></div></li><li class='xr-section-item'><input id='section-73a8608b-ecc2-4913-a8fc-b629614c6cfa' class='xr-section-summary-in' type='checkbox' checked /><label for='section-73a8608b-ecc2-4913-a8fc-b629614c6cfa' class='xr-section-summary' title='Expand/collapse section'>Data variables: <span>(1)</span></label><div class='xr-section-inline-details'></div><div class='xr-section-details'><ul class='xr-var-list'><li class='xr-var-item'><div class='xr-var-name'><span>foo</span></div><div class='xr-var-dims'>(x, y)</div><div class='xr-var-dtype'>float64</div><div class='xr-var-preview xr-preview'>dask.array&lt;chunksize=(4, 5), meta=np.ndarray&gt;</div><input id='attrs-6cf6c2fd-4c12-4e38-b063-34a0ce53b994' class='xr-var-attrs-in' type='checkbox' disabled><label for='attrs-6cf6c2fd-4c12-4e38-b063-34a0ce53b994' title='Show/Hide attributes'><svg class='icon xr-icon-file-text2'><use xlink:href='#icon-file-text2'></use></svg></label><input id='data-c43ad6ac-8926-4cdf-baae-ecc517dbf5e8' class='xr-var-data-in' type='checkbox'><label for='data-c43ad6ac-8926-4cdf-baae-ecc517dbf5e8' title='Show/Hide data repr'><svg class='icon xr-icon-database'><use xlink:href='#icon-database'></use></svg></label><div class='xr-var-attrs'><dl class='xr-attrs'></dl></div><div class='xr-var-data'><table>
