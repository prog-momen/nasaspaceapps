<script>
	
	var va = "/eng/multimedia/search/analytics";
</script>
<script src="/js/institution/recherche-video/analytics.js"></script>
<script>
	$(document).ready(function(){
		var theme = getParameterByName('theme');
		if(theme !== null){
			$("a[href^='/']").each(function(){
				if($(this).attr("href").indexOf("theme=") == -1){
					if($(this).attr("href").indexOf("?") == -1){
						$(this).attr("href", $(this).attr("href") + "?");
					} else{
						$(this).attr("href", $(this).attr("href") + "&");
					}
					$(this).attr("href", $(this).attr("href") + "theme=" + theme);
				}
					
			})
		}
		
		
	});
	
	function getParameterByName(name, url) {
		if (!url) url = window.location.href;
		name = name.replace(/[\[\]]/g, "\\$&");
		var regex = new RegExp("[?&]" + name + "(=([^&#]*)|&|#|$)"),
			results = regex.exec(url);
		if (!results) return null;
		if (!results[2]) return '';
		return decodeURIComponent(results[2].replace(/\+/g, " "));
	}
</script>
	
