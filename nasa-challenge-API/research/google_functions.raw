            title: { type: &quot;string&quot;, description: &quot;Title of the chart&quot; },
          },
          required: [&quot;chart_type&quot;, &quot;data&quot;, &quot;title&quot;],
        },
      },
    ],
  });
  
  for (const step of interaction.steps) {
    if (step.type === &#39;function_call&#39;) {
      console.log(`${step.name}(${JSON.stringify(step.arguments)})`);
