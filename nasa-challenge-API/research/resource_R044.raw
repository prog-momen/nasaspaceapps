<div class="_none block block-layout-builder block-field-blocknodepagefield-summary">
  
    
      <div class="content">
      
            <div class="field field--name-field-summary field--type-string-long field--label-hidden field__item">An orbit is the curved path a satellite follows around the Earth due to gravitational force. </div>
      
    </div>
