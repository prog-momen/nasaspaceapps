<div class="_none block block-earthdata-blocks block-earthdata-blocks-card-grid">
  
      <h2>Synthetic Aperture Radar</h2>
    
      <div class="content">
      

  <div class="earthdata-blocks-card-grid-wrapper">
    

<div  data-component-id="wst_component_library:featured-cards" class="featured-cards-component">

  <div class="wst-featured-cards__header">
    <div class="wst-featured-cards__header-content">
                    <p class="wst-featured-cards__summary">Synthetic aperture radar (SAR) is a type of remote sensing that produces fine-resolution data using a technology that, over time, can detect even minute changes on Earth’s surface.</p>
          </div>
      </div>

    <div class="wst-featured-cards__grid grid-cols-4">
                                    

