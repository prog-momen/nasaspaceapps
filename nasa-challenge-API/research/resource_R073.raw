                        <!-- 
                        Select Location (select one or more) <div id="Locationhelp" style="float:right" ><img onclick="toggleHelp('Location_help');" height="20px" width="20px" src="/static/images/help-icon.png"></div>
                        -->
                        Select Location <div id="Locationhelp" style="float:; display:inline;cursor:pointer;margin:3px;font-size:11px" >(one or more) &nbsp;<img onclick="toggleHelp('Location_help');" " src="/static/images/icon_help_bubble.gif" alt="Online Help"></div>
