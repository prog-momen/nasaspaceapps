import("https://cdn-client.medium.com/lite/assets/entry-aTAvRf3rjs.js");</script><!--$--><script>window.__reactRouterContext.streamController.enqueue("[{\"_1\":2,\"_3\":-5,\"_4\":-5},\"loaderData\",{\"_5\":6},\"actionData\",\"errors\",\"routes/pages/entity-routes/ShowEntityPost\",{}]\n");</script><!--$--><script>window.__reactRouterContext.streamController.close();</script><!--/$--><!--/$--><script>window.__APOLLO_STATE__ = {"ROOT_QUERY":{"__typename":"Query","viewer":null,"postResult({\"id\":\"b361a0ec530b\"})":{"__ref":"Post:b361a0ec530b"}},"LinkedAccounts:ebd8c9c184e3":{"__typename":"LinkedAccounts","mastodon":null,"id":"ebd8c9c184e3"},"NewsletterV3:4b06ccfe9b48":{"__typename":"NewsletterV3","id":"4b06ccfe9b48","type":"NEWSLETTER_TYPE_AUTHOR","slug":"ebd8c9c184e3","name":"ebd8c9c184e3","collection":null,"user":{"__ref":"User:ebd8c9c184e3"}},"User:ebd8c9c184e3":{"__typename":"User","id":"ebd8c9c184e3","name":"MCMC Addict","username":"snp.kriss","newsletterV3":{"__ref":"NewsletterV3:4b06ccfe9b48"},"linkedAccounts":{"__ref":"LinkedAccounts:ebd8c9c184e3"},"isSuspended":false,"customDomainState":null,"hasSubdomain":false,"imageId":"1*qIntreAMHAquInM-rg6uLw@2x.jpeg","bio":"PhD in Physics, Metrologist working at National Metrology Institute of Korea(KRISS) https:\u002F\u002Fwww.researchgate.net\u002Fprofile\u002FSeung-Nam-Park","membership":{"__ref":"Membership:81e86aac-9403-4bd3-8210-850b964a60fc"},"socialStats":{"__typename":"SocialStats","followerCount":90,"followingCount":106,"collectionFollowingCount":7},"verifications":{"__typename":"VerifiedInfo","isBookAuthor":false},"allowNotes":true,"viewerEdge":{"__ref":"UserViewerEdge:userId:ebd8c9c184e3-viewerId:lo_3166878fc933"},"twitterScreenName":""},"Membership:81e86aac-9403-4bd3-8210-850b964a60fc":{"__typename":"Membership","tier":"MEMBER","id":"81e86aac-9403-4bd3-8210-850b964a60fc"},"Paragraph:d7051af5a0aa_0":{"__typename":"Paragraph","id":"d7051af5a0aa_0","name":"d4e8","type":"H3","href":null,"layout":null,"metadata":null,"text":"Statistical test methods to detect trends in time series data","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:d7051af5a0aa_1":{"__typename":"Paragraph","id":"d7051af5a0aa_1","name":"749e","type":"H4","href":null,"layout":null,"metadata":null,"text":"A comprehensive approach using toy datasets for global warming and methane concentration Increase","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:d7051af5a0aa_2":{"__typename":"Paragraph","id":"d7051af5a0aa_2","name":"c084","type":"IMG","href":null,"layout":"INSET_CENTER","metadata":{"__typename":"ImageMetadata","id":"0*L_PspOqCY1CNxU5w","darkId":null,"originalHeight":3292,"originalWidth":5267,"focusPercentX":null,"focusPercentY":null,"alt":null},"text":"Photo by Marek Piwnicki on Unsplash","hasDropCap":null,"dropCapImage":null,"markups":[{"__typename":"Markup","type":"A","start":9,"end":23,"href":"https:\u002F\u002Funsplash.com\u002F@marekpiwnicki?utm_source=medium&utm_medium=referral","anchorType":"LINK","userId":null,"linkMetadata":null},{"__typename":"Markup","type":"A","start":27,"end":35,"href":"https:\u002F\u002Funsplash.com?utm_source=medium&utm_medium=referral","anchorType":"LINK","userId":null,"linkMetadata":null}],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:d7051af5a0aa_3":{"__typename":"Paragraph","id":"d7051af5a0aa_3","name":"e50c","type":"H3","href":null,"layout":null,"metadata":null,"text":"Introduction","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:d7051af5a0aa_4":{"__typename":"Paragraph","id":"d7051af5a0aa_4","name":"542a","type":"P","href":null,"layout":null,"metadata":null,"text":"Detecting and analysing trends in time series data is a crucial aspect of environmental science, particularly regarding global warming and its associated impacts. One significant consequence of rising global temperatures is increased atmospheric methane concentrations, a potent greenhouse gas. While carbon dioxide (CO₂) is the primary driver of global warming due to its higher concentration and longer atmospheric lifetime, methane (CH₄) plays a critical role that cannot be overlooked.","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:d7051af5a0aa_5":{"__typename":"Paragraph","id":"d7051af5a0aa_5","name":"5622","type":"P","href":null,"layout":null,"metadata":null,"text":"Methane is over 25 times more effective than CO₂ at trapping atmospheric heat over 100 years. Despite its lower concentration than CO₂, its high global warming potential makes it a key target for climate change mitigation efforts. Additionally, methane has a relatively short atmospheric lifetime of about 12 years, meaning reducing methane emissions can have a quicker impact on climate change mitigation than CO₂.","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:d7051af5a0aa_6":{"__typename":"Paragraph","id":"d7051af5a0aa_6","name":"7345","type":"P","href":null,"layout":null,"metadata":null,"text":"Understanding trends in methane concentrations is essential for developing effective strategies to cure global warming. These trends can provide insights into the effectiveness of emission control policies, the contribution of different methane sources, and the potential feedback loops in the climate system. Given its significant impact and the need for timely action, it is imperative to detect and analyse methane concentration trends accurately.","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:d7051af5a0aa_7":{"__typename":"Paragraph","id":"d7051af5a0aa_7","name":"90dc","type":"P","href":null,"layout":null,"metadata":null,"text":"In this article, we will explore various statistical tests to detect trends in time series data, using the example of global methane concentration increases due to global warming. We will start with the straightforward linear regression approach and move on to more sophisticated methods, including the Mann-Kendall, seasonal Mann-Kendall and unit root tests. Each technique will be illustrated with Python code examples, providing a practical framework for analysing similar environmental datasets. Since these tests allow us to statistically test the existence of a trend in time series data, I will intentionally reduce the trend slope of toy datasets until we can reject the null hypothesis of no trend in global methane concentration.","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:d7051af5a0aa_8":{"__typename":"Paragraph","id":"d7051af5a0aa_8","name":"05a6","type":"P","href":null,"layout":null,"metadata":null,"text":"Understanding and identifying trends in methane concentrations is vital for developing mitigation strategies and informing policy decisions. By applying these robust statistical methods, researchers can gain deeper insights into the temporal dynamics of methane levels and their broader implications for climate change.","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:d7051af5a0aa_9":{"__typename":"Paragraph","id":"d7051af5a0aa_9","name":"4227","type":"H4","href":null,"layout":null,"metadata":null,"text":"Generating toy datasets","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:d7051af5a0aa_10":{"__typename":"Paragraph","id":"d7051af5a0aa_10","name":"5828","type":"P","href":null,"layout":null,"metadata":null,"text":"Even if we can find the time series data of the global methane concentration on the NOAA website, it is meaningful to generate the dataset to remind us of its current level and seasonal variation. First, we assume the level and slope to be 1800 ppb as of 2000 and 7 ppb\u002Fyear, respectively. Its concentrations exhibit seasonal variations, typically with higher values in late summer and lower in late winter. The seasonal cycle can vary depending on the geographic region and specific atmospheric conditions, but a common approach is to model the seasonal variation using a sinusoidal function. To generate a toy dataset, we can assume an approximate seasonal variation of about ±10 ppb with a standard deviation of ±5 ppb superimposed as noise.","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:d7051af5a0aa_11":{"__typename":"Paragraph","id":"d7051af5a0aa_11","name":"f669","type":"P","href":null,"layout":null,"metadata":null,"text":"I generated several datasets using the code below. Each list element of 'slopes' characterises the ‘dataset [i]'. The 'slopes [i][0]' and 'slopes [i][1]' denote the methane's slope (ppb\u002Fyear) and the existence of the seasonal variation, respectively.","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:d7051af5a0aa_12":{"__typename":"Paragraph","id":"d7051af5a0aa_12","name":"4590","type":"PRE","href":null,"layout":null,"metadata":null,"text":"import numpy as np\nimport pandas as pd\nimport matplotlib.pyplot as plt\nfrom collections import namedtuple\n\nnp.random.seed(1)\n# Parameters for the toy dataset\nstart_year = 2000\nend_year = 2020\nyears = np.arange(start_year, end_year + 1)\nmonths = np.arange(1, 13)\nintercept = 1800  # Starting methane concentration in ppb\nseasonal_amplitude = 10  # Amplitude of seasonal variation in ppb\nnoise_std_dev = 5  # Standard deviation of the noise\n\n# Generate yearly and monthly time points\ntime_years = np.repeat(years, 12)\ntime_months = np.tile(months, len(years))\ntime = time_years+(time_months-1)\u002F12\n\n# slopes = [[slope, existence of seasonal variation],...]\nslopes = [[0.1,1], [0.2,1], [0.3,1], [7,1], [0.1,0]] \nmethane = namedtuple('methane', ['years', 'concentration', 'slope'])\ndataset =[]\nnoise= np.random.normal(0, noise_std_dev, len(time_years))\nseasonal_variation = seasonal_amplitude * np.sin(2 * np.pi * (time_months - 1) \u002F 12)\n\nfor slope in slopes:\n    # Generate methane concentrations with a linear trend, seasonal variation, and random noise\n    methane_concentration= np.round(intercept + slope[0] * (time_years - start_year) + noise \\\n                           + seasonal_variation * slope[1],1)    \n    comment = f'{slope[0]} ppb\u002Fyear' if slope[1] else f'{slope[0]} ppb\u002Fyear without seasonal variation'    \n    dataset.append(methane(time, methane_concentration, comment))","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":{"__typename":"CodeBlockMetadata","mode":"AUTO","lang":"python"},"iframe":null,"mixtapeMetadata":null},"Paragraph:d7051af5a0aa_13":{"__typename":"Paragraph","id":"d7051af5a0aa_13","name":"3519","type":"IMG","href":null,"layout":"INSET_CENTER","metadata":{"__typename":"ImageMetadata","id":"1*6yQn960VKDdYhSpmJ-jO8Q.png","darkId":null,"originalHeight":814,"originalWidth":1288,"focusPercentX":null,"focusPercentY":null,"alt":null},"text":"A toy Dataset[3] is generated considering the 7 ppb\u002Fyear slope and seasonal variation of ±10 ppb with a standard deviation of ±5 ppb superimposed as noise.","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:d7051af5a0aa_14":{"__typename":"Paragraph","id":"d7051af5a0aa_14","name":"7ac8","type":"H4","href":null,"layout":null,"metadata":null,"text":"Ordinary Least Square Regression","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:d7051af5a0aa_15":{"__typename":"Paragraph","id":"d7051af5a0aa_15","name":"9ca0","type":"P","href":null,"layout":null,"metadata":null,"text":"Applying a linear regression aligns with standard practices for analysing time series data to determine if there is a significant trend. The null hypothesis is that the slope is zero, which implies no significant trend, while the alternative hypothesis is not zero, which implies a significant trend. Then, conduct a t-test on the slope coefficient from your linear regression. The t-test will help you determine if the slope differs significantly from zero. If the p-value from the t-test is less than our chosen significance level (e.g. 0.05), we reject the null hypothesis and conclude that there is a significant trend in our time series data. If the p-value is greater than the significance level, we fail to reject the null hypothesis, indicating that there is no significant trend.","hasDropCap":null,"dropCapImage":null,"markups":[{"__typename":"Markup","type":"EM","start":382,"end":383,"href":null,"anchorType":null,"userId":null,"linkMetadata":null},{"__typename":"Markup","type":"EM","start":483,"end":484,"href":null,"anchorType":null,"userId":null,"linkMetadata":null}],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:d7051af5a0aa_16":{"__typename":"Paragraph","id":"d7051af5a0aa_16","name":"6e61","type":"P","href":null,"layout":null,"metadata":null,"text":"I use OLS in ‘statmodels’ in the following code. Because the methane trend is evident, I reduced the slope from 7 ppb\u002Fyear to 0.2 and 0.3 ppb\u002Fyear to generate the 'dataset[1]' and 'dataset[2]'. The latter case of 0.3 ppb\u002Fyear exhibits a significant trend, but the former case of 0.2 ppb\u002Fyear shows signically no trend. These two limits act as a window to the significance of the trend. If we want to maintain an insignificant trend in the methane increase, we should reduce the slope to 1\u002F35 of the current slope with the noise assumed.","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:d7051af5a0aa_17":{"__typename":"Paragraph","id":"d7051af5a0aa_17","name":"1ae5","type":"PRE","href":null,"layout":null,"metadata":null,"text":"import statsmodels.api as sm\n\ndef ols_model(data, plot=True):\n    # Fit a linear regression model\n    X = sm.add_constant(data.years)\n    model = sm.OLS(data.concentration, X).fit()\n    \n    if plot:\n        plt.scatter(data.years,data.concentration, label='Data')\n        plt.plot(data.years, model.fittedvalues, color='red', label='Fitted Line')\n        plt.xlabel('Year')\n        plt.ylabel('Methane Concentration')\n        plt.legend()\n        plt.show()\n\n    # Run regression model\n    model.summary()\n\n    print(f\"Yearly data generation slope:{data.slope}\")\n    print(f\"fitted slope: {model.params[1]}\")\n    print(f\"t-statistic: {model.tvalues[1]}\")\n    print(f\"p-value: {model.pvalues[1]}\")\n    if model.pvalues[1] \u003C 0.05:\n        print(\"Reject the null hypothesis: There is a significant trend.\\n\")\n    else:\n        print(\"Fail to reject the null hypothesis: No significant trend.\\n\")\n        \nols_model(dataset[1], plot=True)\nols_model(dataset[2], plot=False)","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":{"__typename":"CodeBlockMetadata","mode":"AUTO","lang":"python"},"iframe":null,"mixtapeMetadata":null},"Paragraph:d7051af5a0aa_18":{"__typename":"Paragraph","id":"d7051af5a0aa_18","name":"5724","type":"IMG","href":null,"layout":"INSET_CENTER","metadata":{"__typename":"ImageMetadata","id":"1*2OEUAb-S5giKVPnO0wRElA.png","darkId":null,"originalHeight":946,"originalWidth":886,"focusPercentX":null,"focusPercentY":null,"alt":null},"text":"","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:d7051af5a0aa_19":{"__typename":"Paragraph","id":"d7051af5a0aa_19","name":"9d90","type":"H4","href":null,"layout":null,"metadata":null,"text":"Mann-Kendall Trend Test","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:d7051af5a0aa_20":{"__typename":"Paragraph","id":"d7051af5a0aa_20","name":"7032","type":"P","href":null,"layout":null,"metadata":null,"text":"This test is a non-parametric statistical method for identifying trends in a time series dataset. It is widely used in environmental science and climatology to detect trends without assuming a specific distribution for the data. Its test steps run as follows:","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:d7051af5a0aa_21":{"__typename":"Paragraph","id":"d7051af5a0aa_21","name":"599c","type":"OLI","href":null,"layout":null,"metadata":null,"text":"Rank the Data: The data points are ranked based on their time order. Each data point is compared to all subsequent data points to determine whether it is more significant, smaller, or equal.","hasDropCap":null,"dropCapImage":null,"markups":[{"__typename":"Markup","type":"STRONG","start":0,"end":13,"href":null,"anchorType":null,"userId":null,"linkMetadata":null}],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:d7051af5a0aa_22":{"__typename":"Paragraph","id":"d7051af5a0aa_22","name":"61fe","type":"OLI","href":null,"layout":null,"metadata":null,"text":"Calculate the Mann-Kendall Statistic (S)","hasDropCap":null,"dropCapImage":null,"markups":[{"__typename":"Markup","type":"STRONG","start":0,"end":40,"href":null,"anchorType":null,"userId":null,"linkMetadata":null},{"__typename":"Markup","type":"EM","start":38,"end":39,"href":null,"anchorType":null,"userId":null,"linkMetadata":null}],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:d7051af5a0aa_23":{"__typename":"Paragraph","id":"d7051af5a0aa_23","name":"a6e1","type":"ULI","href":null,"layout":null,"metadata":null,"text":"A comparison is made for each pair of data points. Suppose a data point later in the series is more prominent than an earlier one; a positive value is assigned. If it is smaller, a negative value is assigned. If the two points are equal, a value of zero is assigned.","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:d7051af5a0aa_24":{"__typename":"Paragraph","id":"d7051af5a0aa_24","name":"f32a","type":"ULI","href":null,"layout":null,"metadata":null,"text":"The Mann-Kendall statistic S is the sum of all these values:","hasDropCap":null,"dropCapImage":null,"markups":[{"__typename":"Markup","type":"EM","start":27,"end":29,"href":null,"anchorType":null,"userId":null,"linkMetadata":null}],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:d7051af5a0aa_25":{"__typename":"Paragraph","id":"d7051af5a0aa_25","name":"a0b8","type":"IMG","href":null,"layout":"INSET_CENTER","metadata":{"__typename":"ImageMetadata","id":"1*fe6GV3wgeBbUs1v9SH6WEQ.png","darkId":null,"originalHeight":136,"originalWidth":1216,"focusPercentX":null,"focusPercentY":null,"alt":null},"text":"","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:d7051af5a0aa_26":{"__typename":"Paragraph","id":"d7051af5a0aa_26","name":"2af5","type":"P","href":null,"layout":null,"metadata":null,"text":"where the function sign(arg) is +1 if arg \u003E 0, 0 if arg = 0, and -1 if arg \u003C 0. Therefore, a positive S, negative S, and zero indicate an increasing trend, a decreasing trend, and no trend in the data. The magnitude of S indicates the trend's strength, while its sign indicates the direction of the trend.","hasDropCap":null,"dropCapImage":null,"markups":[{"__typename":"Markup","type":"STRONG","start":19,"end":23,"href":null,"anchorType":null,"userId":null,"linkMetadata":null},{"__typename":"Markup","type":"STRONG","start":102,"end":103,"href":null,"anchorType":null,"userId":null,"linkMetadata":null},{"__typename":"Markup","type":"STRONG","start":114,"end":115,"href":null,"anchorType":null,"userId":null,"linkMetadata":null},{"__typename":"Markup","type":"EM","start":24,"end":27,"href":null,"anchorType":null,"userId":null,"linkMetadata":null},{"__typename":"Markup","type":"EM","start":38,"end":41,"href":null,"anchorType":null,"userId":null,"linkMetadata":null},{"__typename":"Markup","type":"EM","start":52,"end":56,"href":null,"anchorType":null,"userId":null,"linkMetadata":null},{"__typename":"Markup","type":"EM","start":71,"end":75,"href":null,"anchorType":null,"userId":null,"linkMetadata":null},{"__typename":"Markup","type":"EM","start":102,"end":103,"href":null,"anchorType":null,"userId":null,"linkMetadata":null},{"__typename":"Markup","type":"EM","start":114,"end":115,"href":null,"anchorType":null,"userId":null,"linkMetadata":null}],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:d7051af5a0aa_27":{"__typename":"Paragraph","id":"d7051af5a0aa_27","name":"5ae5","type":"P","href":null,"layout":null,"metadata":null,"text":"3. Variance of S:","hasDropCap":null,"dropCapImage":null,"markups":[{"__typename":"Markup","type":"STRONG","start":0,"end":16,"href":null,"anchorType":null,"userId":null,"linkMetadata":null},{"__typename":"Markup","type":"EM","start":15,"end":17,"href":null,"anchorType":null,"userId":null,"linkMetadata":null}],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:d7051af5a0aa_28":{"__typename":"Paragraph","id":"d7051af5a0aa_28","name":"48e8","type":"P","href":null,"layout":null,"metadata":null,"text":"The observed value of S is compared to its expected value under the null hypothesis of no trend to determine whether it is statistically significant. Under the null hypothesis, the expected value of S is zero. Therefore, the variance of S is used to standardise S into a test statistic (Z).","hasDropCap":null,"dropCapImage":null,"markups":[{"__typename":"Markup","type":"STRONG","start":199,"end":200,"href":null,"anchorType":null,"userId":null,"linkMetadata":null},{"__typename":"Markup","type":"STRONG","start":237,"end":238,"href":null,"anchorType":null,"userId":null,"linkMetadata":null},{"__typename":"Markup","type":"STRONG","start":262,"end":263,"href":null,"anchorType":null,"userId":null,"linkMetadata":null},{"__typename":"Markup","type":"EM","start":21,"end":23,"href":null,"anchorType":null,"userId":null,"linkMetadata":null},{"__typename":"Markup","type":"EM","start":199,"end":200,"href":null,"anchorType":null,"userId":null,"linkMetadata":null},{"__typename":"Markup","type":"EM","start":237,"end":238,"href":null,"anchorType":null,"userId":null,"linkMetadata":null},{"__typename":"Markup","type":"EM","start":262,"end":263,"href":null,"anchorType":null,"userId":null,"linkMetadata":null}],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:d7051af5a0aa_29":{"__typename":"Paragraph","id":"d7051af5a0aa_29","name":"bb76","type":"ULI","href":null,"layout":null,"metadata":null,"text":"The variance of S is calculated to account for the test dataset of multiple data points. It is denoted as Var(S) and depends on the dataset of tied groups (if any). For data with no ties, the variance is given by:","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:d7051af5a0aa_30":{"__typename":"Paragraph","id":"d7051af5a0aa_30","name":"dfe0","type":"IMG","href":null,"layout":"INSET_CENTER","metadata":{"__typename":"ImageMetadata","id":"1*h68V_wu3gTDPHDLt7bIg5w.png","darkId":null,"originalHeight":110,"originalWidth":1184,"focusPercentX":null,"focusPercentY":null,"alt":null},"text":"","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:d7051af5a0aa_31":{"__typename":"Paragraph","id":"d7051af5a0aa_31","name":"0426","type":"P","href":null,"layout":null,"metadata":null,"text":"where n is the total number of data points in the dataset.","hasDropCap":null,"dropCapImage":null,"markups":[{"__typename":"Markup","type":"EM","start":6,"end":7,"href":null,"anchorType":null,"userId":null,"linkMetadata":null}],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:d7051af5a0aa_32":{"__typename":"Paragraph","id":"d7051af5a0aa_32","name":"7384","type":"ULI","href":null,"layout":null,"metadata":null,"text":"When there are ties (i.e., identical values in the dataset), the variance is adjusted to account for relationships. If t is the number of tied groups and t_k​ is the number of data points in the k-th tied group,","hasDropCap":null,"dropCapImage":null,"markups":[{"__typename":"Markup","type":"EM","start":118,"end":120,"href":null,"anchorType":null,"userId":null,"linkMetadata":null},{"__typename":"Markup","type":"EM","start":195,"end":196,"href":null,"anchorType":null,"userId":null,"linkMetadata":null}],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:d7051af5a0aa_33":{"__typename":"Paragraph","id":"d7051af5a0aa_33","name":"91c8","type":"IMG","href":null,"layout":"INSET_CENTER","metadata":{"__typename":"ImageMetadata","id":"1*Cb2e6P3ZhZ2qa_txnic6Dw.png","darkId":null,"originalHeight":88,"originalWidth":904,"focusPercentX":null,"focusPercentY":null,"alt":null},"text":"","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:d7051af5a0aa_34":{"__typename":"Paragraph","id":"d7051af5a0aa_34","name":"e68b","type":"P","href":null,"layout":null,"metadata":null,"text":"where g is the number of tied groups.","hasDropCap":null,"dropCapImage":null,"markups":[{"__typename":"Markup","type":"EM","start":6,"end":7,"href":null,"anchorType":null,"userId":null,"linkMetadata":null}],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:d7051af5a0aa_35":{"__typename":"Paragraph","id":"d7051af5a0aa_35","name":"fa8a","type":"P","href":null,"layout":null,"metadata":null,"text":"4. Test Statistic (Z)","hasDropCap":null,"dropCapImage":null,"markups":[{"__typename":"Markup","type":"STRONG","start":0,"end":21,"href":null,"anchorType":null,"userId":null,"linkMetadata":null}],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:d7051af5a0aa_36":{"__typename":"Paragraph","id":"d7051af5a0aa_36","name":"7b00","type":"P","href":null,"layout":null,"metadata":null,"text":"To determine the significance of the trend, the test statistic Z is calculated:","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:d7051af5a0aa_37":{"__typename":"Paragraph","id":"d7051af5a0aa_37","name":"a6d2","type":"IMG","href":null,"layout":"INSET_CENTER","metadata":{"__typename":"ImageMetadata","id":"1*Q5FN6UJNEsAcDH8mmrv5RQ.png","darkId":null,"originalHeight":194,"originalWidth":820,"focusPercentX":null,"focusPercentY":null,"alt":null},"text":"","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:d7051af5a0aa_38":{"__typename":"Paragraph","id":"d7051af5a0aa_38","name":"043e","type":"P","href":null,"layout":null,"metadata":null,"text":"The value of Z is then compared to the critical values of the standard normal distribution to determine the trend's significance. Typically, a significance level is chosen. If the absolute value of Z is greater than the critical value (e.g., 1.96 for α=0.05), the null hypothesis of no trend is rejected, indicating a significant trend. We can draw the critical value 1.96 assuming the normality of the Z value, which can be justified by the central limit theorem and a simulation using a random generator of normal distribution. The code below shows the distribution of the Z values to follow the standard normal distribution: The histogram results in an excellent fit to the normal distribution with a location of -0.010 and a scale of 0.991.","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:d7051af5a0aa_39":{"__typename":"Paragraph","id":"d7051af5a0aa_39","name":"9b77","type":"PRE","href":null,"layout":null,"metadata":null,"text":"from scipy.stats import norm\nnp.random.seed(1)    # for reproducibility\n\n# Function to perform the Mann-Kendall test and return S\ndef mann_kendall_test(data):\n    n = len(data)\n    S = 0\n    for i in range(n - 1):\n        for j in range(i + 1, n):\n            S += np.sign(data[j] - data[i])\n    return S\n\n# Simulate multiple samples and calculate S\nsample_size = 100  # Large sample size\nnum_simulations = 10000\nS_values = []\n\nfor _ in range(num_simulations):\n    data = np.random.normal(size=sample_size)\n    S = mann_kendall_test(data)\n    S_values.append(S)\n\n# Standardize S to calculate Z\nmean_S = 0\nvar_S = (sample_size * (sample_size - 1) * (2 * sample_size + 5)) \u002F 18\nZ_values = [(S - mean_S) \u002F np.sqrt(var_S) for S in S_values]\n\n# Plot the standard normal distribution for comparison\nxmin, xmax = plt.xlim()\nx = np.linspace(xmin, xmax, 100)\np = norm.pdf(x, 0, 1)\nplt.plot(x, p, 'k', linewidth=2)\ntitle = \"Histogram of Z values with Standard Normal Distribution\"\nplt.title(title)\n\n# Fit the Z values to Normal distribution\nloc, scale = norm.fit(Z_values)\nprint(f'Normal distribution with loc={loc:4.3f}, scale={scale:4.3f}')","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":{"__typename":"CodeBlockMetadata","mode":"AUTO","lang":"python"},"iframe":null,"mixtapeMetadata":null},"Paragraph:d7051af5a0aa_40":{"__typename":"Paragraph","id":"d7051af5a0aa_40","name":"f741","type":"IMG","href":null,"layout":"INSET_CENTER","metadata":{"__typename":"ImageMetadata","id":"1*AXsqPybqGc9vMFH6PvJ0SQ.png","darkId":null,"originalHeight":700,"originalWidth":962,"focusPercentX":null,"focusPercentY":null,"alt":null},"text":"","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:d7051af5a0aa_41":{"__typename":"Paragraph","id":"d7051af5a0aa_41","name":"a303","type":"P","href":null,"layout":null,"metadata":null,"text":"5. Application of Python library","hasDropCap":null,"dropCapImage":null,"markups":[{"__typename":"Markup","type":"STRONG","start":3,"end":32,"href":null,"anchorType":null,"userId":null,"linkMetadata":null}],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:d7051af5a0aa_42":{"__typename":"Paragraph","id":"d7051af5a0aa_42","name":"a043","type":"P","href":null,"layout":null,"metadata":null,"text":"A Python library, 'pymankendall', has been implemented to apply this test. Please look at the demo code below and its results with the datasets [1] and [2]. The method gives the same test results as the linear regression method before. However, if we do not consider the seasonal variation as in the dataset[4], we can see the trend still increasing with a slope of 0.1 ppb\u002Fyear. I expect the seasonal variation to make trend detections insensitive.","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:d7051af5a0aa_43":{"__typename":"Paragraph","id":"d7051af5a0aa_43","name":"1d5d","type":"PRE","href":null,"layout":null,"metadata":null,"text":"from pymannkendall import original_test as mk_test\n\ndef mannkendall_test(data):\n    '''perform the Mann-Kendall test'''\n    result = mk_test(data.concentration)\n\n    print(f\"Yearly data generation slope:{data.slope}\")\n    print(f\"Trend: {result.trend}\")\n    if result.h:\n        print('Hypothesis: Reject null hypothesis of no trend')\n    else:\n        print('Hypothesis: Fail to reject null hypothesis of no trend')\n    print(f\"p-value: {result.p}\\n\")\n    \nmannkendall_test(dataset[1])\nmannkendall_test(dataset[2])\nmannkendall_test(dataset[4])","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":{"__typename":"CodeBlockMetadata","mode":"AUTO","lang":"python"},"iframe":null,"mixtapeMetadata":null},"Paragraph:d7051af5a0aa_44":{"__typename":"Paragraph","id":"d7051af5a0aa_44","name":"d07a","type":"PRE","href":null,"layout":null,"metadata":null,"text":"Yearly data generation slope:0.2 ppb\u002Fyear\nTrend: no trend\nHypothesis: Fail to reject null hypothesis of no trend\np-value: 0.08451668200699602\n\nYearly data generation slope:0.3 ppb\u002Fyear\nTrend: increasing\nHypothesis: Reject null hypothesis of no trend\np-value: 0.005446346816116554\n\nYearly data generation slope:0.1 ppb\u002Fyear without seasonal variation\nTrend: increasing\nHypothesis: Reject null hypothesis of no trend\np-value: 0.03902984383065089","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":{"__typename":"CodeBlockMetadata","mode":"EXPLICIT","lang":"python-repl"},"iframe":null,"mixtapeMetadata":null},"Paragraph:d7051af5a0aa_45":{"__typename":"Paragraph","id":"d7051af5a0aa_45","name":"20e9","type":"H4","href":null,"layout":null,"metadata":null,"text":"Seasonal Kendall Test","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:d7051af5a0aa_46":{"__typename":"Paragraph","id":"d7051af5a0aa_46","name":"61aa","type":"P","href":null,"layout":null,"metadata":null,"text":"The Seasonal Kendall test is an extension of the Mann-Kendall test designed to handle seasonality in the data. The Mann-Kendall test is non-parametric and does not assume a specific data distribution. The test assumes that the seasonal components (e.g., monthly or quarterly data) are independent and identically distributed.","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:d7051af5a0aa_47":{"__typename":"Paragraph","id":"d7051af5a0aa_47","name":"cc7b","type":"P","href":null,"layout":null,"metadata":null,"text":"Another version of the Mann-Kendall test considers periodicity in time series data. This test forms the significant trend detection window between 0.1 ppb\u002Fyear and 0.2 ppb\u002Fyear with the appropriate periodicity. However, a wrong periodicity value of 2 shows the same results as the general Mann-Kandal test.","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:d7051af5a0aa_48":{"__typename":"Paragraph","id":"d7051af5a0aa_48","name":"e31c","type":"PRE","href":null,"layout":null,"metadata":null,"text":"import pymannkendall as mk\n\ndef mk_seasonal_test(data, period=12):\n    '''using pymannkendall library with a seasonal test method'''\n    result_seasonal = mk.seasonal_test(data.concentration, period=period)  # Example period\n\n    print(f\"Yearly data generation slope:{data.slope}\")\n    print(f\"Trend: {result_seasonal.trend}\")\n    print(f\"Hypothesis: {'Reject null hypothesis of no trend' if result_seasonal.h else 'Fail to reject null hypothesis of no trend'}\")\n    print(f\"p-value: {result_seasonal.p}\\n\")\n    \nmk_seasonal_test(dataset[0], period=12)\nmk_seasonal_test(dataset[1], period=12)\nmk_seasonal_test(dataset[1], period=2)\nmk_seasonal_test(dataset[2], period=2)","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":{"__typename":"CodeBlockMetadata","mode":"AUTO","lang":"python"},"iframe":null,"mixtapeMetadata":null},"Paragraph:d7051af5a0aa_49":{"__typename":"Paragraph","id":"d7051af5a0aa_49","name":"63d2","type":"PRE","href":null,"layout":null,"metadata":null,"text":"Yearly data generation slope:0.1 ppb\u002Fyear\nTrend: no trend\nHypothesis: Fail to reject null hypothesis of no trend\np-value: 0.09755673352859229\n\nYearly data generation slope:0.2 ppb\u002Fyear\nTrend: increasing\nHypothesis: Reject null hypothesis of no trend\np-value: 0.00013780365183713172\n\nYearly data generation slope:0.2 ppb\u002Fyear\nTrend: no trend\nHypothesis: Fail to reject null hypothesis of no trend\np-value: 0.0820714015763353\n\nYearly data generation slope:0.3 ppb\u002Fyear\nTrend: increasing\nHypothesis: Reject null hypothesis of no trend\np-value: 0.005593338735154996","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":{"__typename":"CodeBlockMetadata","mode":"EXPLICIT","lang":"python-repl"},"iframe":null,"mixtapeMetadata":null},"Paragraph:d7051af5a0aa_50":{"__typename":"Paragraph","id":"d7051af5a0aa_50","name":"86d1","type":"H4","href":null,"layout":null,"metadata":null,"text":"Unit Root Tests","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:d7051af5a0aa_51":{"__typename":"Paragraph","id":"d7051af5a0aa_51","name":"84f0","type":"OLI","href":null,"layout":null,"metadata":null,"text":"Definition of Unit Root","hasDropCap":null,"dropCapImage":null,"markups":[{"__typename":"Markup","type":"STRONG","start":0,"end":23,"href":null,"anchorType":null,"userId":null,"linkMetadata":null}],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:d7051af5a0aa_52":{"__typename":"Paragraph","id":"d7051af5a0aa_52","name":"e63e","type":"P","href":null,"layout":null,"metadata":null,"text":"Consider a discrete-time stochastic process (yₜ, t = 1, 2, 3, …), and suppose that it can be described as an autoregressive process of order p:","hasDropCap":null,"dropCapImage":null,"markups":[{"__typename":"Markup","type":"EM","start":45,"end":46,"href":null,"anchorType":null,"userId":null,"linkMetadata":null},{"__typename":"Markup","type":"EM","start":48,"end":51,"href":null,"anchorType":null,"userId":null,"linkMetadata":null},{"__typename":"Markup","type":"EM","start":141,"end":142,"href":null,"anchorType":null,"userId":null,"linkMetadata":null}],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:d7051af5a0aa_53":{"__typename":"Paragraph","id":"d7051af5a0aa_53","name":"f150","type":"IMG","href":null,"layout":"INSET_CENTER","metadata":{"__typename":"ImageMetadata","id":"1*inxJPIXutrWozH17X0a73A.png","darkId":null,"originalHeight":56,"originalWidth":1050,"focusPercentX":null,"focusPercentY":null,"alt":null},"text":"","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:d7051af5a0aa_54":{"__typename":"Paragraph","id":"d7051af5a0aa_54","name":"85f0","type":"P","href":null,"layout":null,"metadata":null,"text":"Here, (εₜₜ, t =1, 2, 3, …) is a serially uncorrelated, zero-mean stochastic process with constant variance. Assuming y₀ = 0, if m = 1 is a root of the characteristic equation with multiplicity 1:","hasDropCap":null,"dropCapImage":null,"markups":[{"__typename":"Markup","type":"EM","start":7,"end":8,"href":null,"anchorType":null,"userId":null,"linkMetadata":null},{"__typename":"Markup","type":"EM","start":9,"end":10,"href":null,"anchorType":null,"userId":null,"linkMetadata":null},{"__typename":"Markup","type":"EM","start":12,"end":14,"href":null,"anchorType":null,"userId":null,"linkMetadata":null},{"__typename":"Markup","type":"EM","start":117,"end":119,"href":null,"anchorType":null,"userId":null,"linkMetadata":null},{"__typename":"Markup","type":"EM","start":128,"end":130,"href":null,"anchorType":null,"userId":null,"linkMetadata":null}],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:d7051af5a0aa_55":{"__typename":"Paragraph","id":"d7051af5a0aa_55","name":"29f8","type":"IMG","href":null,"layout":"INSET_CENTER","metadata":{"__typename":"ImageMetadata","id":"1*eJdvQJMJ45-sgrg0lKm-_w.png","darkId":null,"originalHeight":72,"originalWidth":1246,"focusPercentX":null,"focusPercentY":null,"alt":null},"text":"","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:d7051af5a0aa_56":{"__typename":"Paragraph","id":"d7051af5a0aa_56","name":"ca98","type":"P","href":null,"layout":null,"metadata":null,"text":"then the stochastic process has a unit root. The first-order autoregressive model, yₜₜ = a₁yₜ₋₁ + εₜ, has a unit root when a₁=1. In this case, the characteristic equation is m — a₁= 0. The root of the equation is m = 1. (Unit root) In the first-order model, εₜ is a white noise error term. In other words, the value of the series at time t is equal to its value at time t−1 plus a random error term. Shocks to the time series have a permanent effect.","hasDropCap":null,"dropCapImage":null,"markups":[{"__typename":"Markup","type":"EM","start":83,"end":84,"href":null,"anchorType":null,"userId":null,"linkMetadata":null},{"__typename":"Markup","type":"EM","start":85,"end":86,"href":null,"anchorType":null,"userId":null,"linkMetadata":null},{"__typename":"Markup","type":"EM","start":89,"end":90,"href":null,"anchorType":null,"userId":null,"linkMetadata":null},{"__typename":"Markup","type":"EM","start":91,"end":92,"href":null,"anchorType":null,"userId":null,"linkMetadata":null},{"__typename":"Markup","type":"EM","start":95,"end":99,"href":null,"anchorType":null,"userId":null,"linkMetadata":null},{"__typename":"Markup","type":"EM","start":100,"end":102,"href":null,"anchorType":null,"userId":null,"linkMetadata":null},{"__typename":"Markup","type":"EM","start":123,"end":124,"href":null,"anchorType":null,"userId":null,"linkMetadata":null},{"__typename":"Markup","type":"EM","start":174,"end":176,"href":null,"anchorType":null,"userId":null,"linkMetadata":null},{"__typename":"Markup","type":"EM","start":178,"end":179,"href":null,"anchorType":null,"userId":null,"linkMetadata":null},{"__typename":"Markup","type":"EM","start":213,"end":215,"href":null,"anchorType":null,"userId":null,"linkMetadata":null},{"__typename":"Markup","type":"EM","start":258,"end":259,"href":null,"anchorType":null,"userId":null,"linkMetadata":null},{"__typename":"Markup","type":"EM","start":338,"end":339,"href":null,"anchorType":null,"userId":null,"linkMetadata":null},{"__typename":"Markup","type":"EM","start":370,"end":371,"href":null,"anchorType":null,"userId":null,"linkMetadata":null}],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:d7051af5a0aa_57":{"__typename":"Paragraph","id":"d7051af5a0aa_57","name":"918e","type":"P","href":null,"layout":null,"metadata":null,"text":"2. Implications of Unit Root","hasDropCap":null,"dropCapImage":null,"markups":[{"__typename":"Markup","type":"STRONG","start":3,"end":28,"href":null,"anchorType":null,"userId":null,"linkMetadata":null}],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:d7051af5a0aa_58":{"__typename":"Paragraph","id":"d7051af5a0aa_58","name":"91ca","type":"P","href":null,"layout":null,"metadata":null,"text":"A time series with a unit root is non-stationary. Stationarity means that the statistical properties of the series (mean, variance, autocorrelation) are constant over time. Non-stationary time series with unit roots exhibit a time-dependent structure, meaning their behaviour changes over time, making prediction and analysis more complex.","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:d7051af5a0aa_59":{"__typename":"Paragraph","id":"d7051af5a0aa_59","name":"85ba","type":"P","href":null,"layout":null,"metadata":null,"text":"A unit root process is often described as a random walk. Each value is a random step away from the previous value in a random walk. This makes the series unpredictable, and any shock to the series has a lasting effect.","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:d7051af5a0aa_60":{"__typename":"Paragraph","id":"d7051af5a0aa_60","name":"e2fb","type":"P","href":null,"layout":null,"metadata":null,"text":"3. Augmented Dickey-Fuller (ADF) Test","hasDropCap":null,"dropCapImage":null,"markups":[{"__typename":"Markup","type":"STRONG","start":3,"end":37,"href":null,"anchorType":null,"userId":null,"linkMetadata":null}],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:d7051af5a0aa_61":{"__typename":"Paragraph","id":"d7051af5a0aa_61","name":"710e","type":"P","href":null,"layout":null,"metadata":null,"text":"The Dickey-Fuller Test tests the null hypothesis that a unit root is present in an autoregressive model. The ADF Test extends the Dickey-Fuller test, including lagged differences to account for higher-order autocorrelation. The presence of a unit root in a time series indicates that the series has a stochastic trend, making it non-stationary.","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:d7051af5a0aa_62":{"__typename":"Paragraph","id":"d7051af5a0aa_62","name":"eae6","type":"P","href":null,"layout":null,"metadata":null,"text":"Including additional lagged differences of the dependent variable to account for higher-order serial correlation, the ADF test statistic is defined as","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:d7051af5a0aa_63":{"__typename":"Paragraph","id":"d7051af5a0aa_63","name":"15da","type":"IMG","href":null,"layout":"INSET_CENTER","metadata":{"__typename":"ImageMetadata","id":"1*znQwVs-iHmFN_MARvNWTfg.png","darkId":null,"originalHeight":108,"originalWidth":912,"focusPercentX":null,"focusPercentY":null,"alt":null},"text":"","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:d7051af5a0aa_64":{"__typename":"Paragraph","id":"d7051af5a0aa_64","name":"f4e9","type":"P","href":null,"layout":null,"metadata":null,"text":"where Δyₜ is the first difference of yₜ, α is a constant term, βt is a trend term, γ yₜ₋₁​ is the coefficient on the lagged level of the series, the terms with summation are lagged differences, and ϵₜ is the error term.","hasDropCap":null,"dropCapImage":null,"markups":[{"__typename":"Markup","type":"EM","start":7,"end":8,"href":null,"anchorType":null,"userId":null,"linkMetadata":null},{"__typename":"Markup","type":"EM","start":37,"end":38,"href":null,"anchorType":null,"userId":null,"linkMetadata":null},{"__typename":"Markup","type":"EM","start":39,"end":42,"href":null,"anchorType":null,"userId":null,"linkMetadata":null},{"__typename":"Markup","type":"EM","start":62,"end":65,"href":null,"anchorType":null,"userId":null,"linkMetadata":null},{"__typename":"Markup","type":"EM","start":83,"end":86,"href":null,"anchorType":null,"userId":null,"linkMetadata":null},{"__typename":"Markup","type":"EM","start":198,"end":199,"href":null,"anchorType":null,"userId":null,"linkMetadata":null},{"__typename":"Markup","type":"EM","start":200,"end":201,"href":null,"anchorType":null,"userId":null,"linkMetadata":null}],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:d7051af5a0aa_65":{"__typename":"Paragraph","id":"d7051af5a0aa_65","name":"0477","type":"P","href":null,"layout":null,"metadata":null,"text":"4. Application of the ADF Test using the Python library","hasDropCap":null,"dropCapImage":null,"markups":[{"__typename":"Markup","type":"STRONG","start":0,"end":55,"href":null,"anchorType":null,"userId":null,"linkMetadata":null}],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:d7051af5a0aa_66":{"__typename":"Paragraph","id":"d7051af5a0aa_66","name":"b63c","type":"P","href":null,"layout":null,"metadata":null,"text":"Using the Python library, I have plotted a histogram of the ADF test statistics of non-stationary datasets generated by a random walk process.","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:d7051af5a0aa_67":{"__typename":"Paragraph","id":"d7051af5a0aa_67","name":"46a4","type":"PRE","href":null,"layout":null,"metadata":null,"text":"from statsmodels.tsa.stattools import adfuller\n\n# Function to generate a non-stationary time series (random walk)\ndef generate_random_walk(n):\n    return np.cumsum(np.random.normal(size=n))\n\n# Number of simulations\nnum_simulations = 1000\nsample_size = 100\nadf_statistics = []\n\n# Perform the ADF test on multiple random walk samples\nfor _ in range(num_simulations):\n    random_walk = generate_random_walk(sample_size)\n    result = adfuller(random_walk)\n    adf_statistics.append(result[0])\n\n# Plot the distribution of the ADF statistics\nplt.figure(figsize=(10, 6))\nplt.hist(adf_statistics, bins=50, density=True, alpha=0.6, color='g')\nplt.xlabel('ADF Statistic')\nplt.ylabel('Density')\nplt.title('Distribution of ADF Statistic for Non-Stationary Time Series')\nplt.axvline(x=np.percentile(adf_statistics, 2.5), color='r', linestyle='--', label='2.5th Percentile')\nplt.axvline(x=np.percentile(adf_statistics, 97.5), color='b', linestyle='--', label='97.5th Percentile')\nplt.legend();","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":{"__typename":"CodeBlockMetadata","mode":"EXPLICIT","lang":"python"},"iframe":null,"mixtapeMetadata":null},"Paragraph:d7051af5a0aa_68":{"__typename":"Paragraph","id":"d7051af5a0aa_68","name":"67a9","type":"IMG","href":null,"layout":"INSET_CENTER","metadata":{"__typename":"ImageMetadata","id":"1*Dq0aZGiCk8gLjS7XA_g1Gg.png","darkId":null,"originalHeight":812,"originalWidth":1268,"focusPercentX":null,"focusPercentY":null,"alt":null},"text":"","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:d7051af5a0aa_69":{"__typename":"Paragraph","id":"d7051af5a0aa_69","name":"b0df","type":"P","href":null,"layout":null,"metadata":null,"text":"Under the null hypothesis of a unit root (non-stationarity), the ADF test statistic does not follow a normal distribution. It follows the Dickey-Fuller distribution. The library uses a pre-calculated table for different sample sizes and lag numbers used in the test.","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:d7051af5a0aa_70":{"__typename":"Paragraph","id":"d7051af5a0aa_70","name":"907a","type":"P","href":null,"layout":null,"metadata":null,"text":"Applying the ADF test to the methane concentration trends, we obtain the same test results as the Ordinary Least Square Regression and the Mann-Kendall Trend Test as follows:","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:d7051af5a0aa_71":{"__typename":"Paragraph","id":"d7051af5a0aa_71","name":"cb9b","type":"PRE","href":null,"layout":null,"metadata":null,"text":"from statsmodels.tsa.stattools import adfuller\n\ndef dickeyfuller_test(data):\n    ''' Augmented Dickey-Fuller test '''\n    \n    adf_result = adfuller(data.concentration)\n\n    print(f\"Yearly data generation slope:{data.slope}\")\n    print(f\"ADF Statistic: {adf_result[0]}\")\n    print(f\"p-value: {adf_result[1]}\")\n    print(\"Critical Values:\")\n    for key, value in adf_result[4].items():\n        print(f\"   {key}: {value}\")\n    print()\n        \ndickeyfuller_test(dataset[1])\ndickeyfuller_test(dataset[2])","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":{"__typename":"CodeBlockMetadata","mode":"AUTO","lang":"python"},"iframe":null,"mixtapeMetadata":null},"Paragraph:d7051af5a0aa_72":{"__typename":"Paragraph","id":"d7051af5a0aa_72","name":"2302","type":"PRE","href":null,"layout":null,"metadata":null,"text":"Yearly data generation slope:0.2 ppb\u002Fyear\nADF Statistic: -3.131641940818521\np-value: 0.02429844851053876\nCritical Values:\n   1%: -3.458010773719797\n   5%: -2.8737103617125186\n   10%: -2.5732559963936206\n\nYearly data generation slope:0.3 ppb\u002Fyear\nADF Statistic: -2.627964831251696\np-value: 0.08735413744719817\nCritical Values:\n   1%: -3.458010773719797\n   5%: -2.8737103617125186\n   10%: -2.5732559963936206","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":{"__typename":"CodeBlockMetadata","mode":"EXPLICIT","lang":"python-repl"},"iframe":null,"mixtapeMetadata":null},"Paragraph:d7051af5a0aa_73":{"__typename":"Paragraph","id":"d7051af5a0aa_73","name":"19b1","type":"H4","href":null,"layout":null,"metadata":null,"text":"Closing Remarks","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:d7051af5a0aa_74":{"__typename":"Paragraph","id":"d7051af5a0aa_74","name":"9d88","type":"P","href":null,"layout":null,"metadata":null,"text":"Climate change is causing a wide range of extreme weather events worldwide. In 2021, North America experienced an unprecedented heat wave, with temperatures soaring above 40 degrees Celsius in many regions. This extreme heat led to wildfires, power outages and hundreds of deaths. This summer, China and South Korea are both experiencing severe flooding due to heavy rainfall linked to climate change. \nI created toy datasets to simulate the time series of global methane concentrations and statistically detect trends. I explored statistical test methods such as ordinary least square regression, Mann-Kendall, seasonal Mann-Kendall and unit root tests. Using the toy datasets and test tools, I know that we should reduce the slope to 1\u002F35 of the current slope if we want to get an insignificant trend in methane increase. Even if we can achieve such a reduction, global warming will continue for some time because of its latency. Hopeless news?","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:d7051af5a0aa_75":{"__typename":"Paragraph","id":"d7051af5a0aa_75","name":"253d","type":"H4","href":null,"layout":null,"metadata":null,"text":"References","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:d7051af5a0aa_76":{"__typename":"Paragraph","id":"d7051af5a0aa_76","name":"2a1d","type":"OLI","href":null,"layout":null,"metadata":null,"text":"pymannkendall 1.4.3 (2023, Jan 14) https:\u002F\u002Fpypi.org\u002Fproject\u002Fpymannkendall\u002F","hasDropCap":null,"dropCapImage":null,"markups":[{"__typename":"Markup","type":"A","start":35,"end":74,"href":"https:\u002F\u002Fpypi.org\u002Fproject\u002Fpymannkendall\u002F","anchorType":"LINK","userId":null,"linkMetadata":null}],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:d7051af5a0aa_77":{"__typename":"Paragraph","id":"d7051af5a0aa_77","name":"c895","type":"OLI","href":null,"layout":null,"metadata":null,"text":"Kendall rank correlation coefficient. (2024, June 30). In Wikipedia. https:\u002F\u002Fen.wikipedia.org\u002Fwiki\u002FKendall_rank_correlation_coefficient","hasDropCap":null,"dropCapImage":null,"markups":[{"__typename":"Markup","type":"A","start":69,"end":135,"href":"https:\u002F\u002Fen.wikipedia.org\u002Fwiki\u002FKendall_rank_correlation_coefficient","anchorType":"LINK","userId":null,"linkMetadata":null},{"__typename":"Markup","type":"EM","start":58,"end":67,"href":null,"anchorType":null,"userId":null,"linkMetadata":null}],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:d7051af5a0aa_78":{"__typename":"Paragraph","id":"d7051af5a0aa_78","name":"5f33","type":"OLI","href":null,"layout":null,"metadata":null,"text":"Unit root. (2024, January 28). In Wikipedia. https:\u002F\u002Fen.wikipedia.org\u002Fwiki\u002FUnit_root","hasDropCap":null,"dropCapImage":null,"markups":[{"__typename":"Markup","type":"A","start":45,"end":84,"href":"https:\u002F\u002Fen.wikipedia.org\u002Fwiki\u002FUnit_root","anchorType":"LINK","userId":null,"linkMetadata":null},{"__typename":"Markup","type":"EM","start":34,"end":43,"href":null,"anchorType":null,"userId":null,"linkMetadata":null}],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:d7051af5a0aa_79":{"__typename":"Paragraph","id":"d7051af5a0aa_79","name":"8049","type":"OLI","href":null,"layout":null,"metadata":null,"text":"Dickey–Fuller test. (2024, February 22). In 