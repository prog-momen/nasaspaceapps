        <section id="news" class="py-5">
            <div class="container">

                <h2 class="text-center mb-5">Recent News</h2>

                <div id="newsCarousel" class="carousel slide" data-bs-ride="carousel" data-bs-interval="12000">

                    <div class="carousel-inner">

                        <div class="carousel-item active">
                            <div class="news-wrapper">
                                <div class="news-image">
                                    <img src="/Images/artemis2.webp" alt="Artemis II Image">
                                    <!-- https://www.laurus-school.com/school-highlights/artemis-missions-to-the-moon -->
                                    <button type="button" class="news-toggle" aria-label="Pause Button">
                                        <i class=" newsToggleIcon fa-solid fa-pause"></i>
                                    </button>
                                </div>
                                <div class="news-text">
                                    <h3>Artemis II Mission</h3>
                                    <p>For the first time since 1972, NASA is sending humans back on
                                        a path toward the Moon with the Artemis II Mission</p>
                                </div>
                            </div>
                        </div>

                        <div class="carousel-item">
                            <div class="news-wrapper">
                                <div class="news-image">
                                    <img src="/Images/iss.webp" alt="ISS Image">
                                    <!-- https://spectrum.ieee.org/private-space-stations -->
                                    <button type="button" class="news-toggle" aria-label="Pause Button">
                                        <i class="newsToggleIcon fa-solid fa-pause"></i>
                                    </button>
                                </div>
                                <div class="news-text">
                                    <h3>Fermi Spots Star Cluster Blowing Gamma-Ray Bubbles</h3>
                                    <p>Explore this and other groundbreaking work from the Sciences
                                        and Exploration Directorate.</p>
                                </div>
                            </div>
                        </div>

                        <div class="carousel-item">
                            <div class="news-wrapper">
                                <div class="news-image">
                                    <img src="/Images/jwt.jpg" alt="James Webb Telescope Image">
                                    <!-- https://www.space.com/21925-james-webb-space-telescope-jwst.html -->
                                    <button type="button" class="news-toggle" aria-label="Pause Button">
                                        <i class=" newsToggleIcon fa-solid fa-pause"></i>
                                    </button>
                                </div>
                                <div class="news-text">
                                    <h3>Webb Telescope Observes Early Galaxies</h3>
                                    <p>New data from the James Webb Telescope reveals galaxies
                                        from the early universe</p>
                                </div>
                            </div>
                        </div>

                    </div>

                     <!-- Previous button -->
                    <button class="carousel-control-prev" type="button" data-bs-target="#newsCarousel" data-bs-slide="prev" aria-label="Previous Button">
                        <span class="news-arrow news-arrow-prev" aria-hidden="true">
                            <svg viewBox="-2 -2 24 24" xmlns="http://www.w3.org/2000/svg">
                                <path d="M20 8.80562L4.2455 8.80562L9.0504 3.6723L7.4855 2L0 10L7.4855 18L9.0504 16.3277L4.2455 11.1944L20 11.1944L20 8.80562Z" fill="currentColor"/>
                            </svg>
                        </span>
                    </button>

                    <!-- Next button -->
                    <button class="carousel-control-next" type="button" data-bs-target="#newsCarousel" data-bs-slide="next" aria-label="Next Button">
                        <span class="news-arrow news-arrow-next" aria-hidden="true">
                            <svg viewBox="-2 -2 24 24" xmlns="http://www.w3.org/2000/svg">
                                <path d="M-5.94966e-07 11.1944L15.7545 11.1944L10.9496 16.3277L12.5145 18L20 10L12.5145 2L10.9496 3.6723L15.7545 8.80562L-8.03799e-07 8.80562L-5.94966e-07 11.1944Z" fill="currentColor"/>
                            </svg>
                        </span>
                    </button>
                </div>
            </div>
        </section>

        <section class="data-highlights py-5">

            <div class="container">
                <h1 class="text-center mb-5">NSSDCA Highlights</h1>
            </div>

            <div class="highlight-scroll-wrapper">
                <div class="highlight-track">
                    <div class="highlight-row">

                        <div class="highlight-card">
                            <img src="../Images/nssdcaPresentation.png" alt="NSSDCA Presenation Image">
                            <div class="highlight-overlay">
                                <h2>NSSDCA Presentation</h2>
                                <button type="button" aria-label="Watch Video Button" onclick="window.location.href='https://www.youtube.com/watch?v=OHA2tm5Lvzg'">Watch Now</button>
                            </div>
                        </div>

                        <div class="highlight-card">
                            <img src="/Images/jupiter_nssdca.webp" alt="NSSDCA Article Image">
                            <div class="highlight-overlay">
                                <h2>NSSDCA Article</h2>
                                <button type="button" aria-label="Read Article Button" onclick="window.location.href='https://www.space.com/space-exploration/missions/how-a-mini-team-of-nasa-archivists-is-restoring-astronomical-history'">Learn More</button>
                            </div>
                        </div>

                        <div class="highlight-card">
                            <img src="../Images/decipheringPresentation.png" alt="NSSDCA Presenation Image">
                            <div class="highlight-overlay">
                                <h2>Deciphering Legacy Data Presentation</h2>
                                <button type="button" aria-label="Watch Video Button" onclick="window.location.href='https://www.youtube.com/watch?v=014ASB8CJws'">Watch Now</button>
                            </div>
                        </div>

                        <div class="highlight-card">
                            <img src="../Images/pioneerVenusPresentation.png" alt="NSSDCA Presenation Image">
                            <div class="highlight-overlay">
                                <h2>Pioneer Venus LNMS Data Story Presentation</h2>
                                <button type="button" aria-label="Watch Video Button" onclick="window.location.href='https://www.youtube.com/watch?v=0OSK5eUSz6A'">Watch Now</button>
                            </div>
                        </div>

                        <div class="highlight-card">
                            <img src="/Images/coronagraph.png" alt="Apollo 15 Coronal Photograph Image">
                            <div class="highlight-overlay">
                                <h2>Apollo 15 Coronal Photographs done by our NSSDCA scientists</h2>
                                <button type="button" aria-label="Learn More Button">In Development</button>
                            </div>
                        </div>

                        <div class="highlight-card">
                            <img src="/Images/apollo16.jpg" alt="Apollo 16 Geocorona and Auroral Emissions Image">
                            <div class="highlight-overlay">
                                <h2>Apollo 16 Geocorona and Auroral Emissions</h2>
                                <button type="button" aria-label="Learn More Button">In Development</button>
                            </div>
                        </div>                       

                    </div>
                </div>
            </div>

        </section>

        <section class="picture-day py-5">
            <div class="container">
                <h2 class="text-center mb-5">Astronomy Picture of the Day</h2>

                <div class="pod-wrapper">
                    <div class="pod-image">
                        <img id="apod-image" src="/Images/pod.webp" alt="NASA Astronomy Picture of the Day">
                        <video id="apod-video" controls playsinline style="display: none;"></video>
                        <iframe id="apod-frame" style="display: none;" title="Picture of the Day"></iframe>
                    </div>

                    <div class="pod-text">
                        <h3 id="apod-title">Loading Astronomy Picture...</h3>

                        <p id="apod-description">Fetching today's image from NASA...</p>

                        <a id="apod-link" href="https://science.nasa.gov/apod/" class="btn mt-3" target="_blank" rel="noopener noreferrer">
                            APOD Website
                        </a>
                    </div>
                </div>
            </div>
        </section>

        <section id="contact" class="contact py-5">
            <div class="container">

                <div class="row align-items-center g-5">

                    <div class="col-lg-5">
                        <div class="contact-intro">
                            <h2>Contact Us</h2>
                            <p class="lead">
                                NASA Space Science Data Coordinated Archive
                            </p>

                            <p class="contact-description">
                                For data access, archive support, or technical questions,
                                please reach out to the appropriate contact. Our team is
                                available to assist with mission data and archive services.
                            </p>
                        </div>
                    </div>

