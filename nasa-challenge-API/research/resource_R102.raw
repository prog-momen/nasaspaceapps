<script src="/js/institution/recherche-video/analytics.js"></script>
<script>
	$(document).ready(function(){
		var theme = getParameterByName('theme');
		if(theme !== null){
			$("a[href^='/']").each(function(){
				if($(this).attr("href").indexOf("theme=") == -1){
					if($(this).attr("href").indexOf("?") == -1){
						$(this).attr("href", $(this).attr("href") + "?");
					} else{
						$(this).attr("href", $(this).attr("href") + "&");
					}
					$(this).attr("href", $(this).attr("href") + "theme=" + theme);
				}
					
			})
		}
		
		
	});
	
	function getParameterByName(name, url) {
		if (!url) url = window.location.href;
		name = name.replace(/[\[\]]/g, "\\$&");
		var regex = new RegExp("[?&]" + name + "(=([^&#]*)|&|#|$)"),
			results = regex.exec(url);
		if (!results) return null;
		if (!results[2]) return '';
		return decodeURIComponent(results[2].replace(/\+/g, " "));
	}
</script>
	
	<script type="text/javascript">_satellite.pageBottom();</script>
	
    
    <script>
		$(document).ready(function(){
			$("#banner-video-control").on("click", ".pause, .play", function(e){
				e.stopImmediatePropagation();
				e.preventDefault();
				
				
				if($(this).hasClass("pause")){
					$(this).find(".action").text("Play");
					$(this).removeClass("pause").addClass("play");
					document.getElementById("banner-video").pause();
					
					$(this).find("span.icon").html("<i class=\"fa-regular fa-circle-play fa-2x\" style=\"vertical-align:middle;\"></i>");
				}
				else if($(this).hasClass("play")){
					$(this).find(".action").text("Pause");
					$(this).removeClass("play").addClass("pause");
					document.getElementById("banner-video").play();
					
					$(this).find("span.icon").html("<i class=\"fa-regular fa-circle-pause fa-2x\" style=\"vertical-align:middle;\"></i>");
				}
				
			});
		});
	</script>
	
