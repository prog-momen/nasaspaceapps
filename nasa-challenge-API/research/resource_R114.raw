  padding-bottom: 40px;
}

/**
 * SITEMAP CSS CLASSES
 */
.sitemap a {
	color:#2a5387;
}
.sitemap hr {
	max-width:100%!important; 
}

.sitemap .mini-separator {
	max-width:90%!important; 
	float:left;
} 

