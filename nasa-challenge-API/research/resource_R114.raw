    background: var(--button-background, var(--color-primary));
    border: var(--button-border, 0);
    border-radius: var(--button-border-radius, var(--border-radius));
    outline: var(--button-outline, none);
    box-shadow: var(--button-box-shadow, none);
    -webkit-transform: var(--button-transform, none);
    transform: var(--button-transform, none);
    -webkit-filter: var(--button-filter, none);
    filter: var(--button-filter, none);
    cursor: var(--button-cursor, pointer);
    opacity: var(--button-opacity, 1);
    transition: var(--button-transition, var(--transition));
    margin-top: 20px;
}
.listing-search-results p, .listing-search-results h2 {
	
	color: #f6f7f8;
}
.search-breadcrumbs  {
	padding-bottom:10px;
	font-size: 16px;
}
.search-results-count {
	font-weight: bold;
	padding-bottom: 30px;	
	font-size: 16px;
}
.search-breadcrumbs .fa-chevron-right {
	padding-right: 10px;
    padding-left: 10px;
    font-size: 15px;
}

 /*Capabilities search form*/
.padding-bottom-50  {
	 padding-bottom: 50px;
}
.listing-search-container {
	display:flex;
	justify-content: space-between;
}

/* Search box and dropdown box*/
.listing-search-container .text-search-form input, .listing-search-container .category-search-form select {
	background: transparent;
	border: 2px solid white;
	color: #f6f7f8;
	height: 40px;
	max-width: 100%;
	width: 100%;
}
.listing-search-container .text-search-form, .listing-search-container .category-search-form {
	width: 50%;
	margin:auto;
	
/* When division filter is added only use width:40%; */
}
/* Category dropdown options */
.listing-search-container select option {
	background: black;
}
/* Search button - magnifying glass icon */
.listing-search-container button, .listing-search-container button:hover  {
	background: transparent;
	border: none;
	padding-left: 10px;
	padding-top: 0px;
	padding-bottom: 0px;
	font-size: 20px; 
}
/* Make magnifying glass icon span on same line */
.listing-search-container  .search-input-wrapper, .listing-search-container  .search-select-wrapper {
	 position: relative;
   display: flex;
   align-items: center; 
}
.text-search-form input {
    margin-right: 10px;
}

/* Style the select dropdown */
.category-search-form select {
    -webkit-appearance: none;
    -moz-appearance: none;
    appearance: none;
    padding: 8px;
    border: 1px solid #ddd;
    border-radius: 4px;
    width: 100%;
    background-color: #fff;
	margin-right: 10px 
}

/* Create a custom dropdown arrow as > */
.search-select-wrapper {
    position: relative;
}
 
.search-select-wrapper::after {
    content: "";
    position: absolute;
    right: 2.8rem; 
    top: 50%;
    width: 8px;
    height: 8px;
    border-right: 2px solid white;
    border-bottom: 2px solid white;
    transform: translateY(-70%) rotate(45deg); /* Create > shape by rotating a square */
    pointer-events: none;
}

/* Position the search button */
.listing-search-container .search-icon-button, .listing-search-container .search-icon-button:hover {
	  padding:0px;
}

/* For Firefox which doesn't support the arrow hiding well */
	select: :-ms-expand {
    display: none;
}

select::-moz-focus-inner {
	border: 0;
	outline: 0;
}


/** 
 *  cFS PAGES CSS CLASSES
*/
/* cFS Symposium Agenda */
/* Hide 7th column DATA cells only */
.cfs-event-agenda table tr td:nth-child(n+8) {
  display: none;
}
/* Style for the vertically merged agenda column */
.cfs-event-agenda td[rowspan] {
  writing-mode: vertical-rl;   /* flow bottom → top */
  text-orientation: mixed;
  text-align: center;
  vertical-align: middle;
  padding: 12px;
	transform: rotate(180deg);
}
/* Responsive: reset rotation on small screens */
@media (max-width: 768px) {
  .cfs-event-agenda td[rowspan] {
    writing-mode: horizontal-tb;
    text-orientation: initial;
    transform: none;
    text-align: center;
  }
}
/* Staff Box - cFS Organizing Committee */
.wpforms-submit-container {
	margin-top: 20px;
}
.cfs-symposium-committee .staff-box {
	height: 100%;
} 
.cfs-symposium-committee {
  padding: 1.25rem;
  box-sizing: border-box;
  display: flex;
}
/* cFS Events Tab Style */
.cfs-events-tab .active {
	background-color: #eeeeee00;
} 

.cfs-agenda-toggle .wp-block-ub-content-toggle-accordion-title {
	    padding: 10px 0px 10px 0px;
}
/* Make sub menu sticky */
.symposium-sub-menu {
	position: sticky;
    top: calc(var(--admin-height, 0px) + 200px);
}

/* cFS Symposium Registration Form */
.cfs-requirement-text {
	padding-left: 20px;
	padding-bottom: 10px;
} 
@media only screen and (max-width: 600px) {
	.cfs-symposium-form form {
		width: 100%!important; 
	}
}
.cfs-symposium-form form {
	margin: 0 auto; 
	text-align: left; 
	font-size: 16px;
	width: 70%; 
}
.cfs-symposium-form label {
	width: 100%; 
}
.cfs-symposium-form form  > p  {
	padding-top: 10px;
}
.cfs-symposium-form div label:has(.wpcf7-form-control-wrap), .cfs-symposium-form div:has(.wpcf7-form-control-wrap) {
	padding-bottom: 20px;
}
.cfs-symposium-form input {
	padding: var(--input-padding,.9em);
		font-size: 16px;
} 
.cfs-symposium-form .wpcf7-list-item {
	display:block;
	margin-left:0px;
}
.cfs-symposium-form .wpcf7-list-item label {
	margin-bottom:0px;
}
/* cFS Banner */
/* cFS Banner */
.content-sidebar-wrap:has(.cfs-banner), .content-sidebar-wrap:has(.cfs-sub-banner) {
	margin-top:0px;
}
.cfs-header .wp-block-cover-is-layout-flow:has(.cfs-sub-banner) {
	margin-top:calc(var(--transparent-header-offset,0) + 53px)!important;
}
.cfs-header .wp-block-cover-is-layout-flow:has(.cfs-banner) {
	margin-top:calc(var(--transparent-header-offset,0) - 60.1px)!important;
}
.cfs-banner, .cfs-sub-banner {
    z-index: 1;
	padding-left: 10%;
		padding-right: 10%;
}

@media (min-width: 900px) and (max-width: 1000px) {
.cfs-header .wp-block-cover-is-layout-flow:has(.cfs-banner){
		margin-top:0px!important;
}
	.cfs-header .wp-block-cover-is-layout-flow:has(.cfs-sub-banner) {
		margin-top:calc(var(--transparent-header-offset,0) + 80px)!important;
}
}
@media (max-width: 900px) {
.cfs-header .wp-block-cover-is-layout-flow:has(.cfs-banner), .cfs-header .wp-block-cover-is-layout-flow:has(.cfs-sub-banner) {
		margin-top:calc(var(--transparent-header-offset,0) + 80px)!important;
}
}

@media (max-width: 600px) {
		.cfs-banner .training-name, .cfs-sub-banner .training-name {
		justify-content: center;
	}
}


/* cFS NCSC */
/* Make NCSC staff and application areas images same size on tablet/mobile */
.cfs-ncsc img, .cfs-application-areas img, .cfs-core-team img {
	width: 100%!important;
}
/* Training Glow Boxes */
.cfs-training-header {
	padding-bottom: 20px;
}

/* Mobile cFS Event tabs */
.horizontal-tabbed-block.cfs-event .wp-block-ub-tabbed-content-accordion-toggle {
	background-color: transparent!important;
	color: #28abe3;
}

.horizontal-tabbed-block.cfs-event .wp-block-ub-tabbed-content-accordion-toggle.active {
	background-color: #ffffff36!important;
}
/* cFS event agenda and vendor table styles */
.cfs-event-agenda  tbody tr:first-child td, .cfs-vendor-table tbody tr:first-child td {
	background-color:#2e425a;
	border: none!important;
}
.cfs-event-agenda  tbody td, .cfs-event-agenda table, .cfs-vendor-table  tbody td, .cfs-vendor-table table { 
	border: 2px #2e425a solid;
}

.cfs-event-agenda tbody tr:first-child td:first-child {
	width: 10%;
}
.cfs-event-agenda tbody tr:first-child td:nth-child(3) {
	width: 20%;
}
.cfs-event-agenda, .cfs-vendor-table {
	border-bottom: none!important;
}


/* Fixes cFS Anchors for contact form */
body.page-id-17335 {
	--scroll-margin-top: 200px!important;
}
/* Fixes cFS Anchors for Catalog page */
body.page-id-17354 {
	--scroll-margin-top: 300px!important;
}

/** 
 *  IDC PAGES CSS CLASSES
*/
/* IDC Focus Areas Block */
.idc-focus-areas .mai-column p {
	text-align: center;
	width: 100%;
	height: 100px;
	display: flex;
	justify-content: center;
}

.idc-focus-areas {
	padding-top: 60px;
}

/* Bottom two boxes*/
.idc-focus-areas .bottom-row {
	left: 100px;
}   
/* Box headers */
.idc-focus-areas .box-1-header {
	position: absolute;
	top: -15%;
	left: 35%;
}

.idc-focus-areas .box-2-header {
	position: absolute;
	top: 0%;
	right: 5%;
}

.idc-focus-areas {
	position: relative!important;
}
/* Left box, first box */
.idc-focus-areas::before {
	top: -18%;
	left: -1.9%;
	right: 19.1%;
	bottom: 0%;
	border: 4px solid white;
	border-radius: 20px;
	pointer-events: none;
	content: "";
	position: absolute;
}
/* Right box */
.idc-focus-areas::after {
	top: -5%;
	left: 19%;
	right: -1.9%;
	bottom: -9%;
	border: 4px solid white;
	border-radius: 20px;
	pointer-events: none;
	content: "";
	position: absolute;
}

.idc-focus-areas .long-img img {
	height: 400px;
	width: 100%!important;
	object-fit: cover;
}

.idc-focus-areas .short-img img {
	height: 150px!important;
	width: 200px!important;
	object-fit: cover;
}
/* Tablet */
@media only screen and (max-width: 999px) {
	.idc-focus-area-spacer {
		height: 40px!important;
	}
	/* Top box*/
	.idc-focus-areas::before {
		top: 0%;
		left: 5%;
		right: 5%;
		bottom: 22%;
		border: 4px solid white;
		border-radius: 20px;
		pointer-events: none;
		content: "";
		position: absolute;
	}
/* Bottom box */
	.idc-focus-areas::after {
		top: 19%;
		left: -2%;
		right: -2%;
		bottom: 0%;
		border: 4px solid white;
		border-radius: 20px;
		pointer-events: none;
		content: "";
		position: absolute;
	}

	.idc-focus-areas .bottom-row {
		left: 0px;
	}

	.idc-focus-areas .mai-column p {
		width: 80%;
	}

	.idc-focus-areas .mai-column img {
		height: 150px!important;
		width: 200px!important;
	}

	.idc-focus-areas .mai-column {
		align-items: center;
	}

	.idc-focus-areas .box-1-header {
		position: absolute;
		top: 20.5%;
		left: 39%;
	}

	.idc-focus-areas .box-2-header {
		position: absolute;
		top: 79%;
		right: 45%;
	}
}
/* Mobile view*/
@media only screen and (max-width: 550px) {
		/* Top box*/
	.idc-focus-areas::before {
		right: 0%;
		left: 0%;
		bottom: 16%;
	}
/* Bottom box */
	.idc-focus-areas::after {
		right: -5%;
		top: 14%;
		left: -5%;
	}

	.focus-area-p {
		margin-bottom: 20px!important;
	}

	.idc-focus-areas .box-2-header {
		top: 85%!important;
	}

	.idc-focus-areas .box-1-header {
		top: 15%!important;
		left: 25%!important;
	}

	.idc-focus-areas .mai-column p {
		width: 100%;
	}
}
/* IDC Study block - fixes last margin */

.idc-study-block .wp-block-list {
	margin-left: 20px;
}
