/** 
 *  KEY PERSONNEL - ORG CHART CSS CLASSES
*/
/* Org chart button for key personnel */
.buttons-download-org-chart {
	color: white !important;
	padding: var(--button-small-padding, 0.75rem 1.25rem);
	margin-left: 0.8rem;
}

.buttons-org-chart {
	color: white !important;
	padding: var(--button-small-padding, 0.75rem 1.25rem);
}

.buttons-org-chart:active, .buttons-org-chart:focus, .buttons-download-org-chart:active {
	background-color: var(--button-background,var(--color-primary))!important;
}

.buttons-org-chart:hover, .buttons-download-org-chart:hover {
	background-color: var(--button-background-hover,var(--color-primary-dark,var(--button-background,var(--color-primary))))!important;
}

#org-wrapper hr {
	width: 50%;
	margin-bottom: 5px;
}
/* Org chart job titles */
#org-wrapper .job-title {
	font-size: 15px;
	margin: 0px;
}
/* Org chart staff names */
#org-wrapper .staff-member {
	font-size: 17px;
	font-weight: bold;
	margin-bottom: 5px;
	display: block;
} 
/* Links to profiles */
#org-wrapper .staff-member a {
	text-decoration: none;
	color: white;
}

#org-wrapper .staff-member a:hover {
	text-decoration: none;
	color: #28abe3;
}
/* Org chart box division name headers */
#org-wrapper h4 {
	font-size: 20px;
	font-weight: bold;
	color: #deaf48;
	margin-bottom: 0px;
}
/* Org chart box code headers */
#org-wrapper  .org-chart-code {
	font-size: 20px;
	color: #deaf48;
}
/* Org chart - Hide overflow lines */
.organizational-chart .primary-stack div, .organizational-chart .secondary-level div, .organizational-chart .etd-directorate-chart, .organizational-chart .new-business div {
	z-index: 4!important;
} 

/* Fade animation for org chart */
#org-wrapper {
	opacity: 0;
	transition: opacity 1s ease;
}

#org-wrapper.show {
	display: block;
	opacity: 1;
}
/* Fade animation for table */
#abcfsltTbl_7649 {
	opacity: 0;
	transition: opacity 1s ease;
}

#abcfsltTbl_7649.show {
	display: block;
	opacity: 1;
}

@media only screen and (min-width: 1000px) {
 
	.control {
		display: none;
	}
}

#org-wrapper {
	margin-left: auto;
	margin-right: auto;
	max-width: 80em;
}

#org-container {
	float: left;
	width: 100%;
}

.organizational-chart p {
	font-size: 16px;
}

ol.organizational-chart,
ol.organizational-chart ol,
ol.organizational-chart li,
ol.organizational-chart li > div {
	position: relative;
}

ol.organizational-chart,
ol.organizational-chart ol {
	list-style: none;
	margin: 0;
	padding: 0;
}

ol.organizational-chart {
	text-align: center;
}

ol.organizational-chart ol {
	padding-top: 1em;
}

ol.organizational-chart ol:before,
ol.organizational-chart ol:after,
ol.organizational-chart li:before,
ol.organizational-chart li:after,
ol.organizational-chart > li > div:before,
ol.organizational-chart > li > div:after, ol.organizational-chart > li > div div:after,  ol.secondary-level > li > div:after {
	background-color: #b7a6aa;
	content: '';
	position: absolute;
}

ol.organizational-chart ol > li {
	padding: 1em 0 0 1em;
}

ol.organizational-chart > li ol:before {
	height: 1em;
	left: 50%;
	top: 0;
	width: 3px;
}

ol.organizational-chart > li ol:after {
	height: 3px;
	left: 3px;
	top: 1em;
	width: 50%;
}

ol.organizational-chart > li ol > li:not(:last-of-type):before {
	height: 3px;
	left: 0;
	top: 2em;
	width: 1em;
}

ol.organizational-chart > li ol > li:not(:last-of-type):after {
	height: 100%;
	left: 0;
	top: 0;
	width: 3px;
}

ol.organizational-chart > li ol > li:last-of-type:before {
	height: 3px;
	left: 0;
	top: 2em;
	width: 1em;
}

ol.organizational-chart > li ol > li:last-of-type:after {
	height: 2em;
	left: 0;
	top: 0;
	width: 3px;
}

ol.organizational-chart li > div div {
	border-radius: 3px;
	min-height: 2em;
}

/*** PRIMARY ***/
/* Assistant Director New Business boxes */
#org-wrapper .new-business, .etd-manager, .etd-directorate-chart {
	background-color: #141821;
	border: 1px solid #b7a6aa; 
	border-radius: 25px!important;
	margin-top: 30px;
	padding-top: 20px!important;
	padding-bottom: 20px!important;
	padding-right: 10px!important;
	padding-left: 10px!important;
}
#org-wrapper .new-business-wallops {
		top:20px!important;
}
/* Business Branch Box*/
.business-branch {
	background-color: #0E1218;
	border: 3.5px dashed #b7a6aa;
	border-radius: 25px!important;
	margin-top: 30px;
	padding-top: 20px!important;
	padding-bottom: 20px!important;
	padding-right: 10px!important;
	padding-left: 10px!important;
	position: relative;
}
.wallops {
	background-color: #0E1218;
	border: 1px solid #b7a6aa; 
	top:-20px;
	border-radius: 25px!important;
	margin-top: 30px!important;
	margin-bottom: 30px!important;
	padding-top: 20px!important;
	padding-bottom: 20px!important;
	padding-right: 10px!important;
	padding-left: 10px!important;
	position: relative;
}

#org-wrapper .new-business {
	top: 0;
}

ol.organizational-chart > li > div + div {
	margin-top: 1em;
}

.primary-stack:before {
	display: none;
}
.secondary-level {
	    padding-top: 3em!important;
}

.primary-stack-bottom {
	margin-top: 30px;
}

.primary-stack {
	padding-bottom: 0px!important;
}
/*** SECONDARY ***/
ol.organizational-chart > li > ol:before {
	left: inherit;
	right: 0;
}

ol.organizational-chart > li > ol:after {
	left: 0;
	width: 100%;
}
/* 540 to 590 org boxes */
ol.organizational-chart > li > ol > li > div {
	border: 1px solid #b7a6aa;
	border-radius: 25px;
	padding-top: 20px!important;
	padding-bottom: 20px!important;
	padding-right: 10px!important;
	padding-left: 10px!important;
}

.secondary-first-three, .etd-directorte, .primary-stack, .new-business {
	flex-basis: calc(33% - 10px)!important;
}

.secondary-last-two {
	flex-basis: calc(100% - 20px);
	max-width: 45%;
}

.primary-container, .secondary-level {
	display: flex!important;
	flex-wrap: wrap!important;
}
/* Code 540, 550, and 560 */
.secondary-level div {
	background-color: #090B0F;
}

@media only screen and ( max-width: 400px ) {
			/* Height of primary line for mobile */
	.primary-level:before {
		height: 85.6%!important;
	}
}
/*** Org Chart - Tablet/Mobile ***/

@media only screen and ( max-width: 1099px ) {
	.wallops {
	top:0px!important;
	}
			/* Make container for boxes full width to allow boxes float right */
	.organizational-chart .primary-level, .secondary-level, #org-container .secondary-level li {
		max-width: 100%;
		width: 100%;
		padding: 0px;
	}
	/* Make primary (code 500) org chart boxes not full width for smaller devices to allow room for connencting lines on the left side */
	#org-container .new-business, .wallops, .business-branch,  #org-container .etd-manager {
		width: 90%;
		float: right;
		margin-right: 0px;
		margin-left:auto;
		margin-top:20px;
	}
		.business-branch {
		width: 90%;
		float: right;
		margin-right: 0px;
		margin-left:auto;
		margin-top:20px;
		background-color:#141821!important;
	}
	.new-business-wallops {
		margin-top:0px!important;
	}
	
/* Make secondary (divisions) org chart boxes not full width for smaller devices to allow room for connencting lines on the left side */
	.secondary-level li div {
		width: 90%;
		padding: 0px;
		float: right;
		margin-top:20px;
	}
	.secondary-level li  {
		margin-bottom:0px;
	}
	.secondary-level {
		padding-top:0px!important;
	}
	/* Remove right space to allow more room for text */
	#org-container ol.organizational-chart > li > div {
		margin-right: 0px;
		padding: 0px;
	}
		/* Make boxes stacked */
	li.primary-level, .organizational-chart .secondary-level {
		display: flex;
		flex-direction: column;
	}
		/* Change order of Code 500 boxes when stacked */
	.directorate-business-branch {
		order: 1;
	}
	
	.etd-manager {
				order: 2;
	}
	.new-business-wallops {
order:3;
	} 
		/*  
	.business-branch { 
order:5;
	}
	.wallops {
		order: 4;
	}
	*/
		.secondary-level {
		order: 6;
	}

	/* Make ETD Directorate full width */
	#org-container 
	.organizational-chart li .etd-directorate-chart {
		width: 100%;
		padding-top: 20px;
		padding-bottom: 20px;
	}
	/* Main line connecting ETD Directorate to other boxes*/
	.primary-level:before {
		height: 85.56%;
		left: 0.1%;
		top: 10%;
		width: 3px;
		z-index: -1;
	}
	/* Add space between asssistant directors, managers, and business branch */
	#org-wrapper .primary-stack .primary-side {
		margin-top: 20px;
	}
		/* Line from ETD Directorate to Assistant Directors */
	.primary-level .assistant-directors div:after {
		height: 3px;
		left: .5%;
		top: 50%;
		width: 10%;
		z-index: -1;
	}
	/* Line from ETD Directorate to Managers */
	.primary-stack .primary-side:after {
		height: 3px;
		left: .5%;
		top: 25%;
		width: 10%;
		z-index: -1;
	}
/* Line from ETD Directorate to Business Branch and Wallops */
	.primary-stack .business-branch-line:after, 	.primary-stack .wallops-line:after {
		height: 3px;
		left: .5%;
		top: 85%;
		width: 12%;
		z-index: -1;
	}
	/* Line from ETD Directorate to New Business */
	.primary-stack .new-business-line:after {
		height: 3px;
		left: .5%;
		top: 40%;
		width: 12%;
		z-index: -1;
	}
	.wallops-line, .new-business-line { 
		padding-right:0!important;
	}
		/* Line from ETD Directorate to New Business */
	.etd-manager:after {
		height: 3px;
		left: 0.5%;
		top: 40%; 
		width: 12%;
		z-index: -1;
	}
	/* Makes connecting line underneath box not on top */
	.primary-level {
		z-index: 0;
	}

	.secondary-level:after, .secondary-first-three:after {
		display: none;
	}
		/* Line connecting ETD Directorate to Code 550 ***/
	#org-wrapper li.secondary-first-three.secondary-code-550:before {
		height: 3px;
		left: .5%;
		top: 50%;
		width: 10%;
		z-index: -1;
	}

	.secondary-level:before {
		display: none;
	}
			/* Line connecting ETD Directorate to Code 560 and  ETD Directorate to Code 540 ***/
	#org-wrapper li.secondary-first-three:before {
		height: 3px;
		left: 0.5%;
		top: 50%;
		width: 10%;
		z-index: -1;
	}
/* Line connecting Code 580 to Code 590. Hide on tablet/mobile ***/
	#org-wrapper li.secondary-last-two:after {
		display: none;
	}
	/* Line connecting Code 580 to ETD Directorate***/
	#org-wrapper li.secondary-last-two.secondary-code-580:before {
		left: .5%;
		height: 3px;
		width: 10%;
		top: 50%;
	}

	#org-wrapper li.secondary-last-two.secondary-code-590:before {
		left: -11%;
		height: 3px;
		width: 11%;
		top: 50.5%;
		left: .2%;
		z-index: -1;
	}

	.etd-directorate-chart:before {
		height: 510%;
	}
}



@media only screen and ( min-width: 1100px ) {
 
.etd-directorate-chart {
	top: 4rem;
}
	ol.organizational-chart {
		margin-left: -1em;
		margin-right: -1em;
	} 

    /* PRIMARY */
	.etd-directorate-chart {
		margin-bottom: 430px!important;
	}
	.wallops {
		
		margin-bottom: 2rem!important;
	}
	.wallops-line {
		right: 150px;
    position: relative;
		top:60px;
	}
	/* Make primary boxes start at top */
	ol.organizational-chart li > div div {
		padding-top: 0px;
	}

	ol.organizational-chart > li > div {
		display: inline-block;
		float: none;
		margin: 0 1em 1em 1em;
		vertical-align: bottom;
	}

	ol.organizational-chart > li > div:only-of-type {
		margin-bottom: 0;
		width: calc((100% / 1) - 2em - 4px);
	}

	ol.organizational-chart > li > div:first-of-type:nth-last-of-type(2),
    ol.organizational-chart > li > div:first-of-type:nth-last-of-type(2) ~ div {
		width: calc((100% / 2) - 2em - 4px);
	}

	ol.organizational-chart > li > div:first-of-type:nth-last-of-type(3),
    ol.organizational-chart > li > div:first-of-type:nth-last-of-type(3) ~ div {
		width: calc((100% / 3) - 2em - 4px);
	}

	ol.organizational-chart > li > div:first-of-type:nth-last-of-type(4),
    ol.organizational-chart > li > div:first-of-type:nth-last-of-type(4) ~ div {
		width: calc((100% / 4) - 2em - 4px);
	}

	ol.organizational-chart > li > div:first-of-type:nth-last-of-type(5),
    ol.organizational-chart > li > div:first-of-type:nth-last-of-type(5) ~ div {
		width: calc((100% / 5) - 2em - 4px);
	}

	ol.organizational-chart > li > div:before {
		bottom: -1em!important;
		top: inherit!important;
	}

	ol.organizational-chart > li > .etd-directorate-chart:before {
		display: none;
	}
/* Primary between boxes lines */
	
	/* Line from ENGINEERING BUSINESS BRANCH  to ETD DIRECTORATE 
	  .business-branch-line:before {
        left: 50%;
        height: 4% !important;
        width: 3px !important;
        bottom: 46%;
		border-right: 3.5px dashed #b7a6aa;  
    content: '';
    position: absolute;
		z-index:0;
    }
	
	/* Line from Functional Leads to ETD DIRECTORATE */
 .etd-manager:after {
		bottom: 10px;
		height: 3px;
		top: 20%;
		width: 11.5%;
		left: 100%;
	}
/* Line from ETD DIRECTORATE to Code 501*/
 .new-business-wallops:after {
		bottom: 10px;
		height: 3px;
		top: 25%;
		width: 15.5%;
		right: 100%!important;
	}
	.wallops-line:after {
		    right: 97%; 
        height: 3px !important;
        width: 23% !important;
        bottom: 50%;
    content: '';
    position: absolute;
		z-index:0;
		background-color: #b7a6aa;
    content: '';
	}
    /* SECONDARY */
	ol.organizational-chart > li > ol {
		display: flex;
		flex-wrap: nowrap;
	}

	ol.organizational-chart > li > ol:before,
    ol.organizational-chart > li > ol > li.secondary-first-three:before {
		height: 1em!important;
		left: 50%!important;
		top: 0!important;
		width: 3px!important;
	}

	ol.organizational-chart > li > ol:after {
		display: none;
	}

	ol.organizational-chart > li > ol > li {
		flex-grow: 1;
		padding-left: 1em;
		padding-right: 1em;
		padding-top: 1em;
	}

	ol.organizational-chart > li > ol > li:only-of-type {
		padding-top: 0;
	}

	ol.organizational-chart > li > ol > li:only-of-type:before,
    ol.organizational-chart > li > ol > li:only-of-type:after {
		display: none;
	}

	ol.organizational-chart > li > ol > li:first-of-type:not(:only-of-type):after,
    ol.organizational-chart > li > ol > li:last-of-type:not(:only-of-type):after {
		height: 3px;
		top: 0;
		width: 50%;
	}

	ol.organizational-chart > li > ol > li:first-of-type:not(:only-of-type):after {
		left: 50%;
	}

	ol.organizational-chart > li > ol > li:last-of-type:not(:only-of-type):after {
		left: 0;
	}

	ol.organizational-chart > li > ol > li + li:not(:last-of-type):after {
		height: 3px;
		left: 0;
		top: 0;
		width: 100%;
	}

	/* Line connecting ETD DIRECTORATE to Code 550 */
	#org-wrapper li.secondary-first-three.secondary-code-550:before {
     height:160.8% !important;
        top: -140.5% !important;
	} 

	.secondary-level:before {
		display: none;
	}
/* Line connecting ETD DIRECTORATE to Code 560 */
	#org-wrapper li.secondary-first-three.secondary-code-560:after {
		width: 50%;
	}
/* Line connecting Code 580 to Code 590 */
	#org-wrapper li.secondary-last-two:after {
		display: none;
	}
	/* Line connecting Code 580 to ETD DIRECTORATE */
	#org-wrapper li.secondary-last-two.secondary-code-580:before {
		left: 50%;
        height: 160% !important;
        width: 3px !important;
        top: -125%;
	}
	/* Make 580 and 590 boxes black to hide extra lines */
	#org-wrapper li.secondary-last-two.secondary-code-580 div,#org-wrapper li.secondary-last-two.secondary-code-590 div {
		background-color: black;
	}
		/* Make 580 and 590 boxes float to middle */
	#org-wrapper li.secondary-last-two.secondary-code-580 {
		margin-left: auto;
	}

	#org-wrapper li.secondary-last-two.secondary-code-590 {
		margin-right: auto;
	}
			/* Make 580 and 590 boxes width same as other divisions */
	#org-wrapper li.secondary-last-two.secondary-code-580,#org-wrapper li.secondary-last-two.secondary-code-590 {
		flex-basis: calc(33% - 10px) !important;
		max-width: 33.5%;
	}
		/* Line connecting Code 590 to ETD DIRECTORATE */
	#org-wrapper li.secondary-last-two.secondary-code-590:before {
		left: 50%;
		height: 159%!important;
		width: 3px!important;
		top: -125%;
	}
}



/** 
 * IMAGES/MULTIMEDIA PAGES CSS CLASSES
*/
.attachment .site-inner {
	background: white;
}
.no-margin {
	margin:0px;
}
.multimedia-pagination span, .multimedia-pagination a:hover {
	color: #f6f7f8!important;
}
@media (max-width:1000px) {
.multimedia-post-group .wp-container-core-post-template-is-layout-2f3213d7 {
    grid-template-columns: repeat(2, minmax(0, 1fr))!important;
}
}
@media  (min-width:100px) and (max-width:500px) {
.multimedia-post-group .wp-container-core-post-template-is-layout-2f3213d7 {
    grid-template-columns: repeat(1, minmax(0, 1fr))!important;
}
}
/* Hide hovered caption on tablet and mobile*/
@media only screen and (max-width: 800px) {
	.gallery-mobile .fg-caption {
		display: none!important;
	}
}

/* Make images in gallery span full width in tablet and mobile views */
@media only screen and (max-width: 800px) {
	.foogallery.fg-masonry .fg-item {
		margin: 5px !important;
		width: calc(100% - 10px) !important;
		min-width: calc(100% - 10px) !important;
		max-width: calc(100% - 10px) !important;
	}
}
/* Images Pagination Style */
/* Active dot style*/
.page .fg-paging-container.fg-light .fg-dot-item.fg-selected .fg-dot-link, .fg-paging-container.fg-light .fg-dot-item .fg-dot-link:hover {
	background: #03a9f5;
	width: 20px;
	height: 20px;
	opacity: 1;
}

.fg-paging-container.fg-light .fg-dot-item .fg-dot-link:focus:before, .fg-paging-container.fg-light .fg-dot-item .fg-dot-link:hover:before, .fg-paging-container.fg-light .fg-dot-item.fg-selected .fg-dot-link:before {
	background-color: transparent;
	border-color: transparent;
}
/* Disactive Dot Style */
.fg-paging-container.fg-light .fg-dot-item .fg-dot-link {
	background-color: #03a9f5;
	height: 20px;
	opacity: .5;
	width: 20px;
	border-color: transparent;
	margin-right: 8px;
}

.attachment-description-p {
	padding-bottom: 15px;
	display: block;
}
/* Add margin to bottom of video thumbnail so header aligns with others */
.video-thumbnail figure {
	margin-bottom: 32px!important;
}

@media only screen and (max-width: 1250px and min-width: 1000px) {
	.video-thumbnail figure {
		margin-bottom: 42px!important;
	}
}
/* On attachment page, make title, description, and download button show on top first and move image after for tablet and mobile views */
@media only screen and (max-width: 1000px) {
	.attachment .entry-content-single {
		display: flex!important;
	}

	.attachment {
		order: 2;
		width: 100%;
	}

	.download-side-menu {
		order: 1;
		margin-left: 0px!important;
	}

	.attachment .entry-content-single .attachment {
		flex: none!important;
	}
}
/* "Installing the roman space telescope's nervous system" margin top */
.svs-text-margin {
	margin-top: 26px!important;
}
/* Pagination*/
.entry-pagination {
	padding-bottom: var(--padding-bottom-lg,var(--padding-lg));
}

body[class*='paged'] .site-inner, .page-id-9832 .site-inner, .page-id-12063 .site-inner {
	background: black!important;
}

body[class*='paged'] .pagination, .page-id-9832 .pagination, .page-id-12063 .pagination {
	color: white;
	margin-bottom: 20px;
}

body[class*='paged'] .pagination .button, .page-id-9832 .pagination .button,  .page-id-12063 .pagination .button {
	margin-left: 10px;
	background: black;
	border: 2px solid black;
}

body[class*='paged'] .pagination a:hover, body[class*='paged'] .pagination a:focus, body[class*='paged'] .pagination a:focus-visible, body[class*='paged'] .pagination [type=button], body[class*='paged'] .pagination [type=reset], .page-id-9832 .pagination a:hover, .page-id-9832 .pagination a:focus, .page-id-9832 .pagination a:focus-visible, .page-id-9832 .pagination [type=button], .page-id-9832 .pagination [type=reset], .page-id-9832 [type=submit], .page-id-12063 .pagination a:hover, .page-id-12063 .pagination a:focus, .page-id-12063 .pagination a:focus-visible, .page-id-12063 .pagination [type=button], .page-id-12063 .pagination [type=reset], .page-id-12063 [type=submit] {
	border: 2px solid var(--button-background-hover,var(--color-primary-dark,var(--button-background,var(--color-primary))))!important;
	background: black!important;
	text-transform: none;
	transition: none;
}

body[class*='paged'] .pagination .current, .page-id-9832 .pagination .current, .page-id-12063 .pagination .current {
	border: 2px solid var(--button-background-hover,var(--color-primary-dark,var(--button-background,var(--color-primary))));
	background: black;
	color: white;
}

body[class*='paged'] .wp-block-group.alignfull {
	display: block;
}

body[class*='paged'] .gallery-mobile .wp-block-group {
	margin-right: var(--side-spacing);
	margin-left: var(--side-spacing);
}


/*
@media (max-width:400px) {
body[class*='paged'] .site-inner  .wp-block-columns {
	gap: 0px;
}
}
*/


.videos-paged-padding {
	padding-left: 20px;
	padding-right: 20px;
}

body[class*='paged'] .site-footer .mai-columns-wrap {
}

body[class*='paged'] .etd-link-footer .wp-block-group__inner-container, body[class*='paged']  .etd-link-footer .wp-block-group__inner-container {
	max-width: -webkit-fill-available;
}

body[class*='paged'] .etd-link-footer .wp-block-group__inner-container .wp-block-group .wp-block-group__inner-container {
	max-width: 100%!important;
}

body[class*='paged'] h2 {
	font-weight: 300;
	padding-top: var(--padding-top-sm,var(--padding-sm));
}

@media (max-width:1000px) {
	.caption-hover figcaption {
		overflow: hidden!important;
		white-space: nowrap;
		text-overflow: ellipsis;
	}
/* Make images full width on smaller screens */	
	.gallery-mobile .wp-block-gallery.has-nested-images figure.wp-block-image:not(#individual-image), .gallery-mobile .wp-block-gallery.has-nested-images.columns-3 figure.wp-block-image:not(#individual-image) {
		width: 100%;
	}
}

/* Hide caption and title */
.attachment .entry-excerpt-single, .attachment .entry-title {
	display: none;
}

/* Hide p tags except php title, description, and image */
.attachment .entry-content-single p:not(.attachment, .attachment-description, .attachment-download-btn) {
	display: none;
}

.attachment .fa-download {
	margin-left: 8px;
}
/* Allow img, description, and download btn on same row */
.attachment .entry-content-single {
	display: flex;
	flex-wrap: wrap;
	margin-bottom: 30px;
}

.attachment .entry-content-single .attachment {
	flex: 1;
}

.attachment .entry-content-single .download-side-menu {
	display: flex;
	flex-direction: column;
	flex: 1;
	margin-left: 30px;
}

.attachment .entry-content-single img {
	height: auto;
	width: 100%;
}
/* Make attachment pages wider */
.attachment .has-standard-content {
	--content-max-width: var(--breakpoint-xl);
}

/* NEEDS TO BE ADDED FOR ALL GALLERY BLOCKS */
.gallery-margin {
	margin-top: var( --wp--style--gallery-gap-default, var( --gallery-block--gutter-size, var( --wp--style--block-gap, 0.5em ) ) )!important;
	margin-bottom: 0px;
}

.caption-hover figcaption {
	opacity: 0;
	transition: opacity  0.4s ease;
	padding-right: 20px!important;
	padding-left: 15px!important;
}

/* Tablet or smaller, make captions one line */
@media (max-width:1000px) {
	.caption-hover figcaption {
		overflow: hidden!important;
		white-space: nowrap;
		text-overflow: ellipsis;
	}
}

.caption-hover:hover figcaption {
	opacity: 1;
	transition-delay: 0.1s;
}

.wp-block-gallery.has-nested-images figure.wp-block-image figcaption {
	background: rgba(0,0,0,.7)!important;
	padding-top: 10px;
}

.attachment .entry-meta-before-content, .attachment .author-box, .attachment .pagination {
	display: none;
}

.attachment .pagination {
	padding-top: 40px;
}

.attachment-download-btn {
	padding-top: 20px;
}

/* Add space to make gallery attachment page lognger*/
.attachment .entry-content-single {
	padding-bottom: 60px;
}
/** 
 *  BRANCHES PAGES CSS CLASSES
*/

.branch-page img {
	width: 100%!important;
	padding-right: 15px;
}

.branch-page figcaption {
	width: 94%!important;
}

/* Make branch line wider */
.branch-line .wp-block-separator:not(.is-style-wide):not(.is-style-dots) {
	max-width: 100%;
	height: 0.5px;
}

/* Background color for branch pages */
.branch-background {
	background: linear-gradient(0deg,rgb(160,174,183) 11%,rgb(238,238,238) 53%,rgb(169,184,195) 92%);
}

/** 
 *  INTERNSHIP PAGE CSS CLASSES
*/
/* Add glow boxes to internships page */
.internship-glow {
	border: 1px solid #eee;
	margin-bottom: 30px;
	padding-top: 40px;
	padding-bottom: 25px;
	padding-right: 20px;
	padding-left: 20px;
	height: 95%;
	transition: all 0.3s ease 0s;
}

.internship-glow:hover {
	box-shadow: 0 5px 65px 0 rgba(255, 255, 255, 0.5);
	-webkit-box-shadow: 0 5px 65px 0 rgba(255, 255, 255, 0.5);
}
/* Fixes padding issues in mobile for quotes and images */
.education-quotes .wp-block-column {
	padding-left: 25px;
	padding-right: 26px;
}
/* For columns that have an image on the left, show image last in column instead of first in mobile view */
@media only screen and (max-width: 800px) {
	.education-column-left-image :nth-child(1) {
		order: 2;
	}

	.education-column-left-image :nth-child(2) {
		order: 1;
	}
}
/*Don't break word "Opportunities" in education header */
h1.no-word-break {
	word-break: normal;
}
/** 
 *  STORIES ARCHIVE PAGES CSS CLASSES
*/
body {
	--body-background-color: black;
}
body:has(.about-etd-page) {
	--body-background-color: transparent;
}

/* Make text for each story/update float left*/
.stories-updates-page .entry-wrap {
	padding-left: 5px;
	padding-right: 5px;
}
@media (min-width:400px) {
.stories-updates-page .entry-image-link {
	margin-right: 30px;
}
}
.white-text .page-numbers {
	color: white!important;
}
/* Archive Stories Pagination */
.page-numbers {
	color: black;
	transition:none;
	margin-left: 10px;
	margin-right: 10px;
	padding: 5px 15px;
	border: 2px solid transparent;
	border-radius: 5px;
}
.page-numbers:active, .page-numbers:hover, .page-numbers.current {
	border: 2px solid #2a5387;
	border-radius: 5px;
	text-decoration:none;
	color: black;
	transition:none;
}
.wp-block-query-pagination .wp-block-query-pagination-previous-arrow, .wp-block-query-pagination .wp-block-query-pagination-next-arrow   {
	display: none;
}
/* For pagninations on black background color, make pagination numbers white instead of black */
.black-pagination .page-numbers:active, .black-pagination .page-numbers:hover, .black-pagination .page-numbers.current {
	color:white;
}
/** 
 *  POST PAGES CSS CLASSES
*/

/* Make captions left align for post pages */
figcaption {
	text-align: left;
}

/* Add space on post pages between category and pagination on post pages*/
.entry-meta-after-content {
  padding-bottom: 10px;
}

/* Background color for post pages */
.single-post .site-container {
  background: linear-gradient(
    0deg,
    rgb(160, 174, 183) 11%,
    rgb(238, 238, 238) 53%,
    rgb(169, 184, 195) 92%
  );
}

/* Text color for single post page */
.single-post div,
.single-post h1,
.single-post figcaption {
  color: black;
}

/* Text color for category links and paragraph links on single post page */
.single-post .entry-terms-category a,
.single-post .entry-content a {
  color: #2a5387;
}

/* Text color for button links on single post page */
.single-post .wp-block-button a {
  color: white;
}

/* Makes pagination on post pages have white boxes - comment out if user wants boxes to be gradient 
.single-post .pagination-previous {
	background: white;
}
.single-post .pagination-next {
	background: white;
}
*/

/* Add space at bottom of category and link for post pages*/
.entry-terms-tag {
  padding-bottom: 15px;
}

/* Add space bottom of category for post pages */
.entry-terms-category {
  padding-bottom: 20px;
}
.tribe-common-l-container .tribe-events-c-subscribe-dropdown__container .tribe-events-c-subscribe-dropdown {
	padding-top: 20px;
}


/** 
 *  STAFF LIST PRO - PROFILE PAGES CSS CLASSES
*/
/* Align image left of name, job title, and icons */
.profile-page .staff-profile-image {
    float: left;
    margin-right: 30px;
}
.profile-page .staff-name {
margin-top: 50px;
	display: inline-table;
}

/* Creates space between last div and footer for profile pages */
.staff-last-div {
  padding-bottom: 20px;
}

/* Removes profile link on profile pages*/
.profile-page .fa-address-card {
  display: none;
}
/* Profile Pages - Background */
.page-id-2921 {
	background:linear-gradient(0deg,rgb(160,174,183) 11%,rgb(238,238,238) 53%,rgb(169,184,195) 92%);
}
/* Profile Pages - Name and Job title*/
.page-id-2921 h2, .page-id-2921 h4, .page-id-2921 p, .page-id-2921 li, .page-id-2921 div  {
	color: black;
}
.page-id-2921 .site-inner a {
    color: #2a5387;
}
/* Profile Pages - Social Icons */
 .page-id-2921  .staff-social-links i {
	 
	color: black!important;
    font-size: 30px!important;
}
/* Profile Pages - Staff Member Name */
.page-id-2921 .staff-name {
    font-size: 30px;
}
/* Profile Pages - Job Title */
.page-id-2921 .staff-job {
	   padding-top: 10px;
    font-size: 20px;
}
/* Profile Pages - Bio */
.page-id-2921 .staff-last-div  {
	padding-top:30px;
}
/* Profile Pages - Staff Image */
.staff-profile-image img {
  width: 300px!important;
	border-radius: 50%!important;
  object-fit: cover;
	aspect-ratio: 1 / 1; 
}

/** 
 *  STAFF LIST PRO -  ORG CHART CSS CLASSES
*/
/* Make staff list pro icon white */
.white-staff-icon i::before {
	color:#c1c1c1;
}

/* Org chart pages staff image */
.circle-staff-img {
	height: 50%!important;
	aspect-ratio: 1/1;
  width: 100%!important;
	margin-top: 5px;
  object-fit: cover!important;
}

@media only screen and (max-width: 460px) { 
	.circle-staff-img {
  width: 80%!important;
}
}
/* Padding for staff images on org pages */
.abcfslTxtColGridB {
	padding-right: 30px;
	padding-left: 20px;
	padding-top: 10px;
}
/* Make staff images same sizes */
.abcfslGridCntr img {
	height: 170px;
	width: 130px;
}
/* Make org chart icon have space on top */
.org-icon-margin {
  margin-top: 10px;
}

/* Remove category for staff list pro org charts*/
.abcfslFiltersCntr {
