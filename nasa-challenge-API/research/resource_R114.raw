<style id="wp-custom-css">
/** 
 *  Do not use reusable blocks as the header or first block of a page, it removes the transparency in the nav menu 
 * If footer contents are misaligned, add no margin bottom to last block of the page 
*/

/** 
 *  TABLE OF CONTENTS 
 *  GLOBAL CSS CLASSES
 *  GLOBAL SEARCH CSS CLASSES
 *  REUSABLE BLOCKS CSS CLASSES
 *  MAIN NAVIGATION CSS CLASSES
 *  SECONDARY NAVIGATION CSS CLASSES 
 *  HOME PAGE CSS CLASSES
 *  ABOUT ETD PAGE CSS CLASSES
 *  KEY PERSONNEL PAGE CSS CLASSES
 *  KEY PERSONNEL - ORG CHART CSS CLASSES
 *  IMAGES/MULTIMEDIA PAGES CSS CLASSES
 *  CAPABILITIES AND FACILITIES  POST SEARCH CSS CLASSES
 *  cFS PAGES CSS CLASSES
 *  IDC PAGES CSS CLASSES
 *  PARTNERSHIPS CSS CLASSES
 *  OUR WORK PAGE CSS CLASSES
 *  DIVISION PAGES CSS CLASSES
 *  BRANCHES PAGES CSS CLASSES
 *  INTERNSHIPS PAGE CSS CLASSES
 *  STORIES ARCHIVE PAGES CSS CLASSES
 *  POST PAGES CSS CLASSES
 *  STAFF LIST PRO - PROFILE PAGES CSS CLASSES
 *  STAFF LIST PRO - ORG CHART CSS CLASSES
 *  404 PAGE CSS CLASSES 
 *  SITEMAP CSS CLASSES
 *  PASSWORD PROTECTED PAGES CSS CLASSES
 *  CONTACT FORMS CSS CLASSES
 *  POST SLIDER CSS CLASSES
 *  OUTGASSING DATABASE CSS CLASSES
 *  FONT CUSTOMIZATION CSS CLASSES
 *  FOOTER CSS CLASSES
*  DEPRECATED: EVENT SINGLE PAGES CSS CLASSES
 * DEPRECATED: EVENT PAGES CSS CLASSES
 *  DEPRECATED: SOCIAL MEDIA CSS CLASSES
*/

/** 
 *  GLOBAL CSS CLASSES
*/
.grecaptcha-badge {
    visibility: hidden !important;
}
.gold-text {
	color: #DEAF48;
}
.red-text {
	color: red;
}
.error404, .error404 h2 {
	color:white;
}
@media only screen and (max-width: 750px) {
	.hide-on-mobile {
		display: none;
	}
}
/* Font size for captions */
.caption-style {
	font-size: 14px;
}
/* Makes full header smaller on mobile */
@media only screen and (max-width: 900px) {
	.full-header {
		min-height: 701px!important;
	}

	.full-header .has-lg-padding-bottom {
		padding-top: var(--padding-top-xl,var(--padding-xl));
	}
}
/* Add opacity to img */
.opacity-img {
	opacity: 0.8;
}
/* Changes color of mobile menu icon */
.menu-toggle-icon {
	color: white!important;
}


/* Preloader styles - spinner */
#preloader {
	position: fixed;
	top: 0;
	left: 0;
	width: 100%;
	height: 100%;
	background: #000;
 /* Black background */
	z-index: 9999;
 /* Ensure it's on top of all other content */
    display: flex;
    align-items: center;
    justify-content: center;
}

#preloader-inner {
    width: 50px;
    height: 50px;
    border: 5px solid #fff; /* White outer ring color */
    border-top: 5px solid black; /* Black inner ring color for the spinner */
    border-radius: 50%;
    animation: spin 1s linear infinite;
}

@keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
}

/* Base CSS for page transitions
*/ 
body .site-container {
  position: relative;
}
/* Overlay */
body .site-container:before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: black; /* Color to fade to */
  opacity: 1; /* Start as fully black */
  transition: opacity 1s ease-in-out; /* Smooth transition for fade effect */
  z-index: 20; /* Ensure it is on top */
  pointer-events: none;
}

/* Fade to black */
body .site-container.page-transition-out::before {
  opacity: 1;
}

/* Fade back to clear */
body .site-container.page-transition-in::before {
  opacity: 0;
}

.pointer-cursor img {
	pointer-events: none;
}
.pointer-cursor:hover {
	cursor: pointer;
}
/* Ensure overlay does not affect text, buttons, and headers */
.mobile-header h1, .mobile-header p, .mobile-header .wp-block-buttons {
    position: relative;
    z-index: 3 !important;
}
/* Fix text in mobile from being cut off  */
@media (max-width: 600px) {
	.cover-text {
		font-size: 46px!important;
		margin-left: 20px; 
		margin-right: 20px;
		word-break: keep-all;
	}
	/* Cover text for Flight Projects in Development Page*/
	.flight-projects-dev {
				font-size: 36px!important;
		margin-left: 0px; 
		margin-right: 0px;
		word-break: keep-all;
	}
	
	/* Make header and header text smaller on mobile view
	.mobile-header {
		min-height: 448px!important;
	}
	.mobile-header h1, .mobile-header h2 {
		font-size: 40px!important;
	}
		.mobile-header p {
		font-size: 28px!important;
	}
	*/
}
/* Light backgrounds need darker colored links */
.darker-link a {
  text-decoration: none;
  color: #2a5387;
}
.darker-link a:hover {
  text-decoration: underline;
}

/*  Makes header font smaller on mobile view. Fixes no padding for cover header text on smaller viewports */
@media only screen and (max-width: 500px) {
.mobile-header-font {
	font-size: 36px!important;
}
}
/* Custom padding to change size of cover header for pages. Add to the group inside cover blocks */
.cover-group-header-size {
  padding-top: 104px;
  padding-bottom: 104px;
}

/* Removes margin bottom for first line of text in covers. Add to covers that has mutliple lines of text. Such as division cover h2 tags  */
.cover-group-header {
	margin-bottom: 0px;
}

/* Removes outline when clicking images or buttons */
button, button:hover, button:active, button:focus, a, a:hover, a:active, a:focus {
  outline: 0;
}
/**
 * GLOBAL SEARCH CSS CLASSES
 */
 
/* Search box */
@media only screen and (max-width: 999px) {
	 .search-icon {
		display: none!important;
	}
	.search-button-input-container {
		padding: var(--menu-item-link-padding, var(--spacing-md) var(--spacing-md));
	}
}
@media only screen and (min-width: 1000px) {
 .search-button-input-container {
	position: relative;
   display: inline-block;
}

.search-box-container input[type="text"] {
    width: calc(100% - 40px);
    padding: 8px 10px; 
    border: none; 
    outline: none; 
    font-size: 16px; 
		position:relative;
		top: 100%;
		right:0;
	z-index: 1;
}

.search-box-container input[type="submit"] {
    top: 0;
    right: 0;
    width: 40px; 
    height: 100%;
    background-color: #007bff; 
    color: #fff; 
    border: none; 
    border-radius: 0 4px 4px 0; 
    cursor: pointer;
    transition: background-color 0.3s ease; 
}

.search-box-container input[type="submit"]:hover {
    background-color: #0056b3; 
}
.search-box-container #query {
	width: 150px; 
	height: 30px;
	background-color:transparent;
	border: var(--input-border, 1px solid white);
	color:white;
  opacity: 1;
	border-radius: 0;
	padding-top:10px;
	padding-right: 30px;
	margin-left:15px;
}
#query.open {
	transform: translateX(0);
  opacity: 1;
	width: 260px; 
}
	.search-box-container .search-icon {
		  position: absolute;
  right: 8px;
  top: 60%;
  transform: translateY(-50%);
  pointer-events: none;
	z-index: 9;
		color:white;
	}
}
/* Results Page */
.search-results form {
margin-top:40px;
}
body[class*='paged'] .breadcrumb, body[class*='paged'] .entry-header  {
	display:none;
}
body[class*='paged'] .content-sidebar-wrap {
	margin-top:0px;
}
.body[class*='paged'] .search-container form {
	margin-top:0px!important;
	padding-top: 200px;
}
.total-results {
	padding-top: 15px;
	padding-bottom: 50px;
	font-size: 16px;
}
.search-container {
	padding-bottom: 40px;
	padding-top: 40px;
	width: 100%;
}
	.search-results {
width: 80%;
		padding-top: 10px;
}
.result hr {
	margin-top: 30px;
	margin-bottom: 30px;
}
.result p {
	font-size: 16px;
}
.result h3 {
	font-size: 22px;
}
.search-page-btn {
	    position: relative;
    border-radius: 0px 10px 10px 0px;
	height: 48px;
}
.search-page-textbox input {
	border-radius: 10px 0px 0px 10px;
    width: 60%;
    display: inline;
    border: none;
	  color: black;
}
.powered-by {
	float:right;
}
/* Search pagination*/
.search-pagination {
	padding-right: 5px;
}
.search-pagination-buttons {
	padding-left: 10px;	
	padding-right: 10px;
  background: transparent;
  color: black;
  font-size: 18px;
}
.search-footer .current, .search-footer a:hover {
    color: #2a5387;
	
}

/**  
 *  REUSABLE BLOCKS CSS CLASSES
*/
/* Publications block */
.publication-links p {
	margin-bottom:20px;
	padding-top:15px;
	padding-bottom:15px;
	padding-left: 15px;
	padding-right: 15px;
}
.publication-links p:nth-child(odd) {
	background-color:#b7c1c9;
}
.publication-links a {
	color:#2a5387;
	font-weight:bold;
}
.publication-links a:hover {
	color:#2a5387;
}
/* Spotlight slider classes*/ 
/* Size of pagination dots */
.spotlight-slider .owl-dots .owl-dot {
	margin-right:10px;
	width: 20px!important;
	height:20px!important;
}
/* Remove dotted background */
.spotlight-slider .psacp-post-slider-wrap.psacp-design-2 .psacp-col-left, .psac-post-slider.psac-design-2 .psac-post-left .psac-post-overlay, .spotlight-slider .psacp-post-slider-wrap.psacp-design-2 .psacp-featured-meta {
    background-color: transparent;
    background-image: none !important;
}
.spotlight-slider .psacp-col-left {
    margin-left: 30px;
}
.spotlight-slider .psacp-post-slider-wrap.psacp-design-2 .psacp-featured-meta {
	margin: 0px;
	padding: 0px;
	align-items: normal; 
}
.spotlight-slider h2.psacp-post-title {
    font-size: var(--h2-font-size, var(--font-size-xxl));
    letter-spacing: var(--heading-letter-spacing, normal);
    line-height: var(--heading-line-height, var(--line-height-sm));
}
.spotlight-slider .psacp-post-content .psacp-post-desc {
    font-size: var(--font-size-md);
	    line-height: var(--body-line-height, var(--line-height-lg))
}
.spotlight-slider .owl-carousel .owl-stage-outer {
	margin-bottom: 7%;
} 
.spotlight-slider .psacp-post-slider-wrap.psacp-design-2 .psacp-col-right {
        padding-left: 0.9375em;
        padding-right: 0.9375em;
}
.spotlight-slider  .psacp-wrap  .owl-prev {
    left: -40px !important;
}
.spotlight-slider  .psacp-wrap  .owl-next {
    right: -60px !important;
}
.spotlight-slider .psacp-post-slider-wrap .owl-nav {
    top: 40% !important;
}
.spotlight-slider .psacp-post-content {
	padding-bottom:80px;
}
.spotlight-slider .psacp-rdmr-btn {
	margin-bottom: 20px;
}
@media only screen and (max-width: 900px) {
	.spotlight-slider .psacp-post-img-bg {
		margin-right:25px!important;
	}
.spotlight-slider .psacp-col-left.psacp-col-2, .spotlight-slider .psacp-col-right.psacp-col-2 {
    margin-left: 0.6em!important;
	padding-left: 0px!important;
	}
	 .spotlight-slider .psacp-col-right.psacp-col-2 {
    margin-bottom: 40px!important;
	}
}

/* White header for spotlight slider */
.spotlight-header {
		margin-left:30px;
	border-bottom: 1px solid white;
	margin-right:30px;
}

/* Staff Icon Boxes */
.staff-box {
	border: 1px white solid;
  padding-left: 20px; 
	  padding-right: 10px;
	padding-top: 10px;
	padding-bottom: 10px;
	height: 7rem;
