 *  PASSWORD PROTECTED PAGES CSS CLASSES
*/

.post-password-required {
  padding-top: 150px;
  padding-bottom: 100px;
}

/** 
 *  CONTACT FORMS CSS CLASSES
*/
/* Make confirmation color white on most pages */
.wpforms-confirmation-container p {
	color: white;
}
/* Make confirmation color black on division pages */
.division-background .wpforms-confirmation-container p {
	color: black;
}
/* Make field with class span left */
.section-header {
	right:10%;
}
/* Make confirmation text link color */
.wpforms-confirmation-container {
	color:#28abe3;
}
/* Make contact fields grey */
.wpforms-field-container input, .wpforms-field-container textarea {
	background:#f9f9f9;
	color: #6B727B;
}
.wpforms-field-container input::placeholder,
.wpforms-field-container textarea::placeholder {
  color: inherit!important; 
	opacity: 1 !important;
}
.wpforms-confirmation-container p {
	text-align:center;
	padding-top:20px;
	padding-bottom:20px;
}
/* Show label in form   */
.form-show-label .wpforms-field-label, .wp-core-ui div.wpforms-container .wpforms-field-label {
    display: contents;
		font-size: 16px;
}
.form-show-label .wpforms-field-label-inline {
	color: white;
	display:contents; 
	font-size:16px;
}
.form-show-label ul  {
	 list-style-type: none;
}
/* Hides input fields */
.hide-field input {
	display: none!important;
}
/* Adds margin top to submit button */
.margin-top-btn {
	margin-top: 10px!important;
}

/* Hide label for wp forms but still pass accessibility scans */
.wpforms-container label {
  position: absolute;
  width: 1px;
  height: 1px;
  margin: -1px;
  padding: 0;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  border: 0;
}

/* Add space between recaptcha and send button */
.wpforms-recaptcha-container {
	margin-bottom: 20px;
}
/* Make send button flush left for education contact form */
button.form-button-left {
	float: left;
}

@media (min-width:800px)  {
.contact-small-width {
	width: 70%;
}
	.contact-center {
		margin-right: auto;
  	 margin-left: auto;
	}
}
/* Adds padding to contact forms in mobile view */
@media (max-width:320px) {
.contact-padding .g-recaptcha iframe {
	  transform: scale(0.75);
    transform-origin: 0 0; 
}
	.contact-padding  {
	    margin-right: var(--side-spacing);
    margin-left: var(--side-spacing);
}
}
@media (min-width: 320px) and (max-width:350px) {
.contact-padding .g-recaptcha iframe {
	  transform: scale(0.9);
    transform-origin: 0 0; 
}
	.contact-padding  {
	    margin-right: var(--side-spacing);
    margin-left: var(--side-spacing);
}
	
}

/* Removes padding for field items on contact forms */
.contact-form .wpforms-field {
  padding: 5px !important;
}

/** 
 * POST SLIDER CSS CLASSES
*/
/* Make searchbox placeholder text brighter */
.search-input-wrapper input::placeholder {
	opacity:0.6;
}
/* More Stories link */
@media only screen and (max-width: 1220px) {
 .more-stories  {
	 margin-right: 0px!important;
}
}
@media only screen and (max-width: 400px) {
 .more-stories p {
	 float: left!important;
}
} 
 .more-stories {
  overflow: hidden;
	padding-bottom: 20px; 
	margin-left: 0px;
}
.more-stories h2 {
	float: left;
}
.more-stories p {
	float: right;
	font-size: 18px;
}
.more-stories a {
	color: black;
}
.more-stories .etd-updates {
	color:white;
}
.fa-stack.small {
    font-size: 0.6em;
	margin-left: 10px;
	color: #deaf48;
  } 
/* Make arrow black*/
.more-stories .fa-inverse {
	color:black;
}
/* More ETD Featured Stories text on home page style */
.etd-updates article {
	--entry-background: transparent;
	--entry-box-shadow: hidden;
	color: black;
	padding-left: 0px;
}

.etd-updates a {
	margin-left: 0px;
}

.etd-updates .button-small {
	--button-font-size: 16px;
}

/* Hide read more button for hide-btn class */
.hide-btn .psacp-rdmr-btn {
    display: none !important;
}
.hide-btn .owl-dots {
	 padding-top: 0px;
}
.hide-btn .psacp-post-carousel-wrap.psacp-design-2 .psacp-post-margin-content {
	padding-bottom: 10%!important;
}
/* Post Slider */
.psacp-post-carousel-wrap .owl-item {
	margin-right: 0px;
}
.psacp-post-carousel-wrap .owl-item .psacp-post-desc, .psacp-post-carousel-wrap .owl-item .psacp-post-title {
    margin-left: 5px !important;
}
.psacp-post-carousel-wrap .owl-nav {
	top:36%!important;
}
/* Slider arrows move outside carousel */
.psacp-post-carousel-wrap .owl-nav .owl-prev {
	left: -60px;
}
.psacp-post-carousel-wrap  .owl-next, .psacp-post-carousel-wrap .owl-nav .owl-next {
	right: -50px;
}
.owl-prev, .owl-next  {
	background: transparent!important;
	border:transparent!important;
	color:white!important;
	font-size: 75px!important;
}
@media only screen and (min-width: 800px) {
	.owl-prev:hover, .owl-next:hover {
		background: transparent!important;
	border:transparent!important;
	color: #28abe3!important;
} 
	.spotlight-slider .psacp-post-carousel-wrap .owl-nav .owl-prev {
	left:-30px!important;
	padding:0px!important;
}
}
/* Show post slider arrows  mobile */
@media only screen and (max-width: 800px) {
	.owl-nav .owl-next {
		right: 0.3%!important;
  }
		.owl-nav .owl-prev {
		left: 0px!important;
		padding: 2px 15px 6px 15px!important;
  }
		.spotlight-slider .psacp-wrap .owl-next {
		right: 3%!important;
  }
		.spotlight-slider .psacp-wrap .owl-prev {
		left: 3.3%!important;
		padding: 2px 15px 6px 15px!important;
  }

	.psacp-post-carousel-wrap .owl-nav .owl-prev, .psacp-post-carousel-wrap .owl-nav .owl-next, .spotlight-slider .owl-next, .spotlight-slider .owl-prev {
		display: inline-block;
    text-align: center !important;
    background: rgba(0, 0, 0, 0.5)!important;
    line-height: normal !important;
    font-size: 25px;
    padding: 2px 15px 4px 15px !important;
    border-radius: 0px;
    box-shadow: none;
	}
}
/* Next/prev arrows for division pages */
.division-stories .owl-prev, .division-stories .owl-next {
		color:black!important;
}
/* Next/prev arrows when disabled, then hide */
.owl-nav .disabled {
	color:white;
	display:none!important;
}
/* Make text color white on Home page */
.etd-updates-slider .psacp-post-slide, .etd-updates-slider .psacp-post-slide a {
	color:white!important;
}
 .psacp-post-carousel-wrap .psacp-post-title a {
	pointer-events: none;
	color: white;
} 
.psacp-post-carousel-wrap  .psacp-post-img-bg img {
    height: 250px;
	object-fit: cover;
}


.owl-dots {
	padding-top: 40px;
}
.psacp-post-carousel-wrap .owl-dots .owl-dot {
	background: #03a9f5;
	opacity: .5;
	width: 20px!important;
	height:20px!important;
	margin-right:10px;
}

/* Help read more align to bottom */
.owl-stage {
	position:relative!important;
	display: flex!important;
}
/* Read more button */
.psacp-rdmr-btn, .spotlight-slider .psacp-rdmr-btn {
	z-index: 1;
	position:absolute;
	bottom:0;
	margin-top:auto;
	text-align:bottom;
	background: var(--button-background,var(--color-primary));
	color: white;
	font-size:16px;
	padding: var(--button-small-padding,0.75rem 1.25rem);;
	border: none!important;
  border-radius: var(--button-border-radius,var(--border-radius));
	line-height: var(--button-line-height,1.1);
    letter-spacing: var(--button-letter-spacing,normal);
	    font-family: var(--button-font-family,var(--body-font-family));
	font-weight: var(--button-font-weight,var(--body-font-weight));
}
.psacp-rdmr-btn:hover, .spotlight-slider .psacp-rdmr-btn:hover {
    background: #0594cc;
}
.spotlight-slider .owl-stage {
		margin-left:15px;
	margin-right:15px;
}
/** 
 *  OUTGASSING DATABASE CSS CLASSES
*/

/* NASA Outgassing Table Styles */
.nasa-filters-form .control-group label {
	white-space: nowrap; 
	padding-right: 10px;
}
#nasa-table-container {
    font-family: Arial, sans-serif;
}

/* Filter Form Styles */
.nasa-filters-form {
    background: #f8f9fa;
    padding: 25px;
    margin-bottom: 20px;
    border-radius: 8px;
}

.nasa-filters-form h3 {
    margin-top: 0;
    color: #0073aa;
}

/* Filter Grid */
.filters-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 20px;
    margin-bottom: 20px;
}

/* Filter Fieldsets */
.filter-fieldset {
    border: 1px solid #ddd;
    padding: 15px;
    border-radius: 5px;
}

.filter-fieldset legend {
    font-weight: bold;
    color: #0073aa;
}

/* Filter Inputs */
.filter-input, .filter-select {
    width: 100%;
    padding: 8px;
    margin-bottom: 10px;
    border: 1px solid #ddd;
    border-radius: 4px;
}

.filter-select {
    padding: 5px;
}

/* Range Inputs */
.range-inputs {
    display: none;
    margin-top: 10px;
}

.range-input {
    width: 48%;
    padding: 8px;
    border: 1px solid #ddd;
    border-radius: 4px;
}

/* Category Select Styles */
.category-select {
    width: 100%;
    height: 120px;
    padding: 5px;
    border: 1px solid #ddd;
    border-radius: 4px;
    font-size: 14px;
}

.category-select option {
    padding: 3px 5px;
}

.help-text {
    display: block;
    color: #666;
    font-size: 12px;
    margin-top: 5px;
    font-style: italic;
}

/* Make category fieldset slightly larger */
.filter-fieldset:has(.category-select) {
    min-height: 180px;
}

/* Controls */
.controls-wrapper {
    display: flex;
    gap: 15px;
    align-items: center;
    flex-wrap: wrap;
    justify-content: space-between;
}

.controls-left {
    display: flex;
    gap: 15px;
    align-items: center;
    flex-wrap: wrap;
}

.control-group {
    display: flex;
    align-items: center;
    gap: 5px;
}

.control-group label {
    font-weight: bold;
}

.control-select {
    padding: 5px;
    border: 1px solid #ddd;
    border-radius: 4px;
}

.controls-right {
    display: flex;
    gap: 10px;
}

/* Buttons */
.btn-primary {
    background: #0073aa;
    color: white;
    padding: 10px 20px;
    border: none;
    border-radius: 4px;
    cursor: pointer;
}

.btn-secondary {
    background: #666;
    color: white;
    padding: 10px 15px;
    border: none;
    border-radius: 4px;
    cursor: pointer;
}

.btn-primary:hover {
    background: #005a87;
}

.btn-secondary:hover {
    background: #555;
}

/* Loading Spinner */
.loading-spinner {
    text-align: center;
    padding: 40px;
    display: none;
}

.spinner {
    display: inline-block;
    width: 30px;
    height: 30px;
    border: 3px solid #f3f3f3;
    border-top: 3px solid #0073aa;
    border-radius: 50%;
    animation: spin 1s linear infinite;
}

@keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
}

/* Results Info */
.results-info {
    margin-bottom: 15px;
    font-weight: bold;
    color: #666;
}

/* Table container with dual scrollbars */
.table-container {
    position: relative;
}

/* Top scrollbar styling */
.top-scroll {
    overflow-x: auto;
    overflow-y: hidden;
    margin-bottom: 1px;
    height: 17px;
    background: #f8f9fa;
    border: 1px solid #ddd;
    border-bottom: none;
    display: none; /* Hidden by default, shown when needed */
}

.top-scroll::-webkit-scrollbar {
    height: 12px;
}

.top-scroll::-webkit-scrollbar-track {
    background: #f1f1f1;
}

.top-scroll::-webkit-scrollbar-thumb {
    background: #888;
    border-radius: 6px;
}

.top-scroll::-webkit-scrollbar-thumb:hover {
    background: #555;
}

/* Top scroll content */
#top-scroll-content {
    height: 1px;
    background: transparent;
}

/* Table wrapper - HORIZONTAL SCROLL ONLY */
.table-wrapper {
    overflow-x: auto;
    overflow-y: visible; /* Allow natural vertical flow */
    border: 1px solid #ddd;
    position: relative;
    /* Removed max-height to allow full table display */
}

/* Table styling */
.outgassing-table {
    width: 100%;
    border-collapse: collapse;
    background: white;
	margin: 0px;
}

/* Column headers - NO WRAP */
.outgassing-table th {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    background: #0073aa;
    color: white;
    font-weight: bold;
    padding: 8px 12px;
    border: 1px solid #ddd;
    text-align: left;
    font-size: 13px;
}

/* Table cells - ALLOW WRAP */
.outgassing-table td {
    padding: 8px 12px;
    border: 1px solid #ddd;
    text-align: left;
    font-size: 13px;
    /* No white-space: nowrap here - cells can wrap */
}

.outgassing-table tr:nth-child(even) {
    background: #f9f9f9;
}

/* Pagination */
.pagination-wrapper {
    text-align: center;
    margin-top: 20px;
}

.pagination-info {
    margin-bottom: 10px;
    font-weight: bold;
    color: #666;
}

.pagination-buttons {
    display: inline-block;
}

.pagination-btn {
    padding: 6px 12px;
    margin: 0 2px;
    background: #0073aa;
    color: white;
    border: none;
    border-radius: 3px;
    cursor: pointer;
}

.pagination-btn:hover {
    background: #005a87;
}

.pagination-btn.active {
    background: #005a87;
    font-weight: bold;
}

/* Error Messages */
.error-message {
    padding: 20px;
    color: red;
    background: #ffe6e6;
    border: 1px solid #ff9999;
    border-radius: 4px;
    margin: 10px 0;
}

/* Responsive Design */
@media (max-width: 768px) {
    .filters-grid {
        grid-template-columns: 1fr;
    }
    
    .controls-wrapper {
        flex-direction: column;
        align-items: stretch;
    }
    
    .controls-left {
        justify-content: center;
        margin-bottom: 15px;
    }
    
    .controls-right {
        justify-content: center;
    }
    
    .nasa-filters-form {
        padding: 15px;
    }
}

@media (max-width: 480px) {
    .control-group {
        flex-direction: column;
        align-items: stretch;
        gap: 2px;
    }
    
    .controls-left {
        flex-direction: column;
        gap: 10px;        
			align-items: flex-start;
    }
    
    .outgassing-table th,
    .outgassing-table td {
        padding: 6px 8px;
        font-size: 12px;
    }
	.filters-grid {
		margin-bottom:0px;
	}
}
/** 
 *  FONT CUSTOMIZATION CSS CLASSES
*/
/* Make font 16 for image captions */
.wp-element-caption {
	  font-size: 14px !important;
	  text-align: left !important;
}

.button {
	font-size: 16px!important;
}
/* Make text bold */
.bold-text {
  font-weight: bold;
}

/* Make link gold */
.gold-link a {
  color: var(--link-color, #deaf48);
}

.global-font-size {
	font-size: 16px !important;
}

cite {
	font-size: 16px !important;
}

.menu {
	font-size: 16px;
}
/** 
 *  FOOTER CSS CLASSES
*/
	footer .footer-padding {
		margin-left:var(--spacing-xl);	
		margin-right:var(--spacing-xl);
	}
@media only screen and (max-width: 800px) {
		footer .footer-padding {
		margin-left:0px;	
		margin-right:0px;
	}
}
/* Make about section text span sider on mobile */
@media only screen and (max-width: 400px) {
  footer .has-lg-padding-right {
    padding-right: 0px;
  }
}
/* Live button for NASA+  
*/
.nasa-plus a:after {
    border: 1px solid #f64137;
    border-radius: 2px;
    content: 'Live';
    display: inline-block !important;
    font-size: .65em;
    font-family: "DM Mono", monospace;
    font-weight: 500;
    letter-spacing: .1em;
    line-height: 1;
    margin-inline-start: .5em;
    margin-block-start: -.1em;
    padding: .2em .3em;
    text-transform: uppercase;
    vertical-align: middle;
	 color:white;
}
.nasa-plus a:hover::after {
    background-color: #b60109;
	  color:white;
}
/* Add padding between Explore ETD and NASA.gov */
@media only screen and (min-width: 400px) {
.footer-explore-etd {
	padding-left: var(--padding-left-sm, var(--padding-sm));
}
}
/* Add padding top each column in mobile */
@media only screen and (max-width: 800px) {
.footer-columns .last-child  {
	padding-bottom: 25px!important; 
}
}
/* Footer social media icons*/
.wp-block-social-links .wp-block-social-link.wp-social-link .wp-block-social-link-anchor, .wp-block-social-links .wp-block-social-link.wp-social-link .wp-block-social-link-anchor svg, .wp-block-social-links .wp-block-social-link.wp-social-link .wp-block-social-link-anchor:active, .wp-block-social-links .wp-block-social-link.wp-social-link .wp-block-social-link-anchor:hover, .wp-block-social-links .wp-block-social-link.wp-social-link .wp-block-social-link-anchor:visited {
    fill: white;
}
.wp-block-social-link-anchor {
	background-color: #2e2e32; 
	border-radius: 50%;
	width: 32px;
	height: 32px;
}
.wp-block-social-links:not(.is-style-logos-only) .wp-social-link-youtube,  .wp-block-social-links:not(.is-style-logos-only) .wp-social-link-facebook, .wp-block-social-links:not(.is-style-logos-only) .wp-social-link-flickr, .wp-block-social-links:not(.is-style-logos-only) .wp-social-link-instagram, .wp-block-social-links:not(.is-style-logos-only) .wp-social-link-x {
	background-color:black;
}
.wp-block-social-links .wp-block-social-link.wp-social-link .wp-block-social-link-anchor:hover {
   background-color: #58585b;
}
.wp-block-social-link:hover {
    transform: none;
}

/* Makes footer wider */
@media (min-width:900px) {
.site-footer .etd-link-footer {
	justify-content:left;
	padding-left: 0px;
	padding-right: 0px;
}
	.site-footer .etd-link-footer .wp-block-group__inner-container {
		max-width: none;
	}
}
/* Page Last Updated */
.footer-credit-date-names p {
	margin-right: 30px;
	color: #e0dfdf;
}
.footer-credit-date-names {
	gap: 10px!important;
}
.footer-last-updated-date {
	font-size: 14px;
	    margin: var(--paragraph-margin, 0 0 var(--paragraph-margin-bottom, var(--spacing-md)));
	color: #e0dfdf;
	padding-left: 10px;
}
@media only screen and (min-width: 300px) {
  .footer-last-updated-date {
    padding-left: 0px;
  }
}
/** Footer links*/
.etd-link-footer a {
  text-decoration: none;
  color: #e0dfdf;
}
.etd-link-footer a:hover {
  color: #28abe3;
  --menu-item-name-filter-hover: none;
  --link-filter-hover: none;
}

/** * Removes white space between last block of the page and footer */
.content-sidebar-wrap {
  margin-bottom: 0px;
}

/* Make footer line wider */
.footer-line .wp-block-separator:not(.is-style-wide):not(.is-style-dots) {
  max-width: 100%;
}

/* Make footer line thinner */
.footer-line hr {
  height: 1px !important;
}
/* Makes footer credits span next line after nasa logo in tablet/mobile */
@media (max-width:900px) {
		.footer-credit-date-names p {
		display: block;
    width: 100%;
	}
}
/* Fix footer credits in mobile, make image not cut off and remove extra space between links */
@media (max-width:500px) {
	.site-footer img {
		object-fit: scale-down!important;
	} 
.site-footer	.footer-credits div {
	gap:0px;
	margin-right: 5px;
	padding-right: 0px;
justify-content: left;
}
	.site-footer .footer-credits p {
		padding-right: 10px;
	}
}
	.site-footer .footer-credits  {
		justify-content: space-between;
	}

.dark-caption {
	color: darkgray;
}

/* Static Featured Content Block - ISAM Projects and Capabilties */
/* Supports longer width isam menu */
.header-right .two-column-menu .sub-menu {
    width: 350%!important;
}
.static-featured-content h5 {
	font-size: 24px;
	line-height: 28px;
}
.static-featured-content img {
	    width: 100% !important;
    height: 250px !important;
    margin-bottom: 15px;
    object-fit: cover;
}
/* Make learn more button float to the bottom*/
.static-featured-content .wp-block-buttons  {
    margin-top: auto;
	padding-top: 20px;
}

.static-featured-content .wp-block-group.eplus-wrapper {
  display: flex;
  flex-direction: column;
  flex: 1; /* Fill available height */
}

.static-featured-content .wp-block-group__inner-container {
  display: flex;
  flex-direction: column;
  flex: 1; /* Important: fill vertical space */
  min-height: 0;
}


