}

.key-personnel-padding-top {
	padding-top: 26px;
}

.key-personnel-padding-bottom {
	padding-bottom: 80px;
}

/* Hide search labels */
.page-id-6526 label {
	display: none;
}

/* Style for table headers */
.key-personnel-table th {
	background-color: transparent!important;
	border-right: none!important;
	border-left: none!important;
}
/* Style for non directors, chiefs, and heads */
table.abcfsltDtTbl tbody tr, table.abcfsltDtTbl tbody td {
	background-color: transparent;
	color: white;
	border-right: none!important;
	border-left: none!important;
