<script id="page-transitions-js-js-after">
document.addEventListener('DOMContentLoaded', function() {
        const container = document.querySelector('.site-container');
        if (container) {
            // Start with a fade-in effect on initial load
            container.classList.add('page-transition-in');
        }
    });

    document.addEventListener('click', function(event) {
        const link = event.target.closest('a');
        if (link && link.href.startsWith('mailto:')) {
            // Prevent fade-out for mailto links
            event.preventDefault();
            window.location.href = link.href;
        }
    });

    window.addEventListener('beforeunload', function(event) {
        const container = document.querySelector('.site-container');
        if (container) {
            // Check if the navigation is to a mailto link
            const activeElement = document.activeElement;
            if (activeElement && activeElement.tagName === 'A' && activeElement.href.startsWith('mailto:')) {
                return; // Don't apply fade-out for mailto links
            }
            
            // Fade to black when navigating away
            container.classList.remove('page-transition-in');
            container.classList.add('page-transition-out');
        }
    });

    window.addEventListener('pageshow', function(event) {
        const container = document.querySelector('.site-container');
        if (container) {
            // Ensure fade-out class is removed before adding fade-in class
            container.classList.remove('page-transition-out');

            // Add a slight delay before applying the fade-in effect
            setTimeout(function() {
                container.classList.add('page-transition-in');
            }, 50); // Adjust this delay if necessary
        }
    });
    
//# sourceURL=page-transitions-js-js-after
</script>
