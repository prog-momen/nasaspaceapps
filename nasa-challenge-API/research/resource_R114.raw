        <script>
        jQuery(document).ready(function($) {
            // The search box is the input under the label within the div with class "dataTables_filter"
            var searchBoxSelector = "#abcfsltTbl_7649_filter input[type=search]";
            var userInteracted = false;

            // Function to populate the search box and trigger keyup event
            function populateSearchBox(searchNumber) {
                var searchBox = $(searchBoxSelector);
                // Only populate the search box if the user has not interacted with it
                if (!userInteracted) {
                    searchBox.val(searchNumber).trigger("keyup");
                }
            }

            // Initialize DataTables
            var table = $("#abcfsltTbl_7649").DataTable();

            // Set the value of the searchNumber parameter to the search textbox
            populateSearchBox("");

            // Listen for user interaction with the search box, do not repopulate with search number
            $(searchBoxSelector).on("input", function() {
                userInteracted = true;
            });
        });
    </script>    <script>
    //console.log('Secondary menu script loaded'); // Log to confirm script is loaded

    document.addEventListener('DOMContentLoaded', function() {
        // Add a timeout to delay execution for 200ms
        setTimeout(function() {
            // Select all <li> elements with class 'secondary-menu' inside the 'mobile-menu' container
            const menuItems = document.querySelectorAll('.nav-after-header .secondary-menu');

            //console.log('Menu items found:', menuItems.length);  // Log number of menu items found

            // Check if we successfully found any <li> elements
            if (menuItems.length !== 0) {
                //console.log('Secondary menu items:', menuItems); // Log the actual menu items

                // Create the header spacer element
                const spacer = document.createElement('span');
                // Log creation of spacer
                //console.log('Created spacer element:', spacer);

                // Create the dropdown menu container
                const wrapper = document.createElement('div');
                wrapper.classList.add('secondary-menu-wrapper');
                wrapper.setAttribute('aria-label', 'Secondary Mobile Menu');
               // console.log('Created wrapper for dropdown:', wrapper);

                // Create the container for the text and the button
                const textButtonContainer = document.createElement('div');
                textButtonContainer.classList.add('secondary-menu-text-button-container');
                //console.log('Created text-button container:', textButtonContainer);

                // Get the text of the first menu item for the button text
                const firstMenuItemText = menuItems[0].querySelector('a').innerText;
                //console.log('First menu item text:', firstMenuItemText);

                // Create the toggle button (includes text and SVG)
                const button = document.createElement('button');
                button.classList.add('secondary-menu-toggle');
                button.setAttribute('aria-expanded', 'false');
                //console.log('Created button:', button);

                // Create the text element with the first menu item text
                const textElement = document.createElement('span');
                textElement.classList.add('secondary-menu-text');
                textElement.innerText = firstMenuItemText; // Set the text to the first item text

                // Create the SVG icon
                const svgIcon = `
                    <svg width="16" height="16" alt="" enable-background="new 0 0 400 400" viewBox="0 0 400 400" xmlns="http://www.w3.org/2000/svg">
                        <path d="m4.2 122.2 195.1 195.1 196.5-196.6-37.9-38-157.8 157.8-156.8-156.8z"></path>
                    </svg>
                `;
                // Add the text and SVG to the button
                button.innerHTML = textElement.outerHTML + svgIcon;

                // Append the button to the wrapper
                wrapper.appendChild(button);
                //console.log('Appended button to wrapper:', wrapper);

                // Create the menu list
                const ul = document.createElement('ul');
                ul.classList.add('secondary-menu-dropdown');
                //console.log('Created <ul> for menu:', ul);

                // Loop through the menu items and append them to the dropdown
                menuItems.forEach(function(item) {
                    const li = document.createElement('li');
                    li.classList.add(...item.classList); // Add classes of the <li> item
                    const a = document.createElement('a');
                    a.href = item.querySelector('a').href;
                    a.innerText = item.querySelector('a').innerText;
                    li.appendChild(a);
                    ul.appendChild(li);
                    //console.log('Added <li> to <ul>:', li);
                });

                // Append the <ul> to the wrapper
                wrapper.appendChild(ul);
                //console.log('Appended <ul> to wrapper:', ul);

                // Find the .mobile-menu element
                const header = document.querySelector('.mobile-menu');
                //console.log('Found mobile menu header:', header);

                // Check if the .mobile-menu exists
                if (header) {
                    // Insert the header spacer before the wrapper
                    header.insertAdjacentElement('afterend', spacer);
                    // Insert the secondary menu after the header spacer
                    spacer.insertAdjacentElement('afterend', wrapper);
                    //console.log('Inserted spacer and wrapper into DOM');
                } else {
                   // console.log('No mobile menu found on this page.');
                }

                // Toggle dropdown functionality when the button is clicked
                button.addEventListener('click', function() {
                    ul.classList.toggle('open');
                    button.setAttribute('aria-expanded', ul.classList.contains('open') ? 'true' : 'false');
                    // Toggle the rotate class on the button to rotate the SVG
                    button.classList.toggle('open');
                    //console.log('Dropdown toggled:', ul.classList.contains('open') ? 'Open' : 'Closed');
                });

                // Toggle dropdown functionality when the first menu item is clicked
                const firstMenuItemLink = menuItems[0].querySelector('a');
                if (firstMenuItemLink) {
                    firstMenuItemLink.addEventListener('click', function(event) {
                        ul.classList.toggle('open');
                        button.setAttribute('aria-expanded', ul.classList.contains('open') ? 'true' : 'false');
                        button.classList.toggle('open'); // Toggle the rotation on click
                        //console.log('First menu item clicked, dropdown toggled.');
                    });
                }
            } else {
               // console.log('No secondary menu items found on this page.');
            }
        }, 200); // Delay of 200ms to ensure elements are ready
    });
    </script>
