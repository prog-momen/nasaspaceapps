/** 
 *  KEY PERSONNEL PAGE CSS CLASSES
*/
/* Mobile */
@media screen and (min-width: 320px) {
/* Make export buttons full width */
	.abcfsltDTBtns .buttons-pdf, .abcfsltDTBtns .buttons-csv, .abcfsltDTBtns .buttons-excel, .buttons-org-chart, .abcfsltDTBtns .buttons-download-org-chart {
		width: 100%;
		margin-bottom: 10px;
		margin-left: 0px;
	}

	#abcfsltTbl_7649_filter label {
		width: 100%;
		padding-right: 10px;
		text-align: center;
	}

	#abcfsltTbl_7649_filter input {
		width: 100%;
	}

	div.abcfsltDtTblWraper .dataTables_filter {
		width: 100%;
	}
}
/* Tablet view */
@media screen and (min-width: 641px) {
	/* Make filters same line as buttons */
	.abcfsltDTBtns .buttons-pdf, .abcfsltDTBtns .buttons-csv, .abcfsltDTBtns .buttons-excel {
		width: 14%;
		margin-bottom: 0px;
	}

	.abcfsltDTBtns .buttons-org-chart {
		width: var(--button-width,auto);
	}

	.abcfsltDTBtns .buttons-download-org-chart {
		width: var(--button-width,auto);
		margin-left: 0.8rem;
	}

	#abcfsltTbl_7649_filter label {
		width: 100%;
		padding-right: 0px;
		text-align: right;
		float: right;
		display: table-cell;
	}

	#abcfsltTbl_7649_filter input {
		width: 60%;
		display: inline;
	}

	div.abcfsltDtTblWraper .dataTables_filter {
		width: 45%;
		float: right;
		margin-top: 0px;
	}

	.abcfsltDTBtns {
		width: 100%;
	}
}
/* Desktop view */
@media screen and (min-width: 961px) {
	/* Make filters same line as buttons */
	.abcfsltDTBtns .buttons-pdf, .abcfsltDTBtns .buttons-csv, .abcfsltDTBtns .buttons-excel {
		width: 8%;
	}

	.abcfsltDTBtns .buttons-org-chart {
		width: var(--button-width,auto);
	}

	#abcfsltTbl_7649_filter label {
		width: 600px;
		margin-left: 10px;
	}
}

/* Style for table buttons*/
button.dt-button, button.abcfsltDTBtn, button.abcfsltDTBtnPrint, .abcfslFrmGroup button {
	font-size: 16px!important;
	background: var(--button-background,var(--color-primary))!important;
	color: white!important;
	padding: var(--button-small-padding,0.75rem 1.25rem);
	border: none!important;
	border-radius: var(--button-border-radius,var(--border-radius));
}
/* Search label */
#abcfsltTbl_7649_filter label {
	color: white;
	font-size: 16px;
}
/* Text inside search textbox */
#abcfsltTbl_7649_filter input {
	font-size: 16px;
}

/* Height of textbox */
#abcfsltTbl_7649_filter input {
	height: 2.5rem!important;
}
/* Highlight search */ 
table.abcfsltDtTbl span.highlight {
	background-color: rgba(255, 255, 255, 0.3)!important;
	color: white;
}
/* Buttons on hover */
button.dt-button:hover, button.abcfsltDTBtn:hover button.abcfsltDTBtnPrint:hover, button.abcfslFrmGroup:hover {
	background: var(--button-background-hover,var(--color-primary-dark,var(--button-background,var(--color-primary))))!important;
}
/* Hide field about whether member is director, chief, or head */
.highlight-job {
	display: none;
}

/* Table style for directors, chiefs, or heads */
td.highlight-job:not(:empty) {
	color: white;
}

/* Style sibling td elements to inherit text color and thick border top */
td.highlight-job:not(:empty) ~ td {
	border-top-width: 4px!important;
	border-color: white!important;
	color: white!important;
}
/* Adds thick white top border to members who are chief, heads, or directors for collapsible icon column. DOES NOT WORK IN FIREFOX */
tr:has(td.highlight-job:not(:empty)) td {
	border-top-width: 4px!important;
	border-color: white!important;
	color: white!important;
}

/* Style of row when hovered */
table.abcfsltDtTbl.hover tbody tr:hover td, table.abcfsltDtTbl.hover tbody tr.odd:hover td {
	background-color: #48b4de36!important;
}
/* Emails should be on same line */
.table-phone-width {
	width: 8%;
}
/* Emails should be on same line */
.table-no-break a {
	word-break: keep-all;
}

.dtr-title {
	padding-right: 5px;
}
/*
.staff-name {
	font-size: 18px;
} 
*/
.staff-job {
	font-size: 16px;
}
/* Make key personnel tables code width smaller */
@media only screen and (min-width: 1200px) {
 
	.table-org-width {
		width: 15%;
	}

	.table-division-width {
		width: 15%;
	}

	.table-position-width {
