/** 
 *  MAIN NAVIGATION CSS CLASSES
*/
/* NAV BANNER 
 * Uncomment class to remove banner*/
.nav-banner {
	display:none;
}
body .nav-banner div, body .nav-banner p  {
	color:white!important;
}  {
	color:white!important;
}
body:has(.show-nav-banner) .nav-banner  {
	display: block!important;
}
/* Allow main navigation menu dropdown items to be split in two columns */
.header-right .two-column-menu .sub-menu {
	width:300%;
  display: grid!important;
  grid-template-columns: 1fr 1fr; /* Two equal columns */
  grid-template-rows: auto; /* Automatic row height */
  list-style: none;
  padding: 0;

}
.header-right .two-column-menu .sub-menu .menu-arrow, .header-right .two-column-menu .sub-menu .menu-left {
  grid-column: 1;
	font-weight: bold;
  font-size: 17px;
  width: 100%;
}

.header-right .two-column-menu .sub-menu li {
  grid-column: 2;
}
/* Adds horizontal line splitting two column menu into rows/sections */
.header-right .two-column-menu .sub-menu .menu-line-above::before {
	position:absolute;
	width:190%;
	bottom: 45%;
}
.header-right .padding-top-30 {
	padding-top: 30px;
}
.header-right .padding-bottom-30  {
	 padding-bottom: 20px;
}

/* Makes Capabilities sub menu wider*/
.header-right .capabilities .sub-menu {
	width: 180%;
}
/* Adds gold arrow to menu item with class "menu-arrow" */
.menu-arrow a {
	font-weight: bold;
	padding-bottom: 25px;
	font-size:17px;
	width: 100%;
}

.menu-arrow a::after {
    content: '';
    display: flex;
    position: relative;
    width: 22px; /* Adjust width for your icon size */
    height: 22px; /* Adjust height for your icon size */
    background-color: #deaf48; /* Circle background color (similar to fa-circle) */
    border-radius: 50%; /* Make it round like the fa-circle */
    font-family: 'Font Awesome 6 Free';
    font-weight: 900; /* Ensure it uses solid icons */
    text-align: center;
    line-height: 24px; /* Vertically center the icon */
    color: black; 
		margin-left: 10px;
}

.menu-arrow a::after {
	  content: '\f061';
			margin-left: 10px;
    font-size: 16px; 
    position: relative;
    transform-origin: center center; 
    display: flex;
    align-items: center;
    justify-content: center;
	transition: background-color 0.9s ease, color 0.5s ease; 
}
.menu-arrow:hover a::after { 
	background-color:#8e702d;
}

/* Makes all sub menu items not bold */
.sub-menu {
	font-weight: normal;
}
/* Add line above menu item that has class "menu-line-above" */
.menu-line-above::before {
	border-top: 1px solid grey;
	width: 90%;
	margin-left: 10px;
	 content: ''; /* Required for the ::before to be displayed */
   display: block; 
	padding-top: 25px; 
	margin-top: 25px;
}
.menu-line-above a {
	flex:auto;
}
/* Makes the search form the last item in the menu, after secondary menu in tablet and mobile view */
.mobile-menu .navbar-search {
	order:10!important;
}

/* CSS Classes for Flight Projects in Development and Operations 
@media only screen and (min-width: 900px) {

.in-development-menu a { 
    display: block;
}
.in-development-menu span { 
    display: none;
}
.in-development-menu a::before {
    content: "Flight Projects";
    display: block;
}
.in-development-menu a::after {
    content: "In Development";
    display: block;
}
.in-operations-menu a { 
    display: block;
}
.in-operations-menu span { 
    display: none;
}
.in-operations-menu a::before {
    content: "Flight Projects";
    display: block;
}
.in-operations-menu a::after {
    content: "In Operations";
    display: block;
}
}
*/
/* Hide Navigation, show mobile menu on certain width
@media(max-width:1200px) {
	:root {
		--header-section-display:none;
		--header-section-mobile-display:flex;
		
	}
	#nav-after-header {
		display:none;
	}
} */

.menu-item-last .sub-menu {
	right: 5px;
}
.site-header-wrap { 
	max-width: none;
}
/* For division links not ready for release */
.inactive-link {
	pointer-events: none;
	color: grey;
}
.inactive-link .menu-item-link {
	color: grey;
}
/* Division sub-menu item arrows */
.menu-item .menu-item-has-children:nth-child(odd)>a:after {
	width: 9%;
  height: 15%;
}
.menu-item .menu-item-has-children:nth-child(even)>a:after {
	width: 8%;
  height: 15%;
}

.menu-item .menu-item-has-children:nth-child(even)>a:after, .menu-item .menu-item-has-children:nth-child(odd)>a:after  {
	border:none;
}
/* Add arrow for sub child nav menu items */
.sub-nav-arrow.menu-item-has-children .sub-menu span {
	width: 100%;
	justify-content:left;
}
@media only screen and (min-width: 800px) {
    body .sub-menu .sub-menu {
        left: var(--sub-sub-menu-left, auto);
        right: none;
    }
}
body .sub-nav-arrow.menu-item-has-children .sub-menu a:after {
	display: none;
}
body .sub-nav-arrow a:after {
    content: '\003C';
    border: none;
    transform: rotate(180deg)!important;
    font-size: 18px;
    right: 20px;
}
/* Make division arrow nav items vertically centered*/
.menu-item {
    align-items: center; 
}
/* Keep same width and height for Community child menu arrows */
.menu-item-last .menu-item-has-children>a:after {
	  width: 6px!important;
    height: 6px!important;
}
/* Make child item float left not in mobile/tablet mode */
@media only screen and (min-width: 800px) {
	.sub-menu .sub-menu {
		left: unset;
    right: var(--sub-sub-menu-left,auto);
    white-space: var(--sub-sub-menu-white-space,normal);
    top: 50%;
    transform: translateY(-50%);
}
}

/** * Nav links*/
.site-header a:hover {
  color: #28abe3;
  --menu-item-name-filter-hover: none;
  --link-filter-hover: none;
}
/** * Nav sub menu*/
.sub-menu {
  background: black;
}
/** * Nav sub links*/
.menu-item-link {
  color: white;
}

/* Makes active link blue in nav menu*/
.menu-item-link-current {
  color: #28abe3;
}

/* Removes darken hue on links in nav menu*/
.site-header-wrap span {
  --link-filter-hover: none;
  --entry-title-link-color-hover: none;
  --menu-item-name-filter-hover: none;
}

/* Adds padding to top nav menu links */
.menu-padding {
  padding-top: 8px;
}
/** 
 *  SECONDARY NAVIGATION CSS CLASSES
*/
/*
 *  Classes for sub menu items in secondary navigation 
 * 
 * */
/* Removes caret icon in secondary menu */
.secondary-menu-wrapper .menu-item-has-children>a:after {
	display:none;
}
/* Makes parent of dropdown in secondary menu inactive */
.secondary-menu-wrapper .secondary-parent {
	pointer-events:none;
}
/* Makes child of dropdown in secondary menu indented */
.secondary-menu-wrapper .secondary-sub-item a {
	margin-left:30px;
} 
/* Secondary Menu in Mobile */
.header-spacer.secondary {
	height:0px!important;
}
/* Hide secondary menu items in main naivgation menu in mobile */
.mobile-menu .secondary-menu.mobile-menu-item {
	opacity:0;
	height:0px;
	pointer-events:none;
}
 
/* Hide menu item */
.hide-menu-item {
	opacity:0;
	width:0px;
	height:0px;
	pointer-events:none;
}
/* Show the secondary menu by default on mobile */
@media only screen and (min-width: 1000px) { 
	.secondary-menu-wrapper {
		display:none;
	}
}
.secondary-nav-title-padding {
	margin-top: 0px!important;
}
/* Add extra padding on top for post pages with secondary mobile menu so text is not covered by menu. Also adds extra padding to page header with class "secondary-nav-title-padding" */
@media only screen and (max-width: 1000px) { 
	body:has(.secondary-menu-wrapper) .post-title, 	body:has(.secondary-menu-wrapper) .secondary-nav-title-padding {
		padding-top:45px!important;
	}
	
}
.secondary-menu-wrapper { 
	position:absolute; 
	width:100%;
	z-index:-10;
	margin-bottom:20px;
}
	
/* Initially hide the mobile dropdown */
.secondary-menu-dropdown {
    opacity: 0;
	display:none;/* Start with the menu invisible */
    visibility: hidden; 
    transition: opacity 0.3s ease, visibility 0s 0.3s; 
	margin:0px;
	padding-bottom:15px;
	background-color: #1b1b1b;
} 
.secondary-menu-dropdown {
	padding-top:10px;
}
/* Add space to left of secondary mobile menu items*/
.secondary-menu-dropdown .secondary-menu  {
	padding-left: 15px;
	margin-top:0px;
}
/* Style of secondary mobile menu items when active*/
.secondary-menu-dropdown .secondary-menu a:hover  {
	background-color:transparent;
}
/* Show the mobile dropdown when the 'open' class is added */
.secondary-menu-dropdown.open {
   opacity: 1; 
    visibility: visible;
    transition: opacity 0.3s ease, visibility 0s 0s; 
	display:block;
}
/*Secondary mobile menu toggle arrow */
.secondary-menu-toggle svg {
	fill:#ffffff;
	transition: all .3s ease;
}
/* Active secondary mobile menu toggle arrow - adds animation*/
.secondary-menu-toggle.open svg {
    transform: rotate(180deg);
} 
.hide-menu-item.secondary-menu a {
	display:none;
}
/* Style for the mobile secondary menu toggle/dropdown button */
.secondary-menu-toggle, .secondary-menu-toggle:hover, .secondary-menu-toggle:focus, .secondary-menu-toggle:active {
    color: white;
    border: none;
    padding: 20px;
    cursor: pointer;
		width:100%; 
	 background-color: #1b1b1b;
	justify-content: space-between;
}
/* Make dropdown text align left */ 
.secondary-menu-text {
	flex-grow:1;
	text-align:left;
}
/* Optional: Add a little spacing between the menu items */
.secondary-menu-dropdown li {
    margin: 10px 0;
}

/* Style the links in the dropdown */
.secondary-menu-dropdown li a {
    color: #fff;
    text-decoration: none;
    padding: 5px;
}

.secondary-menu-dropdown li a:hover {
    background-color: #444;
}
/* On hover color for main menu if page has secondary nav menu*/
.site-container:has(.nav-after-header) header a:hover {
  color: #28abe3!important;
}

/* Child nav in main nav makes parent nav active */
.site-header .current-menu-ancestor > a {
    color: #28abe3!important;  
}
/* Make secondary nav different colors on sticky and default */
#nav-after-header {
		background: var(--secondary-nav-color,var(--color-secondary));
}
/* If page has secondary nav menu, make all menu items NOT active in main nav menu */
.site-container:has(.nav-after-header) header a {
  color: white!important;
	--menu-item-name-filter-hover:none!important;
}

.site-container:has(.nav-after-header) header a:hover {
  color: #28abe3!important;
}

/* Make meny centered */
.nav-after-header ul {
	justify-content:center;
}
.nav-after-header .menu-item span {
	padding-right: 25px;
}
/* Make secondary nav different colors on sticky and default */
#nav-after-header {
		background: var(--secondary-nav-color,var(--color-secondary));
}
/* Makes Second Nav Sticky */
@media(min-width:1200px) {
#nav-after-header {
	  position: sticky;
    top: calc(var(--admin-height, 0px) + 89px);
}
}
/* Transparent Secondary Nav Menu Color */
.has-sticky-header:not(.header-stuck) {
    --secondary-nav-color:#5396c55c!important;
}
/* Solid Secondary Nav Menu Color */
.has-sticky-header {
    --secondary-nav-color:#212121!important;
}
/* Our Work Secondary Nav Menu */
.page-id-115.has-sticky-header:not(.header-stuck) .menu-item-link-current {
    color: #2bbdfb;
}
.page-id-115.has-sticky-header:not(.header-stuck) {
    --secondary-nav-color: #1644645c !important;
}
/* Make second nav move down if admin bar exists */
.admin-bar {
	--admin-height: 32px;
}
/* Posts pages and cFS posts archive pages secondary header color - black */
body:not(:has(div.mobile-header)):not(:has(div.slider-header)) #nav-after-header {
    background: #212121;
}

/** 
 *  HEADERS CSS CLASSES
*/
/* Integrated Design Center Header - Add gradient overlay */
.idc-header::before {
  content: '';
  z-index: 10;
  width: 100%;
  height: 100%;
  display: block;
  position: absolute;
background: rgb(0,0,0);
background: linear-gradient(180deg, rgba(0,0,0,0.891281512605042) 0%, rgba(0,0,0,0.4963235294117647) 62%);
	z-index:1;
} 
/* Flight Dynamics Facility Header - Add gradient overlay */
.fdf-header::before {
  content: '';
  z-index: 10;
  width: 100%;
  height: 100%;
  display: block;
  position: absolute;
background: rgb(0,0,0);
background: linear-gradient(180deg, rgba(0,0,0,0.891281512605042) 0%, rgba(0,0,0,0.4963235294117647) 62%);
	z-index:1;
} 
.cfs-header::before {
content: '';
    z-index: 10;
    width: 100%;
    height: 100%;
    display: block;
    position: absolute;
    background: rgb(0, 0, 0);
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.891281512605042) 0%, rgba(0, 0, 0, 0.2) 0%);
    z-index: 1;
}
/* Capabilities and Facilities Header - Add gradient overlay */
.capabilities-facilities-header::before {
  content: '';
  z-index: 10;
  width: 100%;
  height: 100%;
  display: block;
  position: absolute;
background: rgb(0,0,0);
background: linear-gradient(180deg, rgba(0,0,0,0.891281512605042) 0%, rgba(0,0,0,0.4963235294117647) 62%);
	z-index:1;
} 

/** 
 *  HOME PAGE CSS CLASSES
*/
/* Remove outline on images on click - Facilities Slider*/
.page .metaslider.ms-theme-clarity .flexslider .slides li:focus-within {
	outline: none;
}

/* Change color of slider arrows */
.page .facilities-slider.metaslider.ms-theme-clarity .flexslider .flex-direction-nav li a {
	    border: 2px solid #fff;
	    height: 45px;
    	width: 45px;
}
.page .facilities-slider.metaslider.ms-theme-clarity .flexslider .flex-direction-nav a:focus {
	    color: #ffffff00!important;
}
/* Adds gradient to slider images*/
.facilities-slider .slides li {
		background: linear-gradient(60deg, rgba(0,0,0,1) 30%, rgba(0,0,0,.6) 90%);!important;
		opacity: 1;
}
.facilities-slider .slides img {
		opacity: .5;
}
/* Moves slider caption to the left and on top of image*/
.facilities-slider.metaslider.ms-theme-clarity .flexslider .caption-wrap, .metaslider .caption-wrap  {
	background-color:transparent!important;
	border:none!important;
	position: absolute!important;
}
.facilities-slider.metaslider.ms-theme-clarity .flexslider .caption-wrap .caption  {
	padding-left: 20px!important;
}
/* Removes text-decoration on hover for caption link */
.facilities-slider.slides a:hover {
	text-decoration: none;
}

/* Read More link */
.post-archive-block .wp-block-post-excerpt__more-link, .featured-stories-paged-block .wp-block-post-excerpt__more-link {
	  position: relative;
    display: var(--button-display, inline-flex);
    gap: var(--spacing-xs);
    align-items: center;
    justify-content: center;
    width: var(--button-width, auto);
    max-height: var(--button-max-height, 100%);
    margin: var(--button-margin, 0);
    padding: var(--button-padding, .9rem 2rem);
    color: var(--button-color);
    font-weight: var(--button-font-weight, var(--body-font-weight));
    font-size: var(--button-font-size, var(--font-size-base));
    font-family: var(--button-font-family, var(--body-font-family));
    line-height: var(--button-line-height, 1.1);
    letter-spacing: var(--button-letter-spacing, normal);
    white-space: var(--button-white-space, normal);
    text-align: var(--button-text-align, center);
    text-transform: var(--button-text-transform, none);
    -webkit-text-decoration: var(--button-text-decoration, none);
    text-decoration: var(--button-text-decoration, none);
    word-break: var(--button-word-break, normal);
    overflow-wrap: var(--button-overflow-wrap, break-word);
    background: var(--button-background, var(--color-primary));
    border: var(--button-border, 0);
    border-radius: var(--button-border-radius, var(--border-radius));
    outline: var(--button-outline, none);
    box-shadow: var(--button-box-shadow, none);
    -webkit-transform: var(--button-transform, none);
    transform: var(--button-transform, none);
    -webkit-filter: var(--button-filter, none);
    filter: var(--button-filter, none);
    cursor: var(--button-cursor, pointer);
    opacity: var(--button-opacity, 1);
    transition: var(--button-transition, var(--transition));
	margin-top: 20px;
}
.post-archive-block .wp-block-post-excerpt__more-link:hover {
	background: var(--button-background-hover,var(--color-primary-dark,var(--button-background,var(--color-primary))))
}

.post-archive-block .wp-block-post-featured-image img {
    aspect-ratio: auto 400 / 300;
	  width: 500px; 
}

.post-archive-block .alignwide {
    --alignwide-max-side-spacing: 0px;
    --alignwide-side-spacing: 0px;
    max-width:unset;
	margin:unset;
}
@media only screen and (max-width: 500px) {
	.post-archive-block ul, .post-archive-block .search-results-term, .post-archive-block .search-results-count, .post-archive-block .search-breadcrumbs {
		padding-left: var(--side-spacing);
		padding-right:var(--side-spacing);
	}
	.post-archive-block .eplus-styles-uid-a37b88 {
		padding-right: 0px!important;
	}
	.post-archive-block .wp-block-group__inner-container  {
		margin: 0px;
	}
	/* Fix mobile padding for stories using block Image At left that shows posts paginated */

	.featured-stories-paged-header div  {
		padding-left:var(--side-spacing);
	}
}


.slider-header .wp-block-group__inner-container {
	margin-top: 0px!important;
}
@media only screen and (max-width: 800px) {
.slider-header iframe {
	transform: translateX(0px)!important;
}
}

