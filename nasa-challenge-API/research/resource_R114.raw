/* ETD Icon Bullet List */
/* Makes second lined item have enough padding */
.ub_styled_list_item {
  list-style-position: inside; /* Moves the bullet inside the padding */
  padding-left: 0px;
}
.ub_styled_list_item br {
  content: "";
  display: block;
  margin-bottom: 10px;
}
.ub_styled_list_item::before {
  position: absolute; 
  left: 0; 
  margin-left: -25px; /* Negative margin to align the bullet */
	margin-right: 5px!important;

}
/* Fix mobile padding 
@media only screen and (min-width:300px)
{
.icon-bullet-list-mobile li {
		padding-left: 25px;
}
}*/
/* No margin botom for icon bullet list reusable block*/
.no-margin-bottom-icon-list ul, .no-margin-bottom-icon-list li {
	margin-bottom: 0px;
}

/* Half Screen Video Header */
.half-video-header  {
    margin-bottom: 0px;
	margin-top: 0px;
	    height: 701px; 
}

.half-video-header video {
    width: 100%;
	object-fit: cover;
}

.half-video-header::before {
  content: '';
  z-index: 10;
  width: 100%;
  height: 100%;
  display: block;
  position: absolute; 
background: rgb(0,0,0);
background: linear-gradient(180deg, rgba(0,0,0,0.2) 0%, rgba(0,0,0,0.1) 62%);
	z-index:10;
} 
.video-half-header-text {
    position: absolute;
    top: 59%; 
    left: 50%; 
    transform: translate(-50%, -50%);
    color: white; 
    font-size: 2em; 
    text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.7); 
    text-align: center; 
}
/* Full Screen Video Header */
.full-video-header  {
    margin-bottom: 0px;
	margin-top: 0px;
	    height: 887px; 
}

.full-video-header video {
    width: 100%;
	height:100%;
	object-fit: cover;
}
/* Video Header Gradient */
.full-video-header::before {
  content: '';
  z-index: 10;
  width: 100%;
  height: 100%;
  display: block;
  position: absolute; 
background: rgb(0,0,0);
background: linear-gradient(180deg, rgba(0,0,0,0.2) 0%, rgba(0,0,0,0.1) 62%);
	z-index:10;
} 

.video-header-text {
    position: absolute;
    top: 57.2%; 
    left: 50%; 
    transform: translate(-50%, -50%);
    color: white; 
    font-size: 2em; 
    text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.7); 
    text-align: center; 
}

