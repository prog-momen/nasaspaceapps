/* Larger font for pagniation items in list view  
 .tribe-events-c-nav__prev-label, .tribe-events-c-nav__next-label, .tribe-events-c-nav__list-item .tribe-events-c-nav__today {
	
	font-size: var(--tec-font-size-3);
}
/* Event name link 
.tribe-events-calendar-list__event-title a {
	color: #2a5387!important;
	border-bottom: none!important;
}
/* Event name link on hover 
.tribe-events-calendar-list__event-title a:hover {
	color: #2a5387;
	border-bottom: none!important;
	text-decoration: var(--link-text-decoration-hover,underline);
}
/**
 * DEPRECATED: SOCIAL MEDIA CSS CLASSES
 
.social-media-glow {
  border: 1px solid #eee;
  margin-bottom: 30px;
  padding-top: 40px;
  padding-bottom: 25px;
	padding-right: 20px;
	padding-left: 20px;
	height: 47.9%;
  transition: all 0.3s ease 0s;
}
.social-media-glow:hover {
  box-shadow: 0 5px 65px 0 rgba(255, 255, 255, 0.5);
  -webkit-box-shadow: 0 5px 65px 0 rgba(255, 255, 255, 0.5);
}
*/
</style>
