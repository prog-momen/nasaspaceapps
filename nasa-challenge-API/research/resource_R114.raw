jQuery(document).ready(function($) {
      $('.internal-popup a').on('click', function(event) {
        event.preventDefault();
        var message = 'If you are not an authorized NASA employee, you will be unable to access this content.';
        if (confirm(message)) {
          window.location = $(this).attr('href');
        }
      });
    });
    
//# sourceURL=jquery-js-after
</script>
