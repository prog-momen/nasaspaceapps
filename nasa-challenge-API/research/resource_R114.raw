.tribe-events .tribe-events-c-subscribe-dropdown .tribe-events-c-subscribe-dropdown__button:focus-within, .tribe-events .tribe-events-c-subscribe-dropdown .tribe-events-c-subscribe-dropdown__button:hover, .tribe-events-c-search__button:hover:after {
	    background: var(--button-background-hover,var(--color-primary-dark,var(--button-background,var(--color-primary))))!important;
	border:none!important;
	outline: none!important;
}

.tribe-events-c-search__button	 {
  visibility: hidden;
}
.tribe-events-c-search__button:after {
  content:'Search'; 
  visibility: visible;
	border:none;
position: relative;
    display: var(--button-display,inline-flex);
    align-items: center;
    justify-content: center;
    width: var(--button-width,auto);
    max-height: var(--button-max-height,100%);
	padding: var(--button-padding,.9rem 2rem);
    color: white!important;
    font-weight: var(--button-font-weight,var(--body-font-weight))!important;
    font-size: var(--button-font-size,var(--font-size-base))!important;
    font-family: var(--button-font-family,var(--body-font-family))!important;
    line-height: var(--button-line-height,1.1);
    letter-spacing: var(--button-letter-spacing,normal);
    white-space: var(--button-white-space,normal);
    text-align: var(--button-text-align,center);
    text-transform: var(--button-text-transform,none);
	background: var(--button-background,var(--color-primary));
border-radius: var(--button-border-radius,var(--border-radius));
}


/* Subscribe buttons 
.tribe-events .tribe-events-c-subscribe-dropdown .tribe-events-c-subscribe-dropdown__button, .tribe-events .tribe-events-c-subscribe-dropdown .tribe-events-c-subscribe-dropdown__button:visited, .tribe-events .tribe-events-c-subscribe-dropdown .tribe-events-c-subscribe-dropdown__button:active  {
