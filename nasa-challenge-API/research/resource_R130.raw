			<!-- Datasets -->
			<section id="section_datasets" class="row">
				<h2 class="fs-3">Datasets used</h2>
				<ul class="list-unstyled  mx-0">
					
						
							

	<li class="dataset card p-3 mb-2">
		<div class="card-title hstack flex-wrap">
			<h2 class="fs-5 fw-normal search-text me-auto search-text mb-0">
				Relative Height [GEDI]
			</h2>
			<span class="btn btn-sm btn-secondary disabled">ID: 1131</span>
		</div>

		<div class="card-subtitle hstack flex-wrap hide-last-vr gap-2 search-text">
			
			
			
			
		</div>

		<div class="card-body vstack p-2 gap-2">
			
				<p class="mb-0 search-text">
					RH100 or relative height is the 100th percentile of waveform energy relative to ground elevation. Derived from the L2B LIDAR metric RH100 data product.
				</p>
			
			
			
				<p class="mb-0">
					This dataset can be found at: <a href="https://gedi.umd.edu/" class="link">https://gedi.umd.edu/</a>
				</p>
			
			
			<a href="/search/?datasets=1131" class="link">See all pages that use this dataset<span class="bi bi-chevron-right mx-2" aria-hidden="true"></span></a>
		</div>
	</li>


						
					
				</ul>
