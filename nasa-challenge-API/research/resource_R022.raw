            Back to Perspectives home
          </h6>
        </a>
      </div>
      <div class="flexStack">
        
          
<div class="flex1 flexContainer flexCenterAlignItems flexGapExtraSmall keepFlexOnMobile">
  <a href="/blog/author/bell-statistics">
    <div 
      class="circleImage"
      style="background-image: url('https://cdn.sanity.io/images/l5rq9j6r/statsig-www-v4/1f33e3fdf011e9993a04e2a83bacceb83d70b248-200x200.jpg')" 
