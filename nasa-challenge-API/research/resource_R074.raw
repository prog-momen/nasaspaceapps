		<div class="elementor-element elementor-element-4a50545 e-con-full elementor-repeater-item-ang_container_no_padding e-flex elementor-repeater-item-none elementor-repeater-item-none_hover e-con e-child" data-id="4a50545" data-element_type="container" data-e-type="container" data-settings="{&quot;ang_container_spacing_size&quot;:&quot;ang_container_no_padding&quot;,&quot;jet_parallax_layout_list&quot;:[]}">
