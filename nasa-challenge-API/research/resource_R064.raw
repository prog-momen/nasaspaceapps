<script type="text/javascript">
  $(document).ready(function(){

    //Navbar
    $("#carousel-main").addClass("active");
    $("#link-home").addClass("active");

    //Our graphics Archive
    let base = "https://data.prism.oregonstate.edu/map_graphics/us/an/png/800m/";
    let drought_base = "https://prism.oregonstate.edu/comparisons/images/prism_drought/";

    // Grab the latest date for which we have the graphics
    var latest_pga_date = "2026-11-13";
    var year,month,day;
  
    [year,month,day] = latest_pga_date.split('-');

    $("#mtd_ppt").attr('src',base+"ppt/mtd/2026/prism_ppt_us_30s_20261113_mtd_076dpi.png?r=1189b");
    $("#mtd_tmin").attr('src',base+"tmin/mtd/2026/prism_tmin_us_30s_20261113_mtd_076dpi.png?r=1189b");
    $("#mtd_tmean").attr('src',base+"tmean/mtd_anom/2026/prism_tmean_us_30s_20261113_mtd_anom_076dpi.png?r=1189b");
    $("#mtd_tmax").attr('src',base+"tmax/mtd/2026/prism_tmax_us_30s_20261113_mtd_076dpi.png?r=1189b");
    $('#mtd_drought').attr('src',drought_base+"2026/prism_ppt_us_30s_202611_anom-2020-30y_05m_mtd.png?r=1189b");
    $("#mtd_solslope").attr('src',base+"solslope/mtd/2026/prism_solslope_us_30s_20261113_mtd_076dpi.png?r=1189b");

  });
</script>

