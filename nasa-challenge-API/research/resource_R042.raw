    <style>
      .overlay-wrapper {
        display: inline-flex;
      }

      @media screen and (max-width: 800px) {
        .tophat-offset {
          top: 40px;
        }
      }

      @media screen and (min-width: 801px) {
        .tophat-offset {
          top: 32px;
        }
      }

      #sensor-and-signal {
        animation: spin-right 10s linear infinite;
        transform-origin: 50% 50%;
      }

      #signal-1 {
        animation: show-signal-1 5s infinite step-end;
      }

      #signal-2 {
        animation: show-signal-2 5s infinite step-end;
        opacity: 0;
      }

      #signal-3 {
        animation: show-signal-3 5s infinite step-end;
        opacity: 0;
      }

      #signal-4 {
