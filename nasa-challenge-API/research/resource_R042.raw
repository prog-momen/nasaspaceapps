  <body class="theme-light">
    <!-- NASA Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-WNP7MLF" height="0" width="0" style="display: none; visibility: hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->

    <script>
      const url = window.location.hostname.toLowerCase();
      if (
        url === 'vertex-beta.asf.alaska.edu' ||
        url === 'vertex.daac.asf.alaska.edu' ||
        url === 'vertex-retired.daac.asf.alaska.edu'
      ) {
        const redirect = `https://search.asf.alaska.edu${window.location.pathname}${window.location.hash}`;
        window.location = redirect;
      }

      <!-- NASA Google Tag Manager -->
      if (!window.location.hostname.toLowerCase().startsWith('vertex-plus')) {
        (function (w, d, s, l, i) {
          w[l] = w[l] || [];
          w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
