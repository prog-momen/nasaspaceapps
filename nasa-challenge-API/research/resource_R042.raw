    <script>
      if (!window.location.hostname.toLowerCase().startsWith('vertex-plus')) {
        const tophat = document.createElement('script');
        tophat.src = 'https://cdn.earthdata.nasa.gov/tophat2/tophat2.js';
        tophat.id = 'earthdata-tophat-script';
        tophat.async = true;
        tophat.defer = true;
        tophat.dataset.showFbm = 'true';
        tophat.dataset.showStatus = 'false';
        tophat.dataset.currentDaac = 'ASF DAAC';
        document.currentScript.after(tophat);

        const feedbackScript = document.createElement('script');
        feedbackScript.async = true;
        feedbackScript.src =
          'https://fbm.earthdata.nasa.gov/for/ASF/feedback.js';
        tophat.after(feedbackScript);

        feedbackScript.onload = () => {
          feedback.init({
            showIcon: false,
            title: 'How can we help you?',
            subject: '',
            details: '',
          });
        };
      }
    </script>
