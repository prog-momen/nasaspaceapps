!important%3B%5Cn%20%20%20%20background-color%3A%20%23116aab%20!important%3B%5Cn%20%20%20%20transition%3A%200.1s%20!important%3B%5Cn%7D%5Cn%5Cn.hub-side-panel%3E.side-panel-tab-controls%20a%2C%20.hub-side-panel%3E.side-panel-tab-controls%20button%20%7B%5Cn%20%20height%3A%2036px%20!important%3B%5Cn%20%20width%3A%2036px%20!important%3B%5Cn%20%20padding%3A%208px%20!important%3B%5Cn%7D%5Cn%5Cnbutton.google-translate-button%3Atarget%20%7B%5Cn%20%20right%3A%20120px%20!important%3B%5Cn%7D%20*%2F%5Cn%3C%2Fstyle%3E%5Cn%3Cdiv%20style%3D%5C%22text-align%3A%20left%3B%5C%22%20class%3D%5C%22banner-heading%5C%22%3EGlobal%20Agro-Ecological%20Zones%3C%2Fdiv%3E%22%7D%7D%2C%22width%22%3A12%7D%5D%7D%5D%2C%22visibility%22%3A%7B%22access%22%3A%22default%22%2C%22groups%22%3A%5B%5D%7D%7D%2C%7B%22containment%22%3A%22fixed%22%2C%22isFooter%22%3Afalse%2C%22style%22%3A%7B%22background%22%3A%7B%22isFile%22%3Afalse%2C%22isUrl%22%3Atrue%2C%22state%22%3A%22%22%2C%22display%22%3A%7B%7D%2C%22transparency%22%3A0%2C%22position%22%3A%7B%22x%22%3A%22center%22%2C%22y%22%3A%22center%22%7D%2C%22color%22%3A%22%23ffffff%22%2C%22image%22%3A%22%22%7D%2C%22color%22%3A%22%23444444%22%7D%2C%22rows%22%3A%5B%7B%22cards%22%3A%5B%7B%22component%22%3A%7B%22name%22%3A%22markdown-card%22%2C%22settings%22%3A%7B%22cardId%22%3A%22cm87bmlro%22%2C%22schemaVersion%22%3A2.1%2C%22markdown%22%3A%22%3Ch2%3EGAEZ%20Version%205%20is%20now%20available!%3C%2Fh2%3E%3Cp%3EPlease%20visit%20the%20updated%20GAEZ%20v5%20website%20to%20access%20the%20new%20datasets%20and%20relevant%20information.%3C%2Fp%3E%3Ca%20href%3D%5C%22https%3A%2F%2Fdata.apps.fao.org%2Fgaez%2F%5C%22%20class%3D%5C%22btn%20btn-primary%5C%22%20style%3D%5C%22margin%3A%2014px%200%5C%22%3EGlobal%20Agro-Ecological%20Zoning%20Program%20(v5)%3C%2Fa%3E%22%7D%7D%2C%22width%22%3A12%7D%5D%7D%2C%7B%22cards%22%3A%5B%7B%22component%22%3A%7B%22name%22%3A%22markdown-card%22%2C%22settings%22%3A%7B%22schemaVersion%22%3A2.1%2C%22markdown%22%3A%22%3Cp%20style%3D%5C%22margin-top%3A%2018px%3B%20margin-bottom%3A%2018px%3B%5C%22%3E%3Cb%3EThe%20Food%20and%20Agriculture%20Organization%20of%20the%20United%20Nations%20(FAO)%20%3C%2Fb%3Eand%20the%3Cb%3E%20International%20Institute%20for%20Applied%20Systems%20Analysis%20(IIASA)%20%3C%2Fb%3Ehave%20cooperated%20over%20several%20decades%20to%20develop%20and%20implement%20the%20%3Cb%3EAgro-Ecological%20Zones%20(AEZ)%20modelling%20framework%3C%2Fb%3E%20and%20databases.%20AEZ%20relies%20on%20well-established%20land%20evaluation%20principles%20to%20assess%20natural%20resources%20for%20finding%20suitable%20agricultural%20land%20utilization%20options.%20It%20identifies%20resource%20limitations%20and%20opportunities%20based%20on%20plant%20eco-physiological%20characteristics%2C%20climatic%20and%20edaphic%20requirements%20of%20crops%20and%20it%20uses%20these%20to%20evaluate%20suitability%20and%20production%20potentials%20for%20individual%20crop%20types%20under%20specific%20input%20and%20management%20conditions.%20Managing%20the%20constraints%20imposed%20by%20agro-ecological%20conditions%20and%20knowing%20what%20the%20most%20viable%20crop%20options%20are%2C%20facilitates%20planning%20decisions.%20In%20this%20way%20choices%20can%20be%20made%2C%20which%20are%20not%20only%20more%20productive%2C%20but%20also%20sustainable%20and%20resilient%20to%20climatic%20variability.%20The%20AEZ%20framework%20contributes%20to%20several%20of%20the%20United%20Nations%20Sustainable%20Development%20Goals%20(SDGs)%20by%20providing%20information%20about%20current%20and%20future%20agricultural%20production%20risks%20and%20opportunities%2C%20irrigation%20water%20demand%2C%20and%20crop%20development%20and%20adaptation%20options.%3C%2Fp%3E%3Cp%20style%3D%5C%22margin-top%3A%2018px%3B%20margin-bottom%3A%2018px%3B%5C%22%3E%3Cbr%3E%3C%2Fp%3E%3Cp%20style%3D%5C%22margin-top%3A%2018px%3B%20margin-bottom%3A%2018px%3B%5C%22%3EThe%20AEZ%20methodology%20was%20initially%20implemented%20in%20the%201980s%20to%20assess%20the%20capacity%20of%20the%20world's%20natural%20resources%20to%20meet%20the%20needs%20for%20food%20of%20a%20fast-growing%20global%20population%2C%20particularly%20in%20developing%20countries.%20Rapid%20developments%20in%20computing%20and%20geo-information%20technology%20have%20produced%20increasingly%20detailed%20global%20databases%20and%20IT%20resources%2C%20which%20made%20possible%20the%20first%20global%20AEZ%20assessment%20in%202000%20(GAEZ%20v1).%20Since%20then%2C%20global%20AEZ%20resource%20evaluations%20have%20been%20released%20in%202002%20(GAEZ%20v2)%20and%202012%20(GAEZ%20v3).%20With%20each%20update%20of%20the%20system%2C%20the%20methodological%20refinement%20and%20database%20content%20evolved%20to%20provide%20guidance%20for%20agro-ecological%20development%20at%20global%2C%20regional%20and%20national%20scales%20and%20support%20for%20assessments%20and%20indicators%20needed%20to%20achieve%20SDGs.%3C%2Fp%3E%3Cp%20style%3D%5C%22margin-top%3A%2018px%3B%20margin-bottom%3A%2018px%3B%5C%22%3E%3Cbr%3E%3C%2Fp%3E%3Cp%20style%3D%5C%22margin-top%3A%2018px%3B%20margin-bottom%3A%2018px%3B%5C%22%3EGAEZ%20methodology%20development%2C%20data%20base%20compilation%2C%20production%20of%20results%20and%20establishing%20the%20Data%20Portal%20were%20accomplished%20in%20close%20technical%20collaboration%20and%20with%20inputs%20of%20the%20International%20Institute%20for%20Applied%20Systems%20Analysis%20(IIASA).%3C%2Fp%3E%3Cdiv%3E%3Cbr%3E%3C%2Fdiv%3E%3Cdiv%3E%3Cbr%3E%3C%2Fdiv%3E%22%7D%7D%2C%22width%22%3A12%2C%22showEditor%22%3Afalse%7D%5D%7D%5D%2C%22visibility%22%3A%7B%22access%22%3A%22default%22%2C%22groups%22%3A%5B%5D%7D%7D%2C%7B%22containment%22%3A%22fixed%22%2C%22isFooter%22%3Afalse%2C%22style%22%3A%7B%22background%22%3A%7B%22isFile%22%3Afalse%2C%22isUrl%22%3Atrue%2C%22state%22%3A%22%22%2C%22display%22%3A%7B%7D%2C%22transparency%22%3A0%2C%22position%22%3A%7B%22x%22%3A%22center%22%2C%22y%22%3A%22center%22%7D%2C%22color%22%3A%22transparent%22%7D%2C%22rowLayout%22%3A%22box%22%7D%2C%22rows%22%3A%5B%7B%22cards%22%3A%5B%7B%22component%22%3A%7B%22name%22%3A%22markdown-card%22%2C%22settings%22%3A%7B%22schemaVersion%22%3A2.1%2C%22markdown%22%3A%22%3Cp%3E%3Ca%20href%3D%5C%22https%3A%2F%2Fiiasa.ac.at%2F%5C%22%20target%3D%5C%22_blank%5C%22%3E%3Cimg%20src%3D%5C%22https%3A%2F%2Fwww.unwater.org%2Fsites%2Fdefault%2Ffiles%2Fapp%2Fuploads%2F2020%2F01%2F220x120_PARTNERS_IIASA.png%5C%22%20width%3D%5C%22300%5C%22%20alt%3D%5C%22IIASA%20Logo%5C%22%3E%3C%2Fa%3E%3Cbr%3E%3C%2Fp%3E%22%7D%7D%2C%22width%22%3A12%7D%5D%7D%5D%2C%22visibility%22%3A%7B%22access%22%3A%22default%22%2C%22groups%22%3A%5B%5D%7D%7D%2C%7B%22containment%22%3A%22fixed%22%2C%22isFooter%22%3Afalse%2C%22style%22%3A%7B%22background%22%3A%7B%22isFile%22%3Afalse%2C%22isUrl%22%3Atrue%2C%22state%22%3A%22%22%2C%22display%22%3A%7B%7D%2C%22transparency%22%3A0%2C%22position%22%3A%7B%22x%22%3A%22center%22%2C%22y%22%3A%22center%22%7D%2C%22color%22%3A%22transparent%22%7D%2C%22rowLayout%22%3A%22box%22%7D%2C%22rows%22%3A%5B%7B%22cards%22%3A%5B%7B%22component%22%3A%7B%22name%22%3A%22markdown-card%22%2C%22settings%22%3A%7B%22schemaVersion%22%3A2.1%2C%22markdown%22%3A%22%3Ch4%20style%3D%5C%22text-align%3A%20center%3B%5C%22%3E%3Cspan%20style%3D%5C%22background-color%3A%20initial%3B%20color%3A%20currentcolor%3B%5C%22%3EGAEZ%20v4%20Data%3C%2Fspan%3E%3C%2Fh4%3E%3Ch4%20style%3D%5C%22text-align%3A%20center%3B%5C%22%3E%3Cspan%20style%3D%5C%22background-color%3A%20initial%3B%20color%3A%20currentcolor%3B%5C%22%3E%3Cbr%3E%3C%2Fspan%3E%3C%2Fh4%3E%3Cp%20style%3D%5C%22text-align%3A%20left%3B%5C%22%3EGAEZ%20v4%20is%20the%20most%20ambitious%20global%20assessment%20to%20date%20and%20this%20Data%20Portal%20has%20been%20developed%20to%20make%20the%20database%20widely%20and%20easily%20accessible%20for%20users.%20It%20comprises%20a%20large%20volume%20of%20spatial%20natural%20resources%20indicators%20and%20results%20of%20agro-ecological%20crop%20analysis.%26nbsp%3B%3C%2Fp%3E%3Cp%20style%3D%5C%22text-align%3A%20left%3B%5C%22%3E%3Cspan%20style%3D%5C%22background-color%3A%20initial%3B%20color%3A%20currentcolor%3B%20font-family%3A%20var(--fontsBaseFamily)%2CAvenir%20Next%3B%5C%22%3EResults%20are%20presented%20in%20a%20regular%20raster%20format%20of%205%20arc-minute%20(about%209%20x%209%20km%20at%20the%20equator)%20grid%20cells.%20Selected%20maps%20related%20to%20AEZ%20classification%2C%20soil%20suitability%2C%20terrain%20slopes%20and%20land%20cover%20are%20provided%20at%2030%20arc-second%20(0.9%20x%200.9%20km)%20resolution.%20The%20GAEZ%20v4%20update%20includes%202010%20baseline%20data%20comprising%20land%20cover%2C%20a%20harmonized%20global%20soil%20database%20and%20terrain%20data%2C%20protected%20areas%20and%20areas%20of%20high%20biodiversity%20value.%20Climatic%20conditions%20are%20based%20on%20a%20time%20series%20of%20historical%20data%20of%201961-2010%20and%20a%20selection%20of%20future%20climate%20simulations%20using%20recent%20IPCC%20AR5%20Earth%20System%20Model%20(ESM)%20outputs%20for%20four%20Representative%20Concentration%20Pathways%20(RCPs).%3C%2Fspan%3E%3C%2Fp%3E%3Cp%20style%3D%5C%22text-align%3A%20center%3B%5C%22%3E%3Cdiv%20style%3D%5C%22text-align%3A%20left%3B%5C%22%3E%3Cspan%20style%3D%5C%22background-color%3A%20initial%3B%20color%3A%20currentcolor%3B%20font-family%3A%20var(--fontsBaseFamily)%2CAvenir%20Next%3B%5C%22%3EThe%20GAEZ%20v4%20spatial%20data%20are%20organized%20in%20six%20themes%3A%20(1)%20Land%20and%20Water%20Resources%2C%20(2)%20Agro-climatic%20Resources%2C%20(3)%20Agro-climatic%20Potential%20Yield%2C%20(4)%20Suitability%20and%20Attainable%20Yield%2C%20(5)%20Actual%20Yields%20and%20Production%2C%20and%20(6)%20Yield%20and%20Production%20Gaps.%3C%2Fspan%3E%3C%2Fdiv%3E%3C%2Fp%3E%3Cdiv%20style%3D%5C%22text-align%3A%20center%3B%5C%22%3E%3Cbr%3E%3C%2Fdiv%3E%22%7D%7D%2C%22width%22%3A12%7D%5D%7D%2C%7B%22cards%22%3A%5B%7B%22component%22%3A%7B%22name%22%3A%22markdown-card%22%2C%22settings%22%3A%7B%22schemaVersion%22%3A2.1%2C%22markdown%22%3A%22%3Cdiv%20class%3D%5C%22col-xs-12%20col-sm-6%20col-md-4%5C%22%3E%5Cr%5Cn%3Cdiv%20class%3D%5C%22calcite-web%5C%22%3E%5Cr%5Cn%20%20%3Cdiv%20class%3D%5C%22card-base%5C%22%3E%5Cr%5Cn%20%20%20%20%3Cdiv%20class%3D%5C%22card-image-wrap%5C%22%3E%5Cr%5Cn%20%20%20%20%20%20%3Cimg%20alt%3D%5C%22Theme%201%3A%20Land%20and%20Water%20Resources%5C%22%20class%3D%5C%22card-image%5C%22%20src%3D%5C%22https%3A%2F%2Funsplash.com%2Fphotos%2FuVk9yEp6QlM%2Fdownload%3Fforce%3Dtrue%5C%22%20style%3D%5C%22height%3A%20200px%5C%22%3E%5Cr%5Cn%20%20%20%20%20%20%3Cdiv%20class%3D%5C%22card-image-caption%5C%22%3E%5Cr%5Cn%20%20%20%20%20%20%20%20Theme%201%5Cr%5Cn%20%20%20%20%20%20%3C%2Fdiv%3E%5Cr%5Cn%20%20%20%20%3C%2Fdiv%3E%5Cr%5Cn%20%20%20%20%3Cdiv%20class%3D%5C%22card-content%5C%22%20style%3D%5C%22height%3A%20200px%5C%22%3E%5Cr%5Cn%20%20%20%20%20%20%3Ch4%3E%3Ca%20href%3D%5C%22%2Fpages%2Ftheme-details-theme-1%5C%22%3ELand%20and%20Water%20Resources%3C%2Fa%3E%3C%2Fh4%3E%5Cr%5Cn%20%20%20%20%20%20%3Cp%3ESoil%2C%20water%2C%20terrain%20resources%2C%20land%20cover%2C%20protected%20areas%20and%20a%20number%20of%20selected%20socio-economic%20and%20demographic%20data%3Cbr%3E%20%20%3C%2Fp%3E%5Cr%5Cn%20%20%20%20%3C%2Fdiv%3E%5Cr%5Cn%20%20%3C%2Fdiv%3E%5Cr%5Cn%3C%2Fdiv%3E%5Cr%5Cn%3C%2Fdiv%3E%5Cr%5Cn%3Cdiv%20class%3D%5C%22col-xs-12%20col-sm-6%20col-md-4%5C%22%3E%5Cr%5Cn%3Cdiv%20class%3D%5C%22calcite-web%5C%22%3E%5Cr%5Cn%20%20%3Cdiv%20class%3D%5C%22card-base%5C%22%3E%5Cr%5Cn%20%20%20%20%3Cdiv%20class%3D%5C%22card-image-wrap%5C%22%3E%5Cr%5Cn%20%20%20%20%20%20%3Cimg%20alt%3D%5C%22Bridge%20Club%2C%201954%5C%22%20class%3D%5C%22card-image%5C%22%20src%3D%5C%22https%3A%2F%2Fimages.unsplash.com%2Fphoto-1534201640835-c6d455b79901%3Fixlib%3Drb-1.2.1%26amp%3Bq%3D80%26amp%3Bfm%3Djpg%26amp%3Bcrop%3Dentropy%26amp%3Bcs%3Dtinysrgb%26amp%3Bw%3D1080%26amp%3Bfit%3Dmax%26amp%3Bixid%3DeyJhcHBfaWQiOjEyMDd9%5C%22%20style%3D%5C%22height%3A%20200px%5C%22%3E%5Cr%5Cn%20%20%20%20%20%20%3Cdiv%20class%3D%5C%22card-image-caption%5C%22%3E%5Cr%5Cn%20%20%20%20%20%20%20%20Theme%202%5Cr%5Cn%20%20%20%20%20%20%3C%2Fdiv%3E%5Cr%5Cn%20%20%20%20%3C%2