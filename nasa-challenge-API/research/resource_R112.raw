         <div class="col-title">
            <div class="title">
               General Mission Analysis Tool (GMAT) Version R2025a 
            </div>
            <div class="reference_number">(GSC-19468-1)</div>
         </div>
         <div class="col-subtitle">
            <span class="subtitle"></span>
