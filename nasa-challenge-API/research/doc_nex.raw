<div class="wp-block-group alignfull has-background-color has-white-color has-custom-dark-blue-1-background-color has-text-color has-background has-link-color wp-elements-1 is-layout-flow wp-container-core-group-is-layout-6d79123d wp-block-group-is-layout-flow" style="border-top-style:none;border-top-width:0rem;border-bottom-color:var(--wp--preset--color--white);border-bottom-width:0.25rem;margin-top:0;margin-bottom:0;padding-top:1rem;padding-right:0;padding-bottom:1rem;padding-left:0">
<div class="wp-block-group is-nowrap is-layout-flex wp-container-core-group-is-layout-3a88641f wp-block-group-is-layout-flex"></div>


<!-- Banner Wrapper (Height reduced by lowering top/bottom padding to 12px) -->
<div id="alert-banner" role="alert" style="background-color: #ffffff; color: #1a1a1a; border-bottom: 1px solid #e0e0e0; padding: 10px 40px; width: 100%; box-sizing: border-box; margin: 0;">
 
  <!-- Layout Flexbox -->
  <div style="display: flex; gap: 20px; align-items: center; position: relative; max-width: 1200px; margin: 0 auto;">
 
    <!-- Left side: SVG Icon (Reduced to 32px to fit the slimmer height) -->
    <div style="flex-shrink: 0; display: flex; align-items: center;">
      <svg xmlns="http://w3.org" viewBox="0 0 24 24" width="32" height="32" fill="#0066cc">
        <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z"></path>
      </svg>
    </div>
 
    <!-- Middle: Content text (Inherits browser/site default font family) -->
    <div style="flex: 1; padding-right: 40px;">
      <p style="margin: 0; line-height: 1.4; font-size: 14px; ">
To support NASA’s Earth Modeling Nexus, NCCS is becoming Earth Modeling Nexus Core Computing (Nexus Compute). We are in the process of migrating the NCCS site to the Nexus Compute webpage from now until end of 2026. Thank you for your patience as we make this transition.
        <a href="https://www.nccs.nasa.gov/nexus-compute-transition/" target="_blank" rel="noopener noreferrer" style="color: #0066cc; text-decoration: underline; font-weight: bold;">Read more</a>
      </p>
    </div>
 
    <!-- Right side: Absolute Dismiss Close Button -->
    <button onclick="dismissBanner()" aria-label="Dismiss alert" style="position: absolute; right: 0; background: none; border: none; color: #1a1a1a; font-size: 24px; font-weight: bold; cursor: pointer; line-height: 1; padding: 0; user-select: none;">
      ×
    </button>
 
  </div>
</div>
 
<script>
  function dismissBanner() {
    const banner = document.getElementById('alert-banner');
    banner.style.display = 'none';
  }
</script>


