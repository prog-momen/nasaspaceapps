    width: 100px !important;
    height: auto; 
}

.image-with-border {
  border: 5px solid #FFFFFF; 
  border-radius: 15px;
}

/* ensure images in media and text block have radius */
.wp-block-media-text .wp-block-media-text__media img {
border-radius: 15px;
}

.info-paragraph::before {
    content: "INFO: ";
    font-weight: bold;
    color: #078214;
}
.info-paragraph {
    color: black;
    border: 1px solid #CCC;
    line-height: 1.6rem;
    background: #FFFFFF;
    padding: 15px !important;
    border-radius: 2px;
    margin-bottom: 5px !important;
}

.warning-paragraph::before {
    content: "WARNING: ";
    font-weight: bold;
    color: #FF8C00;
}

.warning-paragraph {
    color: black;
    border: 1px solid #CCC;
    background: #FFFFFF;
    padding: 15px !important;
    border-radius: 2px;
    margin-bottom: 5px !important;;
}

.alert-paragraph::before {
    content: "ALERT: ";
    font-weight: bold;
    color: #CC0000;
}
.alert-paragraph {
    color: black;
    border: 1px solid #CCC;
    background: white;
    padding: 15px !important;
    border-radius: 2px;
    margin-bottom: 5px !important;
}

th {
  color: white;
  background: #2E3D4A;
}

h1::before {
  content: "// "; 
  color: #72BE44;
  font-weight: bold;
}

.svg-fill1 { fill: #1A3748 }

.hecmap-1,.hecmap-2 { 
  isolation: isolate;
  font-size: 24px;
  font-family: ArialMT, Arial;
  letter-spacing:-0.01em;
}
.hecmap-1,.hecmap-11 {
  fill: #73be45;
  font-size: 24px; 
}
.hecmap-2,.hecmap-9 { fill: #31aae1; }
.hecmap-10,.hecmap-3,.hecmap-4 { fill:none; }
.hecmap-3 { stroke:#31aae1; }
.hecmap-10,.hecmap-3,.hecmap-7,.hecmap-8 {  stroke-miterlimit: 10; 
}
.hecmap-10,.hecmap-3 { 
  stroke-width: 0.75px; 
}
.hecmap-5,.hecmap-7 { fill:#bbbdc4; }
.hecmap-6,.hecmap-8 {fill:#fff; }
.hecmap-7,.hecmap-8 { stroke:#fff; }
.hecmap-10 { stroke:#73be45; }


