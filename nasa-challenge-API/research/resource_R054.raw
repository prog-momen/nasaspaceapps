                  <source srcset="/sites/default/files/styles/article_top_image_large/public/2020-02/IMERG_example_1_24_20.jpg?itok=9icKF4oH 1x" media="all and (min-width: 727px)" type="image/jpeg" width="1298" height="650"/>
