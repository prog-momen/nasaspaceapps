# Copy to .env (in this folder) and fill in. NEVER commit .env and NEVER paste keys into the chat.
# --- Gemini (development model; model choice stays configurable) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.8-flash
GEMINI_DAILY_CAP_PER_MODEL=18
GEMINI_REQUEST_TIMEOUT_S=30
GEMINI_TOTAL_DEADLINE_S=75
GEMINI_MAX_ATTEMPTS=3
# --- Provider credentials (each only enables its own feature) ---
# NASA FIRMS active-fire detections: free MAP_KEY, register at https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=
# NASA Earthdata downloads: User Token from https://urs.earthdata.nasa.gov/profile (after approving the data provider app)
EARTHDATA_TOKEN=
# NASA AppEEARS point sampling (MODIS LST): Earthdata Login username/password
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
# Copernicus Data Space OAuth client (NDVI processing only; scene discovery needs nothing): https://dataspace.copernicus.eu/
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
# Google Earth Engine (optional): registered Cloud project id; also `pip install -r requirements-optional.txt` and `earthengine authenticate`
EE_PROJECT=
# --- Embeddings / runtime ---
EMBEDDING_MODEL=intfloat/multilingual-e5-small
LOG_LEVEL=INFO
# Optional: require X-Admin-Token on POST /api/rag/ingest
# RAG_ADMIN_TOKEN=

# Copernicus EWDS (CEMS fire danger seasonal forecasts) - a SEPARATE account from Earthdata and Copernicus Data Space.
# Create an account at https://ewds.climate.copernicus.eu/, accept the dataset licence, then copy the personal access token from https://ewds.climate.copernicus.eu/how-to-api
# EWDS_API_KEY=
EWDS_API_KEY=8ab006a4-9c9e-4ff9-8b82-2477c0680bb1
